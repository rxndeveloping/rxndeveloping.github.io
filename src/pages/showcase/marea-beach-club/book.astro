---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro'; import T from '../../../components/showcase/ShowcaseText.astro'; import AdvancedBooking from '../../../components/showcase/AdvancedBooking.astro'; import { mareaNav,mareaCta } from '../../../data/showcaseNavigation';
const experiences=[{id:'beach',title:{en:'Beach day',it:'Giornata in spiaggia',fr:'Journée plage',es:'Día de playa'},detail:{en:'Cabana, towel service, and restaurant priority.',it:'Cabana, teli e priorità al ristorante.',fr:'Cabane, serviettes et priorité au restaurant.',es:'Cabaña, toallas y prioridad en el restaurante.'}},{id:'dining',title:{en:'Sunset dining',it:'Cena al tramonto',fr:'Dîner au coucher du soleil',es:'Cena al atardecer'},detail:{en:'A sea-view table with aperitivo and dinner.',it:'Tavolo vista mare con aperitivo e cena.',fr:'Table vue mer avec aperitivo et dîner.',es:'Mesa con vistas, aperitivo y cena.'}},{id:'complete',title:{en:'Marea complete',it:'Marea completa',fr:'Marea complète',es:'Marea completa'},detail:{en:'Beach, lunch, boat, aperitivo, and dinner.',it:'Spiaggia, pranzo, barca, aperitivo e cena.',fr:'Plage, déjeuner, bateau, aperitivo et dîner.',es:'Playa, almuerzo, barco, aperitivo y cena.'}}];
---
