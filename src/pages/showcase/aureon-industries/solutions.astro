---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { aureonNav, aureonCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Solutions — Aureon Industries" description="Industrial data, predictive operations, and engineering integration solutions." brand="Aureon" variant="aureon" home="/showcase/aureon-industries/" nav={aureonNav} cta={aureonCta}>
 <section class="aureon-subhero"><T class="aureon-label" en="Solutions" it="Soluzioni" fr="Solutions" es="Soluciones" /><T as="h1" en="Operational systems that scale." it="Sistemi operativi che crescono." fr="Des systèmes opérationnels évolutifs." es="Sistemas operativos que escalan." /></section>
 <section class="aureon-section"><div class="aureon-head"><div><T class="aureon-label" en="A modular architecture" it="Un'architettura modulare" fr="Une architecture modulaire" es="Una arquitectura modular" /><T as="h2" en="Start where the constraint is." it="Parti dal vero limite." fr="Commencez par la contrainte réelle." es="Empieza por la restricción real." /></div><T as="p" en="Each engagement begins with a measurable production constraint. Components can be deployed independently and connected over time." it="Ogni intervento parte da un limite produttivo misurabile. I componenti possono essere introdotti separatamente e collegati nel tempo." fr="Chaque mission part d'une contrainte de production mesurable. Les composants peuvent être déployés séparément puis connectés." es="Cada proyecto parte de una limitación productiva medible. Los componentes pueden desplegarse por separado y conectarse después." /></div><div class="aureon-services"><article><span>01 / CONNECT</span><T as="h3" en="Machine connectivity" it="Connettività macchina" fr="Connectivité machine" es="Conectividad de máquinas" /><T as="p" en="Protocol adapters, edge gateways, data validation, and secure plant-to-cloud transport." it="Adattatori di protocollo, gateway edge, validazione dati e trasporto sicuro plant-to-cloud." fr="Adaptateurs de protocole, passerelles edge, validation des données et transport sécurisé." es="Adaptadores de protocolo, gateways edge, validación y transporte seguro a la nube." /></article><article><span>02 / UNDERSTAND</span><T as="h3" en="Operations intelligence" it="Intelligence operativa" fr="Intelligence opérationnelle" es="Inteligencia operativa" /><T as="p" en="Contextualised KPIs, shift analysis, event timelines, and root-cause workspaces." it="KPI contestualizzati, analisi dei turni, timeline degli eventi e ambienti per la root cause." fr="KPI contextualisés, analyse des équipes, chronologie des événements et espaces de diagnostic." es="KPI contextualizados, análisis de turnos, cronologías de eventos y espacios de causa raíz." /></article><article><span>03 / IMPROVE</span><T as="h3" en="Predictive optimisation" it="Ottimizzazione predittiva" fr="Optimisation prédictive" es="Optimización predictiva" /><T as="p" en="Condition models, prioritised alerts, maintenance planning, and verified improvement cycles." it="Modelli di condizione, avvisi prioritari, pianificazione manutentiva e cicli di miglioramento verificati." fr="Modèles d'état, alertes prioritaires, planification de maintenance et cycles d'amélioration vérifiés." es="Modelos de condición, alertas prioritarias, planificación de mantenimiento y ciclos verificados." /></article></div></section>
 <section class="aureon-section aureon-section--dark"><div class="aureon-head"><div><T class="aureon-label" en="Delivery model" it="Modello di consegna" fr="Modèle de réalisation" es="Modelo de entrega" /><T as="h2" en="Four stages. One accountable team." it="Quattro fasi. Un unico team responsabile." fr="Quatre étapes. Une équipe responsable." es="Cuatro fases. Un equipo responsable." /></div><T as="p" en="A clear path from plant assessment to validated deployment and continuous improvement." it="Un percorso chiaro dalla valutazione dell'impianto alla distribuzione validata e al miglioramento continuo." fr="Un parcours clair de l'évaluation du site au déploiement validé et à l'amélioration continue." es="Un camino claro desde la evaluación de planta hasta el despliegue validado y la mejora continua." /></div><div class="aureon-process"><article><span>01</span><T as="h3" en="Assess" it="Valuta" fr="Évaluer" es="Evaluar" /><T as="p" en="Map systems, constraints, data quality, and target outcomes." it="Mappa sistemi, limiti, qualità dei dati e risultati attesi." fr="Cartographier systèmes, contraintes, qualité des données et objectifs." es="Mapear sistemas, restricciones, calidad de datos y objetivos." /></article><article><span>02</span><T as="h3" en="Prototype" it="Prototipa" fr="Prototyper" es="Prototipar" /><T as="p" en="Prove value on one line with controlled scope." it="Dimostra il valore su una linea con ambito controllato." fr="Démontrer la valeur sur une ligne avec un périmètre contrôlé." es="Demostrar valor en una línea con alcance controlado." /></article><article><span>03</span><T as="h3" en="Deploy" it="Distribuisci" fr="Déployer" es="Desplegar" /><T as="p" en="Integrate securely, train teams, and validate acceptance criteria." it="Integra in sicurezza, forma i team e valida i criteri di accettazione." fr="Intégrer en sécurité, former les équipes et valider les critères." es="Integrar de forma segura, formar equipos y validar criterios." /></article><article><span>04</span><T as="h3" en="Scale" it="Estendi" fr="Étendre" es="Escalar" /><T as="p" en="Standardise the model across assets, lines, and locations." it="Standardizza il modello su asset, linee e stabilimenti." fr="Standardiser le modèle sur les actifs, lignes et sites." es="Estandarizar el modelo en activos, líneas y plantas." /></article></div></section>
</ShowcaseShell>
