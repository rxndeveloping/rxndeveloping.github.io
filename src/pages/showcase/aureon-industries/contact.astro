---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { aureonNav, aureonCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Start a Project — Aureon Industries" description="Interactive multilingual project brief for the Aureon company concept." brand="Aureon" variant="aureon" home="/showcase/aureon-industries/" nav={aureonNav} cta={aureonCta}>
 <section class="aureon-subhero"><T class="aureon-label" en="Project brief" it="Brief di progetto" fr="Brief de projet" es="Brief del proyecto" /><T as="h1" en="Define the first useful step." it="Definisci il primo passo utile." fr="Définissez la première étape utile." es="Define el primer paso útil." /></section>
 <section class="aureon-section"><div class="aureon-head"><div><T class="aureon-label" en="Interactive scope builder" it="Configuratore interattivo" fr="Configurateur interactif" es="Configurador interactivo" /><T as="h2" en="Turn a constraint into a brief." it="Trasforma un limite in un brief." fr="Transformez une contrainte en brief." es="Convierte una limitación en un brief." /></div><T as="p" en="Select the project shape and receive an indicative demonstration range. No data is sent from this concept form." it="Seleziona la forma del progetto e ottieni una stima dimostrativa. Nessun dato viene inviato da questo form concept." fr="Sélectionnez la forme du projet et obtenez une estimation indicative. Aucune donnée n'est envoyée." es="Selecciona el tipo de proyecto y obtén una estimación orientativa. No se envía ningún dato." /></div><form class="aureon-brief" data-aureon-brief><div class="aureon-brief__grid"><label><T en="Primary objective" it="Obiettivo principale" fr="Objectif principal" es="Objetivo principal" /><select data-brief-scope><option value="1" data-showcase-copy data-copy-en="Machine connectivity" data-copy-it="Connettività macchina" data-copy-fr="Connectivité machine" data-copy-es="Conectividad de máquinas">Machine connectivity</option><option value="1.4" data-showcase-copy data-copy-en="Operations dashboard" data-copy-it="Dashboard operativa" data-copy-fr="Tableau de bord opérationnel" data-copy-es="Panel operativo">Operations dashboard</option><option value="1.8" data-showcase-copy data-copy-en="Predictive operations" data-copy-it="Operazioni predittive" data-copy-fr="Opérations prédictives" data-copy-es="Operaciones predictivas">Predictive operations</option><option value="2.3" data-showcase-copy data-copy-en="Multi-site platform" data-copy-it="Piattaforma multi-stabilimento" data-copy-fr="Plateforme multisite" data-copy-es="Plataforma multiplanta">Multi-site platform</option></select></label><label><T en="Number of production lines" it="Numero di linee produttive" fr="Nombre de lignes" es="Número de líneas" /><select data-brief-lines><option value="1" data-showcase-copy data-copy-en="1 line" data-copy-it="1 linea" data-copy-fr="1 ligne" data-copy-es="1 línea">1 line</option><option value="1.3" data-showcase-copy data-copy-en="2–4 lines" data-copy-it="2–4 linee" data-copy-fr="2–4 lignes" data-copy-es="2–4 líneas">2–4 lines</option><option value="1.8" data-showcase-copy data-copy-en="5–10 lines" data-copy-it="5–10 linee" data-copy-fr="5–10 lignes" data-copy-es="5–10 líneas">5–10 lines</option><option value="2.5" data-showcase-copy data-copy-en="10+ lines" data-copy-it="10+ linee" data-copy-fr="10+ lignes" data-copy-es="10+ líneas">10+ lines</option></select></label><label><T en="Integration complexity" it="Complessità d'integrazione" fr="Complexité d'intégration" es="Complejidad de integración" /><select data-brief-complexity><option value="1" data-showcase-copy data-copy-en="Standard protocols" data-copy-it="Protocolli standard" data-copy-fr="Protocoles standards" data-copy-es="Protocolos estándar">Standard protocols</option><option value="1.35" data-showcase-copy data-copy-en="Mixed legacy systems" data-copy-it="Sistemi legacy misti" data-copy-fr="Systèmes legacy mixtes" data-copy-es="Sistemas legacy mixtos">Mixed legacy systems</option><option value="1.8" data-showcase-copy data-copy-en="Regulated environment" data-copy-it="Ambiente regolamentato" data-copy-fr="Environnement réglementé" data-copy-es="Entorno regulado">Regulated environment</option></select></label><label><T en="Desired start" it="Avvio desiderato" fr="Démarrage souhaité" es="Inicio deseado" /><input type="month" /></label></div><label><T en="Operational constraint" it="Limite operativo" fr="Contrainte opérationnelle" es="Limitación operativa" /><textarea rows="5" data-showcase-placeholder data-placeholder-en="Describe the problem, current systems, and expected outcome..." data-placeholder-it="Descrivi il problema, i sistemi attuali e il risultato atteso..." data-placeholder-fr="Décrivez le problème, les systèmes actuels et le résultat attendu..." data-placeholder-es="Describe el problema, los sistemas actuales y el resultado esperado..." placeholder="Describe the problem, current systems, and expected outcome..."></textarea></label><div class="aureon-project" style="min-height:210px;margin-bottom:30px"><span><T en="INDICATIVE CONCEPT RANGE" it="STIMA DIMOSTRATIVA" fr="ESTIMATION INDICATIVE" es="ESTIMACIÓN ORIENTATIVA" /></span><h3 data-brief-estimate>€18k — €28k</h3><T as="p" en="A real proposal would follow a technical discovery and site assessment." it="Un'offerta reale seguirebbe un'analisi tecnica e una valutazione dell'impianto." fr="Une offre réelle suivrait une découverte technique et une évaluation du site." es="Una propuesta real seguiría un análisis técnico y una evaluación de planta." /></div><div class="aureon-brief__grid"><label><T en="Name" it="Nome" fr="Nom" es="Nombre" /><input required autocomplete="name" /></label><label><T en="Business email" it="Email aziendale" fr="E-mail professionnel" es="Correo de empresa" /><input required type="email" autocomplete="email" /></label></div><button type="submit"><T en="Create demonstration brief ↗" it="Crea brief dimostrativo ↗" fr="Créer le brief de démonstration ↗" es="Crear brief de demostración ↗" /></button></form><section data-brief-confirmation hidden class="aureon-project" style="margin-top:35px"><span>BRIEF / DEMO</span><T as="h3" en="Your project brief is ready." it="Il brief del progetto è pronto." fr="Votre brief projet est prêt." es="El brief del proyecto está listo." /><T as="p" en="This is an interactive portfolio demonstration. No information was transmitted." it="Questa è una dimostrazione interattiva del portfolio. Nessuna informazione è stata trasmessa." fr="Ceci est une démonstration interactive. Aucune information n'a été transmise." es="Esta es una demostración interactiva. No se ha transmitido información." /></section></section>
 <script>const brief=document.querySelector<HTMLFormElement>('[data-aureon-brief]');const estimate=document.querySelector<HTMLElement>('[data-brief-estimate]');function updateEstimate(){if(!brief||!estimate)return;const values=[...brief.querySelectorAll<HTMLSelectElement>('select')].map(item=>Number(item.value));const factor=values.reduce((total,value)=>total*value,1);const low=Math.round(18*factor);const high=Math.round(low*1.55);estimate.textContent=`€${low}k — €${high}k`;}brief?.querySelectorAll('select').forEach(item=>item.addEventListener('change',updateEstimate));brief?.addEventListener('submit',event=>{event.preventDefault();if(!brief.reportValidity())return;document.querySelector<HTMLElement>('[data-brief-confirmation]')?.removeAttribute('hidden');});</script>
</ShowcaseShell>
