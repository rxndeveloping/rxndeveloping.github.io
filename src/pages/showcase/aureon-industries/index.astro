---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { aureonNav, aureonCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Aureon Industries — Industrial Intelligence" description="A complete multilingual B2B industrial company website concept by RxN Developing." brand="Aureon" variant="aureon" home="/showcase/aureon-industries/" nav={aureonNav} cta={aureonCta}>
  <section class="aureon-hero"><div class="aureon-hero__copy"><T class="aureon-label" en="Industrial intelligence · Europe" it="Intelligenza industriale · Europa" fr="Intelligence industrielle · Europe" es="Inteligencia industrial · Europa" /><T as="h1" en="Make production visible." it="Rendi visibile la produzione." fr="Rendez la production visible." es="Haz visible la producción." /><T as="p" en="Aureon connects machines, operational data, and engineering teams to reduce downtime and make every production decision measurable." it="Aureon connette macchine, dati operativi e team di ingegneria per ridurre i fermi e rendere misurabile ogni decisione produttiva." fr="Aureon connecte machines, données opérationnelles et équipes d'ingénierie pour réduire les arrêts et mesurer chaque décision de production." es="Aureon conecta máquinas, datos operativos y equipos de ingeniería para reducir paradas y medir cada decisión de producción." /><div class="aureon-actions"><a class="aureon-button aureon-button--blue" href="/showcase/aureon-industries/solutions/"><T en="Explore solutions" it="Esplora le soluzioni" fr="Explorer les solutions" es="Explorar soluciones" /></a><a class="aureon-button" href="/showcase/aureon-industries/contact/"><T en="Discuss a project" it="Parla del progetto" fr="Parler du projet" es="Hablar del proyecto" /></a></div></div><div class="aureon-hero__visual"><img src="/assets/showcases/aureon/factory.jpg" alt="Automated production facility" /><div class="aureon-hero__metric"><strong>97.4%</strong><span><T en="Average monitored line availability" it="Disponibilità media delle linee monitorate" fr="Disponibilité moyenne des lignes suivies" es="Disponibilidad media de las líneas monitorizadas" /></span></div></div></section>
  <section class="aureon-section"><div class="aureon-head"><div><T class="aureon-label" en="01 / Capabilities" it="01 / Competenze" fr="01 / Capacités" es="01 / Capacidades" /><T as="h2" en="From machine signal to business action." it="Dal segnale macchina alla decisione aziendale." fr="Du signal machine à l'action métier." es="De la señal de máquina a la acción empresarial." /></div><T as="p" en="A modular stack for manufacturers that need reliable data, faster diagnostics, and systems that fit existing operations rather than replacing them." it="Uno stack modulare per produttori che richiedono dati affidabili, diagnostica più rapida e sistemi capaci di integrarsi con le operazioni esistenti." fr="Une architecture modulaire pour les industriels recherchant des données fiables, un diagnostic rapide et des systèmes intégrés à l'existant." es="Una arquitectura modular para fabricantes que necesitan datos fiables, diagnóstico rápido y sistemas integrados con sus operaciones." /></div><div class="aureon-services"><article><span>01</span><T as="h3" en="Industrial data platforms" it="Piattaforme dati industriali" fr="Plateformes de données industrielles" es="Plataformas de datos industriales" /><T as="p" en="Unify PLC, sensor, MES, and ERP data in a governed operational layer." it="Unifica dati PLC, sensori, MES ed ERP in un livello operativo governato." fr="Unifiez les données PLC, capteurs, MES et ERP dans une couche opérationnelle gouvernée." es="Unifica datos PLC, sensores, MES y ERP en una capa operativa gobernada." /></article><article><span>02</span><T as="h3" en="Predictive operations" it="Operazioni predittive" fr="Opérations prédictives" es="Operaciones predictivas" /><T as="p" en="Detect abnormal behaviour early and prioritise maintenance by production impact." it="Rileva anomalie in anticipo e assegna priorità alla manutenzione in base all'impatto produttivo." fr="Détectez les anomalies tôt et priorisez la maintenance selon l'impact de production." es="Detecta anomalías pronto y prioriza el mantenimiento según el impacto productivo." /></article><article><span>03</span><T as="h3" en="Engineering integration" it="Integrazione ingegneristica" fr="Intégration d'ingénierie" es="Integración de ingeniería" /><T as="p" en="Connect new monitoring and control layers without disrupting qualified processes." it="Collega nuovi livelli di monitoraggio e controllo senza interrompere i processi qualificati." fr="Connectez de nouvelles couches de suivi sans perturber les processus qualifiés." es="Conecta nuevas capas de monitorización sin interrumpir procesos cualificados." /></article></div></section>
  <section class="aureon-section aureon-section--dark"><div class="aureon-head"><div><T class="aureon-label" en="Live operations model" it="Modello operativo live" fr="Modèle opérationnel en direct" es="Modelo operativo en vivo" /><T as="h2" en="One view. Different decisions." it="Una vista. Decisioni diverse." fr="Une vue. Plusieurs décisions." es="Una vista. Distintas decisiones." /></div><T as="p" en="Use the interactive panel to preview how the same production data supports availability, energy, and quality teams." it="Usa il pannello interattivo per vedere come gli stessi dati supportano disponibilità, energia e qualità." fr="Utilisez le panneau interactif pour voir comment les mêmes données servent disponibilité, énergie et qualité." es="Usa el panel interactivo para ver cómo los mismos datos apoyan disponibilidad, energía y calidad." /></div><div class="aureon-dashboard"><aside><button class="active" data-au-metric="97.4" data-au-bars="42,58,48,74,62,88,71,92,76,95"><T en="Line availability" it="Disponibilità linea" fr="Disponibilité de ligne" es="Disponibilidad de línea" /></button><button data-au-metric="-18.6" data-au-bars="91,84,78,75,69,61,58,52,49,45"><T en="Energy intensity" it="Intensità energetica" fr="Intensité énergétique" es="Intensidad energética" /></button><button data-au-metric="99.2" data-au-bars="76,82,78,91,87,94,88,96,93,98"><T en="First-pass quality" it="Qualità al primo passaggio" fr="Qualité au premier passage" es="Calidad a la primera" /></button></aside><div class="aureon-chart"><div class="aureon-chart__bars" data-au-chart>{[42,58,48,74,62,88,71,92,76,95].map((h)=><span style={`--h:${h}%`}></span>)}</div><div class="aureon-chart__meta"><div><T en="Current performance" it="Prestazione attuale" fr="Performance actuelle" es="Rendimiento actual" /><strong data-au-value>97.4%</strong></div><T en="10 production cycles" it="10 cicli produttivi" fr="10 cycles de production" es="10 ciclos de producción" /></div></div></div></section>
  <script>const metricButtons=document.querySelectorAll<HTMLButtonElement>('[data-au-metric]');const bars=document.querySelectorAll<HTMLElement>('[data-au-chart] span');const value=document.querySelector<HTMLElement>('[data-au-value]');metricButtons.forEach(button=>button.addEventListener('click',()=>{metricButtons.forEach(item=>item.classList.remove('active'));button.classList.add('active');const heights=(button.dataset.auBars||'').split(',');bars.forEach((bar,index)=>bar.style.setProperty('--h',`${heights[index]||50}%`));if(value)value.textContent=`${button.dataset.auMetric}%`;}));</script>
</ShowcaseShell>
