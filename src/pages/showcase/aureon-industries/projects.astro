---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { aureonNav, aureonCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Projects — Aureon Industries" description="Fictional industrial transformation case studies for the Aureon concept." brand="Aureon" variant="aureon" home="/showcase/aureon-industries/" nav={aureonNav} cta={aureonCta}>
 <section class="aureon-subhero"><T class="aureon-label" en="Selected outcomes" it="Risultati selezionati" fr="Résultats sélectionnés" es="Resultados seleccionados" /><T as="h1" en="Work measured in operations." it="Lavoro misurato nelle operazioni." fr="Un travail mesuré sur le terrain." es="Trabajo medido en operaciones." /></section>
 <section class="aureon-section"><div class="aureon-head"><div><T class="aureon-label" en="Fictional case studies" it="Casi studio immaginari" fr="Études de cas fictives" es="Casos de estudio ficticios" /><T as="h2" en="Different plants. Clear impact." it="Impianti diversi. Impatto chiaro." fr="Des sites différents. Un impact clair." es="Plantas distintas. Impacto claro." /></div><T as="p" en="These scenarios demonstrate how an advanced B2B portfolio can communicate scope, integration, and business outcomes without overwhelming the reader." it="Questi scenari mostrano come un portfolio B2B avanzato possa comunicare ambito, integrazione e risultati senza sovraccaricare il lettore." fr="Ces scénarios montrent comment un portfolio B2B avancé communique périmètre, intégration et résultats sans surcharger le lecteur." es="Estos escenarios muestran cómo un portfolio B2B avanzado comunica alcance, integración y resultados sin saturar al lector." /></div><div class="aureon-projects"><article class="aureon-project"><span>FOOD / MULTI-SITE</span><T as="h3" en="Cold-chain visibility across three plants" it="Visibilità della catena del freddo su tre stabilimenti" fr="Visibilité de la chaîne du froid sur trois sites" es="Visibilidad de la cadena de frío en tres plantas" /><T as="p" en="Connected 420 temperature points, unified alarm handling, and introduced traceable response workflows." it="Collegati 420 punti temperatura, unificata la gestione degli allarmi e introdotti flussi di risposta tracciabili." fr="Connexion de 420 points de température, gestion unifiée des alarmes et procédures de réponse traçables." es="Conexión de 420 puntos de temperatura, gestión unificada de alarmas y flujos de respuesta trazables." /><strong>−31% alarm response time</strong></article><article class="aureon-project"><span>AUTOMOTIVE / ASSEMBLY</span><T as="h3" en="Predictive maintenance for critical conveyors" it="Manutenzione predittiva per trasportatori critici" fr="Maintenance prédictive des convoyeurs critiques" es="Mantenimiento predictivo de transportadores críticos" /><T as="p" en="Combined vibration, current, and production context to prioritise maintenance windows before failure." it="Combinati vibrazioni, corrente e contesto produttivo per pianificare la manutenzione prima del guasto." fr="Combinaison vibration, courant et contexte de production pour planifier avant la panne." es="Combinación de vibración, corriente y contexto productivo para planificar antes del fallo." /><strong>+14% planned maintenance</strong></article><article class="aureon-project"><span>PACKAGING / ENERGY</span><T as="h3" en="Energy intensity by product and shift" it="Intensità energetica per prodotto e turno" fr="Intensité énergétique par produit et équipe" es="Intensidad energética por producto y turno" /><T as="p" en="Mapped consumption to production orders and exposed avoidable idle loads in real time." it="Associati i consumi agli ordini di produzione e rilevati in tempo reale i carichi inutili." fr="Rattachement des consommations aux ordres et détection en temps réel des charges inutiles." es="Asignación del consumo a órdenes y detección en tiempo real de cargas evitables." /><strong>−18.6% kWh / unit</strong></article><article class="aureon-project"><span>PHARMA / QUALITY</span><T as="h3" en="Digital event review for a qualified line" it="Revisione digitale degli eventi per una linea qualificata" fr="Revue numérique des événements d'une ligne qualifiée" es="Revisión digital de eventos para una línea cualificada" /><T as="p" en="Created a governed event timeline without changing validated machine control." it="Creata una timeline governata degli eventi senza modificare il controllo macchina validato." fr="Création d'une chronologie gouvernée sans modifier le contrôle machine validé." es="Creación de una cronología gobernada sin modificar el control validado." /><strong>−42% review preparation</strong></article></div></section>
</ShowcaseShell>
