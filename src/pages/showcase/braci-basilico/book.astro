---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import AdvancedBooking from '../../../components/showcase/AdvancedBooking.astro';
import { braciNav, braciCta } from '../../../data/showcaseNavigation';
const experiences=[{id:'dinner',title:{en:'Dinner table',it:'Tavolo cena',fr:'Table du soir',es:'Mesa para cenar'},detail:{en:'A standard table for pizza, drinks, and dessert.',it:'Un tavolo per pizza, drink e dolce.',fr:'Une table pour pizzas, boissons et dessert.',es:'Una mesa para pizza, bebidas y postre.'}},{id:'counter',title:{en:'Pizza counter',it:'Bancone pizza',fr:'Comptoir pizza',es:'Barra de pizza'},detail:{en:'Watch the oven team from the front row.',it:'Guarda la squadra del forno in prima fila.',fr:'Observez l’équipe du four au premier rang.',es:'Mira al equipo del horno desde primera fila.'}},{id:'event',title:{en:'Event night',it:'Serata evento',fr:'Soirée événement',es:'Noche de evento'},detail:{en:'Book for a listed event or limited-menu drop.',it:'Prenota per un evento o un menu limitato.',fr:'Réservez pour un événement ou menu limité.',es:'Reserva para un evento o menú limitado.'}}];
---
<ShowcaseShell title="Book — Braci & Basilico" description="Interactive multilingual table booking demo for Braci & Basilico." brand="Braci & Basilico" variant="braci" home="/showcase/braci-basilico/" nav={braciNav} cta={braciCta}>
 <section class="braci-booking-page"><div class="braci-head"><div><T class="braci-kicker" en="Book online" it="Prenota online" fr="Réserver en ligne" es="Reservar online" /><T as="h1" en="Get your table." it="Prendi il tuo tavolo." fr="Prenez votre table." es="Consigue tu mesa." /></div><T as="p" en="Choose the format, date, party size, and an available time. The final confirmation is simulated for this portfolio concept." it="Scegli formula, data, numero di persone e un orario disponibile. La conferma finale è simulata per questo concept." fr="Choisissez la formule, la date, le nombre de personnes et un horaire. La confirmation finale est simulée." es="Elige formato, fecha, número de personas y horario. La confirmación final es simulada." /></div><AdvancedBooking brand="Braci" experiences={experiences} /></section>
</ShowcaseShell>
