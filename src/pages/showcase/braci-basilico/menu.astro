---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { braciNav, braciCta } from '../../../data/showcaseNavigation';
const pizzas=[
 {c:'classic',name:'Margherita Ribelle',en:'San Marzano tomato, fior di latte, basil, extra virgin olive oil',it:'San Marzano, fior di latte, basilico, olio EVO',fr:'Tomate San Marzano, fior di latte, basilic, huile d’olive',es:'Tomate San Marzano, fior di latte, albahaca, aceite de oliva',p:'9'},
 {c:'special',name:'Fiamma',en:'Nduja, smoked provola, red onion, hot honey',it:'’Nduja, provola affumicata, cipolla rossa, miele piccante',fr:'Nduja, provola fumée, oignon rouge, miel pimenté',es:'Nduja, provola ahumada, cebolla roja, miel picante',p:'14'},
 {c:'special',name:'Bosco',en:'Fior di latte, roasted mushrooms, sausage, garlic cream',it:'Fior di latte, funghi arrosto, salsiccia, crema all’aglio',fr:'Fior di latte, champignons rôtis, saucisse, crème d’ail',es:'Fior di latte, setas asadas, salchicha, crema de ajo',p:'15'},
 {c:'plant',name:'Orto Notturno',en:'Courgette cream, yellow tomato, olives, mint',it:'Crema di zucchine, datterino giallo, olive, menta',fr:'Crème de courgette, tomate jaune, olives, menthe',es:'Crema de calabacín, tomate amarillo, aceitunas, menta',p:'13'},
 {c:'classic',name:'Diavola 2.0',en:'Tomato, spicy salami, stracciatella, chilli',it:'Pomodoro, salame piccante, stracciatella, peperoncino',fr:'Tomate, salami piquant, stracciatella, piment',es:'Tomate, salami picante, stracciatella, chile',p:'12'},
 {c:'plant',name:'Rossa Veg',en:'Roasted tomato, aubergine, capers, basil',it:'Pomodoro arrosto, melanzana, capperi, basilico',fr:'Tomate rôtie, aubergine, câpres, basilic',es:'Tomate asado, berenjena, alcaparras, albahaca',p:'11'}];
---
<ShowcaseShell title="Menu — Braci & Basilico" description="Filterable pizza menu for the Braci & Basilico concept." brand="Braci & Basilico" variant="braci" home="/showcase/braci-basilico/" nav={braciNav} cta={braciCta}>
 <section class="braci-subhero"><T class="braci-kicker" en="Fresh list · Updated weekly" it="Lista fresca · Aggiornata ogni settimana" fr="Carte fraîche · Mise à jour chaque semaine" es="Carta fresca · Actualizada cada semana" /><T as="h1" en="The pizza list." it="La lista delle pizze." fr="La liste des pizzas." es="La lista de pizzas." /></section>
 <section class="braci-section"><div class="braci-filter"><button class="active" data-pizza-filter="all"><T en="All" it="Tutte" fr="Toutes" es="Todas" /></button><button data-pizza-filter="classic"><T en="Classics" it="Classiche" fr="Classiques" es="Clásicas" /></button><button data-pizza-filter="special"><T en="Specials" it="Speciali" fr="Spéciales" es="Especiales" /></button><button data-pizza-filter="plant"><T en="Plant-based" it="Vegetali" fr="Végétales" es="Vegetales" /></button></div><div class="braci-menu-grid">{pizzas.map((pizza,index)=><article data-pizza-category={pizza.c}><span>0{index+1}</span><h3>{pizza.name}</h3><T as="p" en={pizza.en} it={pizza.it} fr={pizza.fr} es={pizza.es} /><strong>€ {pizza.p}</strong></article>)}</div></section>
 <script>const filterButtons=document.querySelectorAll<HTMLButtonElement>('[data-pizza-filter]');const pizzaCards=document.querySelectorAll<HTMLElement>('[data-pizza-category]');filterButtons.forEach(button=>button.addEventListener('click',()=>{filterButtons.forEach(item=>item.classList.remove('active'));button.classList.add('active');const value=button.dataset.pizzaFilter;pizzaCards.forEach(card=>card.hidden=value!=='all'&&card.dataset.pizzaCategory!==value)}));</script>
</ShowcaseShell>
