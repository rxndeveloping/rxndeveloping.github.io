---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { braciNav, braciCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Braci & Basilico — Urban Pizzeria" description="A complete multilingual pizzeria website concept by RxN Developing." brand="Braci & Basilico" variant="braci" home="/showcase/braci-basilico/" nav={braciNav} cta={braciCta}>
  <section class="braci-hero"><img src="/assets/showcases/braci/storefront.jpg" alt="Urban pizzeria at night" /><div class="braci-hero__copy"><T class="braci-kicker" en="Urban pizzeria · Turin" it="Pizzeria urbana · Torino" fr="Pizzeria urbaine · Turin" es="Pizzería urbana · Turín" /><T as="h1" en="Heat. Dough. Character." it="Calore. Impasto. Carattere." fr="Feu. Pâte. Caractère." es="Calor. Masa. Carácter." /><div class="braci-actions"><a class="braci-button braci-button--red" href="/showcase/braci-basilico/book/"><T en="Book a table ↗" it="Prenota un tavolo ↗" fr="Réserver une table ↗" es="Reservar una mesa ↗" /></a><a class="braci-button" href="/showcase/braci-basilico/menu/"><T en="See the menu" it="Guarda il menu" fr="Voir le menu" es="Ver el menú" /></a></div></div></section>
  <div class="braci-marquee"><div class="braci-marquee__track"><T en="48H FERMENTATION ✦ WOOD-FIRED OVEN ✦ ITALIAN INGREDIENTS ✦ LATE-NIGHT SLICES ✦" it="48H DI LIEVITAZIONE ✦ FORNO A LEGNA ✦ INGREDIENTI ITALIANI ✦ PIZZA FINO A TARDI ✦" fr="48H DE FERMENTATION ✦ FOUR À BOIS ✦ INGRÉDIENTS ITALIENS ✦ PIZZA TARDIVE ✦" es="48H DE FERMENTACIÓN ✦ HORNO DE LEÑA ✦ INGREDIENTES ITALIANOS ✦ PIZZA HASTA TARDE ✦" /><T en="48H FERMENTATION ✦ WOOD-FIRED OVEN ✦ ITALIAN INGREDIENTS ✦ LATE-NIGHT SLICES ✦" it="48H DI LIEVITAZIONE ✦ FORNO A LEGNA ✦ INGREDIENTI ITALIANI ✦ PIZZA FINO A TARDI ✦" fr="48H DE FERMENTATION ✦ FOUR À BOIS ✦ INGRÉDIENTS ITALIENS ✦ PIZZA TARDIVE ✦" es="48H DE FERMENTACIÓN ✦ HORNO DE LEÑA ✦ INGREDIENTES ITALIANOS ✦ PIZZA HASTA TARDE ✦" /></div></div>
  <section class="braci-section braci-section--paper"><div class="braci-head"><div><T class="braci-kicker" en="01 / The essentials" it="01 / Le cose serie" fr="01 / L'essentiel" es="01 / Lo esencial" /><T as="h2" en="Pizza without small talk." it="Pizza senza convenevoli." fr="La pizza sans détour." es="Pizza sin rodeos." /></div><T as="p" en="Long fermentation, direct fire, seasonal toppings, and a menu that changes often. Eat at the counter, share a table, or stay for the late set." it="Lunga lievitazione, fuoco diretto, topping stagionali e un menu che cambia spesso. Mangia al bancone, condividi il tavolo o resta per il DJ set." fr="Fermentation longue, feu direct, garnitures de saison et menu vivant. Mangez au comptoir, partagez une table ou restez pour le DJ set." es="Fermentación larga, fuego directo, ingredientes de temporada y un menú cambiante. Come en la barra, comparte mesa o quédate para el DJ set." /></div><div class="braci-grid"><article><span>01</span><T as="h3" en="48-hour dough" it="Impasto 48 ore" fr="Pâte 48 heures" es="Masa de 48 horas" /><T as="p" en="Italian flour, very little yeast, time, and temperature control." it="Farine italiane, pochissimo lievito, tempo e temperatura controllata." fr="Farines italiennes, très peu de levure, temps et température maîtrisée." es="Harinas italianas, muy poca levadura, tiempo y temperatura controlada." /></article><article><span>02</span><T as="h3" en="Wood and flame" it="Legna e fiamma" fr="Bois et flamme" es="Leña y llama" /><T as="p" en="A ninety-second bake creates a crisp base and an airy edge." it="Novanta secondi di cottura per una base croccante e un bordo leggero." fr="Une cuisson de quatre-vingt-dix secondes pour une base croustillante et un bord léger." es="Noventa segundos de cocción para una base crujiente y un borde ligero." /></article><article><span>03</span><T as="h3" en="More than dinner" it="Più di una cena" fr="Plus qu'un dîner" es="Más que una cena" /><T as="p" en="Weekly guest pizzas, vinyl nights, and limited hot-sauce drops." it="Pizze ospiti, serate vinyl e hot sauce in edizione limitata." fr="Pizzas invitées, soirées vinyles et sauces piquantes en édition limitée." es="Pizzas invitadas, noches de vinilo y salsas picantes de edición limitada." /></article></div></section>
  <section class="braci-split"><div><img src="/assets/showcases/braci/oven.jpg" alt="Wood-fired pizza oven" /></div><div class="braci-split__copy"><T class="braci-kicker" en="02 / Dough laboratory" it="02 / Laboratorio impasti" fr="02 / Laboratoire de pâte" es="02 / Laboratorio de masa" /><T as="h2" en="Slow first. Explosive later." it="Lento prima. Esplosivo dopo." fr="Lent d'abord. Explosif ensuite." es="Lento primero. Explosivo después." /><T as="p" en="Every batch is tracked from mixing to service, with hydration and fermentation adapted to temperature and humidity." it="Ogni impasto viene seguito dalla miscelazione al servizio, adattando idratazione e lievitazione a temperatura e umidità." fr="Chaque pâte est suivie du pétrissage au service, avec hydratation et fermentation adaptées à la température et à l'humidité." es="Cada masa se controla desde la mezcla hasta el servicio, adaptando hidratación y fermentación a la temperatura y humedad." /><div class="braci-stats"><div><strong>48h</strong><T en="fermentation" it="maturazione" fr="fermentation" es="fermentación" /></div><div><strong>430°</strong><T en="oven" it="forno" fr="four" es="horno" /></div><div><strong>90s</strong><T en="bake" it="cottura" fr="cuisson" es="cocción" /></div></div></div></section>
</ShowcaseShell>
