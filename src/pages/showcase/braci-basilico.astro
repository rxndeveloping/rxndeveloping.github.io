---
const pizzas = [
  { category: 'classiche', name: 'Margherita Ribelle', ingredients: 'San Marzano, fior di latte, basilico, olio EVO', price: '9' },
  { category: 'speciali', name: 'Fiamma', ingredients: '’Nduja, provola affumicata, cipolla rossa, miele piccante', price: '14' },
  { category: 'speciali', name: 'Bosco', ingredients: 'Fiordilatte, funghi arrosto, salsiccia, crema all’aglio', price: '15' },
  { category: 'vegetali', name: 'Orto Notturno', ingredients: 'Crema di zucchine, datterino giallo, olive, menta', price: '13' },
  { category: 'classiche', name: 'Diavola 2.0', ingredients: 'Pomodoro, salame piccante, stracciatella, peperoncino', price: '12' },
  { category: 'vegetali', name: 'Rossa Veg', ingredients: 'Pomodoro arrosto, melanzana, capperi, basilico', price: '11' },
];
---
<!doctype html>
<html lang="it">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Braci & Basilico: concept website dimostrativo creato da RxN Developing." /><title>Braci & Basilico — Concept by RxN Developing</title></head>
  <body>
    <div class="concept"><span>Demo concept · attività immaginaria</span><a href="/projects/#websites">Portfolio RxN ↗</a></div>
    <header><a class="logo" href="#top"><b>BRACI</b><i>&</i><b>BASILICO</b></a><nav><a href="#menu">Menu</a><a href="#impasto">Impasto</a><a href="#serate">Serate</a></nav><a class="order" href="#prenota">Prenota ↗</a></header>
    <main id="top">
      <section class="hero">
        <img src="/assets/showcases/braci/storefront.jpg" alt="Insegna al neon di una pizzeria urbana" />
        <div class="grain"></div><div class="hero-copy"><p>Pizzeria urbana · Torino</p><h1>Calore.<br /><span>Impasto.</span><br />Carattere.</h1><a href="#menu">Guarda il menu <b>↓</b></a></div>
        <div class="badge"><span>Aperti fino</span><strong>01:00</strong><small>VEN · SAB</small></div>
      </section>
      <section class="marquee" aria-label="Caratteristiche"><div>48 ORE DI LIEVITAZIONE ✦ FORNO A LEGNA ✦ INGREDIENTI ITALIANI ✦ COCKTAIL E BIRRE ARTIGIANALI ✦ 48 ORE DI LIEVITAZIONE ✦ FORNO A LEGNA ✦</div></section>
      <section class="menu" id="menu"><div class="title-row"><div><p>01 / Cose serie</p><h2>Le pizze</h2></div><div class="filters" aria-label="Filtra menu"><button class="active" data-filter="all">Tutte</button><button data-filter="classiche">Classiche</button><button data-filter="speciali">Speciali</button><button data-filter="vegetali">Vegetali</button></div></div><div class="pizza-grid">{pizzas.map((pizza,index)=><article data-category={pizza.category}><span>0{index+1}</span><h3>{pizza.name}</h3><p>{pizza.ingredients}</p><strong>€ {pizza.price}</strong></article>)}</div></section>
      <section class="dough" id="impasto"><div class="photo"><img src="/assets/showcases/braci/oven.jpg" alt="Pizza cotta nel forno a legna" /><span>FUOCO VERO</span></div><div class="copy"><p>02 / Il nostro impasto</p><h2>Lento prima.<br /><em>Esplosivo dopo.</em></h2><p>Farine italiane, pochissimo lievito e quarantotto ore di maturazione. Il risultato? Un cornicione croccante fuori, leggero dentro e una base che non si arrende al primo morso.</p><div class="stats"><div><b>48h</b><span>maturazione</span></div><div><b>430°</b><span>forno a legna</span></div><div><b>90s</b><span>di cottura</span></div></div></div></section>
      <section class="events" id="serate"><p>03 / Questa settimana</p><h2>Pizza, musica,<br />niente formalità.</h2><div class="event-list"><article><strong>GIO 21</strong><span>Vinyl & slices</span><small>DJ set dalle 21:30</small></article><article><strong>VEN 22</strong><span>Hot sauce club</span><small>Menu speciale in edizione limitata</small></article><article><strong>DOM 24</strong><span>Family table</span><small>Menu bambini e tavolata condivisa</small></article></div></section>
      <section class="booking" id="prenota"><div><p>Un tavolo, quattro amici,<br />pizza al centro.</p><h2>Ci vediamo<br />stasera?</h2></div><form id="pizza-booking"><input required placeholder="Nome" aria-label="Nome" /><input required type="date" aria-label="Data" /><select aria-label="Numero di persone"><option>2 persone</option><option>4 persone</option><option>6 persone</option><option>8+ persone</option></select><button>Trova un tavolo ↗</button></form><p id="booking-result" hidden>Modalità demo: nessuna prenotazione è stata inviata.</p></section>
    </main>
    <footer><a class="logo" href="#top"><b>BRACI</b><i>&</i><b>BASILICO</b></a><p>Corso Orbassano 00 · Torino<br />ciao@braciebasilico.example</p><p>Concept dimostrativo — attività e contatti sono immaginari.<br />Made by <a href="/">RxN Developing</a></p></footer>
    <script>
      const buttons = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('[data-category]');
      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('active')); button.classList.add('active');
        const filter = button.getAttribute('data-filter'); cards.forEach((card) => { card.toggleAttribute('hidden', filter !== 'all' && card.getAttribute('data-category') !== filter); });
      }));
      document.querySelector('#pizza-booking')?.addEventListener('submit',(event)=>{event.preventDefault();document.querySelector('#booking-result')?.removeAttribute('hidden')});
    </script>
  </body>
</html>
<style is:global>
  :root{--red:#ef3326;--black:#11100f;--paper:#f2e9d8;--acid:#d8f44a}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--black);color:var(--paper);font-family:Arial,sans-serif}a{color:inherit;text-decoration:none}.concept{height:30px;background:var(--acid);color:#10100e;display:flex;align-items:center;justify-content:space-between;padding:0 3vw;font:700 9px/1 Arial;letter-spacing:.16em;text-transform:uppercase}.concept a{text-decoration:underline}header{height:84px;padding:0 3vw;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid #3e3a34;position:absolute;top:30px;left:0;right:0;z-index:4}.logo{display:flex;gap:6px;align-items:center;font:900 21px/.8 Arial Narrow,Arial,sans-serif;letter-spacing:-.06em}.logo i{font:400 27px Georgia,serif;color:var(--red)}header nav{display:flex;gap:35px;font-size:11px;text-transform:uppercase;letter-spacing:.18em}header .order{justify-self:end;background:var(--red);padding:13px 19px;font-size:10px;font-weight:bold;text-transform:uppercase;letter-spacing:.12em}.hero{height:min(900px,100vh);min-height:680px;position:relative;overflow:hidden;display:flex;align-items:center;padding:110px 5vw 0}.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.15)}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,7,6,.9),rgba(8,7,6,.25)),linear-gradient(0deg,rgba(8,7,6,.75),transparent)}.grain{position:absolute;inset:0;opacity:.14;z-index:1;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E")}.hero-copy{position:relative;z-index:2}.hero-copy>p,.title-row p,.copy>p,.events>p{font:700 10px/1 Arial;letter-spacing:.24em;text-transform:uppercase;color:var(--acid)}.hero h1{font:900 clamp(67px,10vw,155px)/.75 Arial Narrow,Impact,sans-serif;letter-spacing:-.075em;text-transform:uppercase;margin:30px 0 55px}.hero h1 span{color:var(--red);-webkit-text-stroke:1px var(--red)}.hero-copy>a{font-weight:800;text-transform:uppercase;font-size:11px;letter-spacing:.14em;border:1px solid #8a8379;padding:17px 20px}.hero-copy>a b{margin-left:60px;color:var(--acid)}.badge{position:absolute;z-index:2;right:6vw;bottom:8vh;width:150px;height:150px;border-radius:50%;background:var(--acid);color:var(--black);display:flex;align-items:center;justify-content:center;flex-direction:column;transform:rotate(7deg)}.badge span,.badge small{font-size:9px;text-transform:uppercase;letter-spacing:.12em}.badge strong{font:900 38px/1 Arial Narrow,Arial;margin:7px}.marquee{overflow:hidden;background:var(--red);color:#120e0c;padding:14px 0;white-space:nowrap}.marquee div{font:900 14px/1 Arial;letter-spacing:.08em;word-spacing:15px}.menu{padding:120px 5vw;background:var(--paper);color:var(--black)}.title-row{display:flex;justify-content:space-between;align-items:flex-end}.title-row p{color:#7c382c}.title-row h2,.copy h2,.events h2,.booking h2{font:900 clamp(60px,8vw,115px)/.8 Arial Narrow,Impact,sans-serif;letter-spacing:-.065em;text-transform:uppercase;margin:25px 0 0}.filters{display:flex;gap:8px;flex-wrap:wrap}.filters button{border:1px solid #b8ae9e;background:transparent;padding:11px 15px;text-transform:uppercase;font-size:9px;font-weight:bold;cursor:pointer}.filters button.active{background:var(--black);color:var(--paper)}.pizza-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:70px;border-left:1px solid #b8ae9e;border-top:1px solid #b8ae9e}.pizza-grid article{min-height:235px;padding:25px;position:relative;border-right:1px solid #b8ae9e;border-bottom:1px solid #b8ae9e}.pizza-grid article>span{font:10px monospace;color:#8b8174}.pizza-grid h3{font:800 25px/1 Arial Narrow,Arial;text-transform:uppercase;max-width:220px;margin:48px 0 12px}.pizza-grid p{font:14px/1.5 Georgia,serif;max-width:290px;color:#625b51}.pizza-grid strong{position:absolute;right:22px;top:22px;color:var(--red);font-size:18px}.dough{display:grid;grid-template-columns:1fr 1fr;min-height:760px}.photo{position:relative;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.7) contrast(1.15)}.photo span{position:absolute;bottom:40px;right:-15px;font:900 clamp(40px,6vw,90px)/1 Arial Narrow,Impact;color:var(--acid);transform:rotate(-8deg)}.copy{padding:9vw 7vw;background:var(--red);color:#160f0d;display:flex;justify-content:center;flex-direction:column}.copy>p{color:#3a1712}.copy h2{font-size:clamp(50px,6vw,90px)}.copy h2 em{color:var(--paper);font-style:normal}.copy>p:not(:first-child){font:18px/1.6 Georgia,serif;max-width:580px;color:#391b16;margin-top:45px}.stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:60px;border-top:1px solid #7f211a;padding-top:30px}.stats div{display:flex;flex-direction:column}.stats b{font:900 36px/1 Arial Narrow,Arial}.stats span{font-size:9px;text-transform:uppercase;margin-top:8px;letter-spacing:.12em}.events{padding:120px 5vw}.events h2{margin:30px 0 75px}.event-list{border-top:1px solid #514b44}.event-list article{display:grid;grid-template-columns:150px 1fr 1fr;align-items:center;padding:27px 0;border-bottom:1px solid #514b44}.event-list strong{color:var(--acid);font-size:12px}.event-list span{font:800 26px Arial Narrow,Arial;text-transform:uppercase}.event-list small{color:#a9a095}.booking{padding:110px 5vw;background:var(--acid);color:var(--black);display:grid;grid-template-columns:1fr 1fr;gap:8vw;position:relative}.booking>div>p{text-transform:uppercase;font-size:10px;font-weight:bold;letter-spacing:.16em}.booking h2{font-size:clamp(58px,7vw,105px)}.booking form{display:flex;flex-direction:column;justify-content:center}.booking input,.booking select{background:transparent;border:0;border-bottom:2px solid #363929;padding:18px 2px;font:16px Arial;margin-bottom:12px;border-radius:0}.booking button{margin-top:25px;background:var(--red);border:0;padding:19px;font-weight:900;text-transform:uppercase;cursor:pointer}.booking>p{position:absolute;right:5vw;bottom:40px;font-size:12px}footer{padding:65px 5vw;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:end;gap:40px}footer p{font-size:11px;line-height:1.7;color:#928a80}footer p:last-child{text-align:right}footer p a{text-decoration:underline}@media(max-width:760px){header{grid-template-columns:1fr auto}header nav{display:none}.hero{padding-left:6vw}.hero h1{font-size:68px}.badge{width:105px;height:105px;right:5vw}.badge strong{font-size:26px}.title-row{align-items:flex-start;flex-direction:column;gap:40px}.pizza-grid{grid-template-columns:1fr}.dough{grid-template-columns:1fr}.photo{height:500px}.copy{padding:90px 6vw}.stats b{font-size:29px}.events{padding:90px 6vw}.event-list article{grid-template-columns:85px 1fr;gap:10px}.event-list small{grid-column:2}.booking{grid-template-columns:1fr;padding:90px 6vw}.booking>p{position:static}footer{grid-template-columns:1fr}footer p:last-child{text-align:left}}
</style>
