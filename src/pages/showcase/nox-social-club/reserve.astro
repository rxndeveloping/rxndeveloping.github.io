---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro'; import T from '../../../components/showcase/ShowcaseText.astro'; import AdvancedBooking from '../../../components/showcase/AdvancedBooking.astro'; import { noxNav,noxCta } from '../../../data/showcaseNavigation';
const experiences=[{id:'bar',title:{en:'Cocktail bar',it:'Cocktail bar',fr:'Bar à cocktails',es:'Coctelería'},detail:{en:'Counter or lounge seating with the full drinks menu.',it:'Banco o lounge con carta drink completa.',fr:'Comptoir ou lounge avec carte complète.',es:'Barra o lounge con carta completa.'}},{id:'listening',title:{en:'Listening room',it:'Listening room',fr:'Listening room',es:'Listening room'},detail:{en:'Reserved seating inside the music-led room.',it:'Posti riservati nella sala dedicata alla musica.',fr:'Places réservées dans la salle musicale.',es:'Asientos reservados en la sala musical.'}},{id:'late',title:{en:'Late-night table',it:'Tavolo late-night',fr:'Table late-night',es:'Mesa late-night'},detail:{en:'Table from 23:00 with bottle and cocktail service.',it:'Tavolo dalle 23:00 con servizio bottiglia e cocktail.',fr:'Table dès 23h avec service bouteille et cocktails.',es:'Mesa desde las 23:00 con servicio de botella y cócteles.'}}];
---
<ShowcaseShell title="Reserve — Nox Social Club" description="Interactive Nox reservation concept." brand="NOX" variant="nox" home="/showcase/nox-social-club/" nav={noxNav} cta={noxCta}><section class="nox-booking"><div class="nox-head"><div><T class="nox-kicker" en="Reservations" it="Prenotazioni" fr="Réservations" es="Reservas" /><T as="h1" en="Choose your side of the night." it="Scegli il tuo lato della notte." fr="Choisissez votre côté de la nuit." es="Elige tu lado de la noche." /></div><T as="p" en="Select the room, date, party, and time in a complete simulated booking journey." it="Seleziona sala, data, ospiti e orario in un percorso di prenotazione simulato completo." fr="Choisissez salle, date, convives et horaire dans un parcours simulé complet." es="Selecciona sala, fecha, personas y hora en un recorrido simulado completo." /></div><AdvancedBooking brand="Nox" experiences={experiences} /></section></ShowcaseShell>
