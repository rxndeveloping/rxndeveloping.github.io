---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro'; import T from '../../../components/showcase/ShowcaseText.astro'; import { noxNav,noxCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Nights — Nox Social Club" description="Weekly music and nightlife programme." brand="NOX" variant="nox" home="/showcase/nox-social-club/" nav={noxNav} cta={noxCta}>
  <section class="nox-section nox-section--violet"><div class="nox-head"><div><T class="nox-kicker" en="Programme / This month" it="Programma / Questo mese" fr="Programme / Ce mois" es="Programa / Este mes"/><T as="h1" en="Come for the sound. Stay for the room." it="Vieni per il suono. Resta per la sala." fr="Venez pour le son. Restez pour la salle." es="Ven por el sonido. Quédate por la sala."/></div><T as="p" en="Six nights with clear formats, times, access rules, artists, and direct reservations." it="Sei serate con format, orari, regole di accesso, artisti e prenotazioni dirette." fr="Six soirées avec formats, horaires, accès, artistes et réservation." es="Seis noches con formatos, horarios, acceso, artistas y reserva."/></div></section>
  <section class="nox-section"><div class="nox-cards nox-cards--programme">
    {[
      ['05 SEP','01','Midnight Radio','22:30 — 02:00'],['12 SEP','01 + 02','Purple Hours','23:00 — 03:00'],['21 SEP','TERRACE','Open Air Session','19:00 — 00:00'],['27 SEP','01','Analog Affairs','22:00 — 02:00'],['04 OCT','02','Afterimage Live','23:00 — 03:00'],['11 OCT','ALL ROOMS','Nox Anniversary','20:00 — 04:00']
    ].map((night,index)=><article class="nox-card"><span>{night[0]} / {night[1]}</span><h3>{night[2]}</h3><T as="p" en={index%2?'Guest selectors, visual installations, and a dedicated late-night menu.':'Live music, vinyl selections, and a new seasonal cocktail pairing.'} it={index%2?'Guest selector, installazioni visive e menu late-night dedicato.':'Musica live, selezioni in vinile e nuovo pairing cocktail stagionale.'} fr={index%2?'Selectors invités, installations visuelles et menu nocturne.':'Musique live, vinyles et nouvel accord cocktail de saison.'} es={index%2?'Selectors invitados, instalaciones visuales y menú nocturno.':'Música en vivo, vinilos y nuevo maridaje de temporada.'}/><strong>{night[3]}</strong><a href="/showcase/nox-social-club/reserve/"><T en="Reserve this night" it="Prenota questa serata" fr="Réserver cette soirée" es="Reservar esta noche"/> ↗</a></article>)}
  </div></section>
</ShowcaseShell>
