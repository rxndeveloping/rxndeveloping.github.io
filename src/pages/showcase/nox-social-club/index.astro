---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { noxNav, noxCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Nox Social Club — Cocktails after dark" description="A multilingual nightlife and cocktail bar concept by RxN Developing." brand="NOX" variant="nox" home="/showcase/nox-social-club/" nav={noxNav} cta={noxCta}>
  <section class="nox-hero"><img src="/assets/showcases/nox/bar.jpg" alt="Nox cocktail bar interior" /><div class="nox-hero__copy"><T class="nox-kicker" en="Cocktail bar · Listening room · Milan" it="Cocktail bar · Listening room · Milano" fr="Bar à cocktails · Listening room · Milan" es="Coctelería · Listening room · Milán" /><T as="h1" en="The city sounds better after dark." it="La città suona meglio dopo il tramonto." fr="La ville sonne mieux après la nuit." es="La ciudad suena mejor de noche." /><T as="p" en="A nocturnal social club for signature drinks, vinyl selections, guest DJs, and small plates until late." it="Un social club notturno tra signature drink, selezioni in vinile, guest DJ e piccoli piatti fino a tardi." fr="Un club nocturne entre cocktails signature, vinyles, DJs invités et petites assiettes jusque tard." es="Un club nocturno con cócteles de autor, vinilos, DJs invitados y pequeños platos hasta tarde." /><div class="nox-actions"><a class="nox-button nox-button--primary" href="/showcase/nox-social-club/reserve/"><T en="Reserve your table" it="Prenota il tavolo" fr="Réserver une table" es="Reservar mesa" /></a><a class="nox-button" href="/showcase/nox-social-club/nights/"><T en="See this week's nights" it="Scopri le serate" fr="Voir les soirées" es="Ver las noches" /></a></div></div></section>
  <section class="nox-strip"><div><strong>18</strong><T en="signature drinks" it="signature drink" fr="cocktails signature" es="cócteles de autor" /></div><div><strong>02:00</strong><T en="last pour" it="ultimo servizio" fr="dernier service" es="último servicio" /></div><div><strong>1200+</strong><T en="records in rotation" it="vinili in rotazione" fr="vinyles en rotation" es="vinilos en rotación" /></div><div><T as="strong" en="Thu–Sun" it="Gio–Dom" fr="Jeu–Dim" es="Jue–Dom"/><T en="open weekly" it="aperto ogni settimana" fr="ouvert chaque semaine" es="abierto cada semana" /></div></section>
  <section class="nox-section"><div class="nox-head"><div><T class="nox-kicker" en="Tonight at NOX" it="Questa sera da NOX" fr="Ce soir chez NOX" es="Esta noche en NOX" /><T as="h2" en="A different frequency every night." it="Una frequenza diversa ogni sera." fr="Une fréquence différente chaque soir." es="Una frecuencia distinta cada noche." /></div><T as="p" en="Discover the weekly programme, check each room's atmosphere, and reserve the right experience without leaving the site." it="Scopri il programma settimanale, l'atmosfera di ogni sala e prenota l'esperienza giusta senza uscire dal sito." fr="Découvrez le programme, l'ambiance de chaque salle et réservez la bonne expérience sans quitter le site." es="Descubre el programa, el ambiente de cada sala y reserva la experiencia adecuada sin salir del sitio." /></div><div class="nox-cards"><article class="nox-card"><T as="span" en="THU / 22:00" it="GIO / 22:00" fr="JEU / 22:00" es="JUE / 22:00"/><T as="h3" en="Needle Drop" it="Needle Drop" fr="Needle Drop" es="Needle Drop" /><T as="p" en="Soul, jazz-funk, and rare grooves selected entirely on vinyl." it="Soul, jazz-funk e rare groove selezionati interamente in vinile." fr="Soul, jazz-funk et rare grooves exclusivement sur vinyle." es="Soul, jazz-funk y rare grooves seleccionados en vinilo." /><T as="strong" en="Free entry" it="Ingresso libero" fr="Entrée libre" es="Entrada libre"/><a href="/showcase/nox-social-club/nights/"><T en="View night" it="Apri serata" fr="Voir la soirée" es="Ver noche"/> ↗</a></article><article class="nox-card"><T as="span" en="FRI / 23:00" it="VEN / 23:00" fr="VEN / 23:00" es="VIE / 23:00"/><T as="h3" en="Afterimage" it="Afterimage" fr="Afterimage" es="Afterimage" /><T as="p" en="Guest selectors, low lights, and a focused late-night cocktail list." it="Guest selector, luci basse e una carta cocktail dedicata alla notte." fr="Selectors invités, lumière basse et carte nocturne dédiée." es="Selectors invitados, luces bajas y carta nocturna especial." /><T as="strong" en="Table booking" it="Prenotazione tavolo" fr="Réservation de table" es="Reserva de mesa"/><a href="/showcase/nox-social-club/reserve/"><T en="Reserve" it="Prenota" fr="Réserver" es="Reservar"/> ↗</a></article><article class="nox-card"><T as="span" en="SUN / 19:00" it="DOM / 19:00" fr="DIM / 19:00" es="DOM / 19:00"/><T as="h3" en="Soft Landing" it="Soft Landing" fr="Soft Landing" es="Soft Landing" /><T as="p" en="A slower session with acoustic sets, aperitivo plates, and seasonal highballs." it="Una sessione più lenta con set acustici, piatti aperitivo e highball stagionali." fr="Une session douce avec acoustique, aperitivo et highballs de saison." es="Una sesión suave con acústicos, aperitivo y highballs de temporada." /><T as="strong" en="Walk-ins welcome" it="Ingresso senza prenotazione" fr="Sans réservation" es="Sin reserva"/><a href="/showcase/nox-social-club/nights/"><T en="View programme" it="Vedi programma" fr="Voir le programme" es="Ver programa"/> ↗</a></article></div></section>
</ShowcaseShell>
