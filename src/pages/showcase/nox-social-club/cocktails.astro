---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro'; import T from '../../../components/showcase/ShowcaseText.astro'; import { noxNav,noxCta } from '../../../data/showcaseNavigation';
const drinks=[
 {name:'Static Bloom',price:'€15',detail:{en:'Gin, shiso, clarified citrus, fino sherry.',it:'Gin, shiso, agrumi chiarificati, fino sherry.',fr:'Gin, shiso, agrumes clarifiés, fino sherry.',es:'Ginebra, shiso, cítricos clarificados, fino sherry.'}},
 {name:'Velvet Signal',price:'€16',detail:{en:'Rye, cocoa, amaro, smoked cherry.',it:'Rye, cacao, amaro, ciliegia affumicata.',fr:'Rye, cacao, amaro, cerise fumée.',es:'Rye, cacao, amaro, cereza ahumada.'}},
 {name:'Night Service',price:'€15',detail:{en:'Mezcal, roasted pineapple, chilli, lime.',it:'Mezcal, ananas arrostito, peperoncino, lime.',fr:'Mezcal, ananas rôti, piment, citron vert.',es:'Mezcal, piña asada, chile, lima.'}},
 {name:'Zero Frequency',price:'€11',detail:{en:'Jasmine, verjus, white peach, tonic. Alcohol free.',it:'Gelsomino, verjus, pesca bianca, tonica. Analcolico.',fr:'Jasmin, verjus, pêche blanche, tonic. Sans alcool.',es:'Jazmín, verjus, melocotón blanco, tónica. Sin alcohol.'}},
 {name:'Black Orchid',price:'€16',detail:{en:'Vodka, blackcurrant, sake, Timut pepper.',it:'Vodka, ribes nero, sakè, pepe di Timut.',fr:'Vodka, cassis, saké, poivre de Timut.',es:'Vodka, grosella negra, sake, pimienta de Timut.'}},
 {name:'Satellite Spritz',price:'€14',detail:{en:'Orange bitter, kombucha, pét-nat.',it:'Bitter all’arancia, kombucha, pet-nat.',fr:'Bitter orange, kombucha, pét-nat.',es:'Bitter de naranja, kombucha, pét-nat.'}},
 {name:'Nocturne No. 7',price:'€17',detail:{en:'Agricole rum, coffee, banana, nutmeg.',it:'Rum agricolo, caffè, banana, noce moscata.',fr:'Rhum agricole, café, banane, muscade.',es:'Ron agrícola, café, plátano, nuez moscada.'}},
 {name:'Quiet Signal',price:'€11',detail:{en:'Oolong tea, pear, sea salt, soda. Alcohol free.',it:'Tè oolong, pera, sale marino, soda. Analcolico.',fr:'Thé oolong, poire, sel marin, soda. Sans alcool.',es:'Té oolong, pera, sal marina, soda. Sin alcohol.'}}
];
---
<ShowcaseShell title="Cocktails — Nox Social Club" description="The Nox cocktail list." brand="NOX" variant="nox" home="/showcase/nox-social-club/" nav={noxNav} cta={noxCta}>
  <section class="nox-section"><div class="nox-head"><div><T class="nox-kicker" en="The liquid archive" it="L'archivio liquido" fr="L'archive liquide" es="El archivo líquido"/><T as="h1" en="Classics, distorted." it="Classici, distorti." fr="Classiques, distordus." es="Clásicos, distorsionados."/></div><T as="p" en="Eight signatures, seasonal ingredients, and a complete alcohol-free collection." it="Otto signature, ingredienti stagionali e una collezione analcolica completa." fr="Huit signatures, ingrédients de saison et collection sans alcool." es="Ocho firmas, ingredientes de temporada y colección sin alcohol."/></div>
    <div class="nox-menu">
      {drinks.map((drink,index)=><article><div><small>0{index+1}</small><h3>{drink.name}</h3><T as="p" {...drink.detail}/><button data-showcase-action="details"><T en="Ingredients & allergens" it="Ingredienti e allergeni" fr="Ingrédients et allergènes" es="Ingredientes y alérgenos"/> ↗</button></div><strong>{drink.price}</strong></article>)}
    </div>
  </section>
  <section class="nox-night"><div><img src="/assets/showcases/nox/neon.jpg" alt="Neon club atmosphere"/></div><div class="nox-night__copy"><T class="nox-kicker" en="Seasonal laboratory" it="Laboratorio stagionale" fr="Laboratoire saisonnier" es="Laboratorio de temporada"/><T as="h2" en="Every ingredient has a second life." it="Ogni ingrediente ha una seconda vita." fr="Chaque ingrédient a une seconde vie." es="Cada ingrediente tiene una segunda vida."/><T as="p" en="Citrus husks become cordials, herbs become tinctures, and the kitchen shares its seasonal produce with the bar." it="Le scorze diventano cordial, le erbe tinture e la cucina condivide con il bar le materie prime stagionali." fr="Les écorces deviennent cordials, les herbes teintures et la cuisine partage ses produits avec le bar." es="Las pieles se convierten en cordial, las hierbas en tinturas y la cocina comparte sus productos con el bar."/></div></section>
</ShowcaseShell>
