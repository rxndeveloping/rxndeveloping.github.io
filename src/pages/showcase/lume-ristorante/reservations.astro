---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import AdvancedBooking from '../../../components/showcase/AdvancedBooking.astro';
import { lumeNav, lumeCta } from '../../../data/showcaseNavigation';
const experiences=[{id:'tasting',title:{en:'Tasting route',it:'Percorso degustazione',fr:'Menu dégustation',es:'Menú degustación'},detail:{en:'Five or eight courses selected by the kitchen.',it:'Cinque oppure otto portate scelte dalla cucina.',fr:'Cinq ou huit services choisis par la cuisine.',es:'Cinco u ocho pases elegidos por la cocina.'}},{id:'alacarte',title:{en:'À la carte',it:'À la carte',fr:'À la carte',es:'A la carta'},detail:{en:'Build your own evening from the seasonal menu.',it:'Costruisci la tua serata dal menu stagionale.',fr:'Composez votre soirée à partir du menu de saison.',es:'Crea tu velada con el menú de temporada.'}},{id:'private',title:{en:'Private dining',it:'Sala privata',fr:'Salle privée',es:'Sala privada'},detail:{en:'A dedicated room for four to twelve guests.',it:'Una sala dedicata da quattro a dodici ospiti.',fr:'Une salle dédiée de quatre à douze personnes.',es:'Una sala dedicada de cuatro a doce personas.'}}];
---
<ShowcaseShell title="Reservations — Lume Ristorante" description="Interactive multilingual reservation experience for Lume." brand="Lume" variant="lume" home="/showcase/lume-ristorante/" nav={lumeNav} cta={lumeCta}>
  <section class="lume-booking-page"><div class="lume-section__head"><div><T class="lume-kicker" en="Reservations" it="Prenotazioni" fr="Réservations" es="Reservas" /><T as="h1" en="Your evening begins here." it="La tua serata inizia qui." fr="Votre soirée commence ici." es="Tu noche empieza aquí." /></div><T as="p" en="A complete four-step booking demonstration with experience selection, live time slots, guest details, and confirmation summary." it="Una dimostrazione completa in quattro passaggi con scelta dell'esperienza, orari, dati degli ospiti e riepilogo di conferma." fr="Une démonstration complète en quatre étapes : expérience, horaires, coordonnées et récapitulatif." es="Una demostración completa en cuatro pasos: experiencia, horarios, datos y resumen de confirmación." /></div><AdvancedBooking brand="Lume" experiences={experiences} /><div class="lume-booking-help"><article><T as="strong" en="Groups" it="Gruppi" fr="Groupes" es="Grupos" /><T as="p" en="For more than eight guests, select Private dining or contact the restaurant." it="Per più di otto ospiti seleziona Sala privata o contatta il ristorante." fr="Pour plus de huit convives, choisissez Salle privée ou contactez le restaurant." es="Para más de ocho personas, elige Sala privada o contacta con el restaurante." /></article><article><T as="strong" en="Dietary needs" it="Esigenze alimentari" fr="Besoins alimentaires" es="Necesidades alimentarias" /><T as="p" en="Add allergies and preferences during step three." it="Inserisci allergie e preferenze durante il terzo passaggio." fr="Ajoutez allergies et préférences à la troisième étape." es="Añade alergias y preferencias en el tercer paso." /></article><article><T as="strong" en="Cancellation" it="Cancellazione" fr="Annulation" es="Cancelación" /><T as="p" en="This demonstration does not create or cancel real reservations." it="Questa dimostrazione non crea né cancella prenotazioni reali." fr="Cette démonstration ne crée ni n'annule de réservation réelle." es="Esta demostración no crea ni cancela reservas reales." /></article></div></section>
</ShowcaseShell>
