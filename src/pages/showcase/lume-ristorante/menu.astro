---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { lumeNav, lumeCta } from '../../../data/showcaseNavigation';
const dishes=[
  ['Ricordo di pomodoro','Beef tomato, almond, basil, mozzarella water','Pomodoro cuore di bue, mandorla, basilico, acqua di mozzarella','Tomate cœur de bœuf, amande, basilic, eau de mozzarella','Tomate corazón de buey, almendra, albahaca, agua de mozzarella','18'],
  ['Raviolo del sottobosco','Fresh pasta, porcini, hazelnut, thyme, vegetable jus','Pasta fresca, porcini, nocciola, timo, fondo vegetale','Pâtes fraîches, cèpes, noisette, thym, jus végétal','Pasta fresca, boletus, avellana, tomillo, jugo vegetal','24'],
  ['Ombrina alla brace','Meagre, fennel, fermented lemon, herb sauce','Ombrina, finocchio, limone fermentato, salsa alle erbe','Maigre, fenouil, citron fermenté, sauce aux herbes','Corvina, hinojo, limón fermentado, salsa de hierbas','32'],
  ['Anatra e ciliegia','Dry-aged duck, cherry, radicchio, smoked jus','Anatra frollata, ciliegia, radicchio, fondo affumicato','Canard maturé, cerise, radicchio, jus fumé','Pato madurado, cereza, achicoria, jugo ahumado','34'],
  ['Luce d’agrumi','Lemon, bergamot, Italian meringue, olive oil','Limone, bergamotto, meringa italiana, olio extravergine','Citron, bergamote, meringue italienne, huile d’olive','Limón, bergamota, merengue italiano, aceite de oliva','14']
];
---
<ShowcaseShell title="Menu — Lume Ristorante" description="Seasonal menu and tasting experiences at Lume." brand="Lume" variant="lume" home="/showcase/lume-ristorante/" nav={lumeNav} cta={lumeCta}>
  <section class="lume-subhero"><T class="lume-kicker" en="Season · Autumn 2026" it="Stagione · Autunno 2026" fr="Saison · Automne 2026" es="Temporada · Otoño 2026" /><T as="h1" en="The evening menu." it="Il menu della sera." fr="Le menu du soir." es="El menú de la noche." /></section>
  <section class="lume-section"><div class="lume-section__head"><div><T class="lume-kicker" en="À la carte" it="À la carte" fr="À la carte" es="A la carta" /><T as="h2" en="From the kitchen" it="Dalla cucina" fr="Depuis la cuisine" es="Desde la cocina" /></div><T as="p" en="The menu changes with the market. Vegetarian and allergy-aware routes are available with advance notice." it="Il menu cambia seguendo il mercato. Percorsi vegetariani e adattati alle allergie sono disponibili su richiesta anticipata." fr="Le menu évolue avec le marché. Des parcours végétariens et adaptés aux allergies sont disponibles sur demande." es="El menú cambia con el mercado. Hay recorridos vegetarianos y adaptados a alergias con aviso previo." /></div><div class="lume-menu-list">{dishes.map((dish,index)=><article><span>0{index+1}</span><div><h3>{dish[0]}</h3><T as="p" en={dish[1]} it={dish[2]} fr={dish[3]} es={dish[4]} /></div><strong>€ {dish[5]}</strong></article>)}</div></section>
  <section class="lume-section lume-section--dark"><div class="lume-section__head"><div><T class="lume-kicker" en="Tasting routes" it="Percorsi degustazione" fr="Menus dégustation" es="Menús degustación" /><T as="h2" en="Let the kitchen guide you." it="Lasciati guidare dalla cucina." fr="Laissez-vous guider par la cuisine." es="Déjate guiar por la cocina." /></div><T as="p" en="Choose five or eight courses, with an optional Italian wine pairing selected by our sommelier." it="Scegli cinque oppure otto portate, con abbinamento facoltativo di vini italiani selezionati dal nostro sommelier." fr="Choisissez cinq ou huit services, avec un accord de vins italiens sélectionné par notre sommelier." es="Elige cinco u ocho pases, con maridaje opcional de vinos italianos seleccionado por nuestro sumiller." /></div><div class="lume-schedule"><article><span>01</span><strong>5 · €95</strong><T as="p" en="A concise journey through the season." it="Un viaggio essenziale nella stagione." fr="Un voyage concis à travers la saison." es="Un recorrido esencial por la temporada." /></article><article><span>02</span><strong>8 · €135</strong><T as="p" en="The complete expression of Lume's kitchen." it="L'espressione completa della cucina di Lume." fr="L'expression complète de la cuisine de Lume." es="La expresión completa de la cocina de Lume." /></article><article><span>03</span><strong>+ €65</strong><T as="p" en="A tailored Italian wine pairing." it="Abbinamento personalizzato di vini italiani." fr="Accord personnalisé de vins italiens." es="Maridaje personalizado de vinos italianos." /></article></div></section>
</ShowcaseShell>
