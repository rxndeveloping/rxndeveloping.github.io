---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { lumeNav, lumeCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="The Experience — Lume Ristorante" description="Dining room, cellar, private events, and hospitality at Lume." brand="Lume" variant="lume" home="/showcase/lume-ristorante/" nav={lumeNav} cta={lumeCta}>
  <section class="lume-subhero"><T class="lume-kicker" en="Beyond the plate" it="Oltre il piatto" fr="Au-delà de l'assiette" es="Más allá del plato" /><T as="h1" en="A room with its own rhythm." it="Una sala con un ritmo tutto suo." fr="Une salle avec son propre rythme." es="Una sala con su propio ritmo." /></section>
  <section class="lume-feature"><div><img src="/assets/showcases/lume/dining-room.jpg" alt="Restaurant interior" /></div><div class="lume-feature__copy"><T class="lume-kicker" en="The dining room" it="La sala" fr="La salle" es="La sala" /><T as="h2" en="Twenty-eight seats. No rush." it="Ventotto coperti. Nessuna fretta." fr="Vingt-huit couverts. Sans précipitation." es="Veintiocho plazas. Sin prisas." /><T as="p" en="Natural materials, warm light, and generous spacing create an intimate environment for the tasting route or an à la carte evening." it="Materiali naturali, luce calda e spazi generosi creano un ambiente intimo per il percorso degustazione o una serata à la carte." fr="Matières naturelles, lumière chaude et espace généreux créent un cadre intime pour le menu dégustation ou une soirée à la carte." es="Materiales naturales, luz cálida y espacios generosos crean un ambiente íntimo para el menú degustación o una noche a la carta." /></div></section>
  <section class="lume-section"><div class="lume-section__head"><div><T class="lume-kicker" en="Hospitality" it="Ospitalità" fr="Hospitalité" es="Hospitalidad" /><T as="h2" en="Choose your way to experience Lume." it="Scegli come vivere Lume." fr="Choisissez votre façon de vivre Lume." es="Elige cómo vivir Lume." /></div><T as="p" en="From the chef's counter to a private room, every format is managed with the same attention to timing, dietary needs, and personal details." it="Dal bancone dello chef alla sala privata, ogni formula è gestita con la stessa attenzione a tempi, esigenze alimentari e dettagli personali." fr="Du comptoir du chef à la salle privée, chaque formule bénéficie de la même attention au rythme, aux régimes et aux détails personnels." es="Desde la barra del chef hasta la sala privada, cada formato recibe la misma atención al ritmo, las necesidades alimentarias y los detalles personales." /></div><div class="lume-card-grid"><article class="lume-card"><span>01</span><T as="h3" en="Chef's counter" it="Bancone dello chef" fr="Comptoir du chef" es="Barra del chef" /><T as="p" en="Six seats facing the pass, with direct narration from the kitchen." it="Sei posti davanti al pass, con racconto diretto dalla cucina." fr="Six places face au passe, commentées directement par la cuisine." es="Seis plazas frente al pase, narradas directamente por la cocina." /></article><article class="lume-card"><span>02</span><T as="h3" en="Private dining" it="Sala privata" fr="Salle privée" es="Sala privada" /><T as="p" en="A dedicated space for celebrations and business dinners, up to twelve guests." it="Uno spazio dedicato a celebrazioni e cene aziendali, fino a dodici ospiti." fr="Un espace dédié aux célébrations et dîners d'affaires, jusqu'à douze personnes." es="Un espacio para celebraciones y cenas de empresa, hasta doce personas." /></article><article class="lume-card"><span>03</span><T as="h3" en="Cellar pairing" it="Percorso in cantina" fr="Accord de cave" es="Maridaje de bodega" /><T as="p" en="Italian labels, small producers, and a pairing designed around your menu." it="Etichette italiane, piccoli produttori e un abbinamento costruito sul menu." fr="Étiquettes italiennes, petits producteurs et accord pensé autour du menu." es="Etiquetas italianas, pequeños productores y un maridaje diseñado para tu menú." /></article></div></section>
</ShowcaseShell>
