---
import ShowcaseShell from '../../../layouts/ShowcaseShell.astro';
import T from '../../../components/showcase/ShowcaseText.astro';
import { lumeNav, lumeCta } from '../../../data/showcaseNavigation';
---
<ShowcaseShell title="Lume Ristorante — Contemporary Italian Dining" description="A complete multilingual restaurant website concept by RxN Developing." brand="Lume" variant="lume" home="/showcase/lume-ristorante/" nav={lumeNav} cta={lumeCta}>
  <section class="lume-hero"><img src="/assets/showcases/lume/interior.jpg" alt="Contemporary restaurant dining room" /><div class="lume-hero__copy"><T class="lume-kicker" en="Contemporary Italian cuisine · Rome" it="Cucina italiana contemporanea · Roma" fr="Cuisine italienne contemporaine · Rome" es="Cocina italiana contemporánea · Roma" /><T as="h1" en="Matter, illuminated." it="La materia, illuminata." fr="La matière, éclairée." es="La materia, iluminada." /><div class="lume-buttons"><a class="lume-button lume-button--solid" href="/showcase/lume-ristorante/reservations/"><T en="Reserve a table" it="Prenota un tavolo" fr="Réserver une table" es="Reservar una mesa" /></a><a class="lume-button" href="/showcase/lume-ristorante/menu/"><T en="Explore the menu" it="Esplora il menu" fr="Découvrir le menu" es="Explorar el menú" /></a></div></div></section>
  <section class="lume-intro"><T class="lume-kicker" en="01 · Our philosophy" it="01 · La nostra filosofia" fr="01 · Notre philosophie" es="01 · Nuestra filosofía" /><div class="lume-intro__copy"><T as="h2" en="Italian seasons, reduced to their essence." it="Le stagioni italiane, ridotte alla loro essenza." fr="Les saisons italiennes, réduites à leur essence." es="Las estaciones italianas, reducidas a su esencia." /><T as="p" en="Lume connects independent producers, precise technique, and quiet hospitality. Every course preserves the identity of its ingredients while creating a dining rhythm that feels personal." it="Lume unisce piccoli produttori, tecnica precisa e un'ospitalità discreta. Ogni portata conserva l'identità degli ingredienti e costruisce un ritmo personale." fr="Lume réunit producteurs indépendants, technique précise et hospitalité discrète. Chaque assiette préserve l'identité de ses ingrédients et crée un rythme personnel." es="Lume une productores independientes, técnica precisa y una hospitalidad serena. Cada plato conserva la identidad de sus ingredientes y crea un ritmo personal." /><div class="lume-facts"><div><strong>28</strong><T en="seats" it="coperti" fr="couverts" es="plazas" /></div><div><strong>95€</strong><T en="tasting route" it="percorso degustazione" fr="menu dégustation" es="menú degustación" /></div><div><strong>4</strong><T en="seasonal menus" it="menu stagionali" fr="menus saisonniers" es="menús de temporada" /></div></div></div></section>
  <section class="lume-feature"><div><img src="/assets/showcases/lume/dining-room.jpg" alt="Lume dining experience" /></div><div class="lume-feature__copy"><T class="lume-kicker" en="An evening at Lume" it="Una sera da Lume" fr="Une soirée chez Lume" es="Una noche en Lume" /><T as="h2" en="Time, attention, hospitality." it="Tempo, attenzione, ospitalità." fr="Temps, attention, hospitalité." es="Tiempo, atención, hospitalidad." /><T as="p" en="Explore the room, the cellar, private dining, and the complete tasting experience before choosing the table that fits your evening." it="Scopri la sala, la cantina, gli eventi privati e il percorso degustazione completo prima di scegliere il tavolo adatto alla tua serata." fr="Découvrez la salle, la cave, les événements privés et le parcours dégustation avant de choisir la table idéale." es="Descubre la sala, la bodega, los eventos privados y la experiencia de degustación antes de elegir tu mesa." /><a class="lume-button" href="/showcase/lume-ristorante/experience/"><T en="Discover the experience →" it="Scopri l'esperienza →" fr="Découvrir l'expérience →" es="Descubrir la experiencia →" /></a></div></section>
</ShowcaseShell>
