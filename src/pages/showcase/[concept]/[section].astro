---
import AdvancedConceptPage from '../../../components/showcase/AdvancedConceptPage.astro';
import { advancedShowcases, type AdvancedConcept } from '../../../data/advancedShowcases';
export function getStaticPaths(){ return advancedShowcases.flatMap((concept)=>concept.pages.map((page)=>({params:{concept:concept.slug,section:page.slug},props:{concept,section:page.slug}}))); }
interface Props { concept: AdvancedConcept; section: string }
const { concept, section } = Astro.props;
---
<AdvancedConceptPage concept={concept} section={section} />
