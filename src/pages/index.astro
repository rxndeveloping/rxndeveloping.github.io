---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import EmptyProjects from '../components/projects/EmptyProjects.astro';
import TeamCard from '../components/team/TeamCard.astro';
import site from '../data/site.json';
import team from '../data/team.json';
import skills from '../data/skills.json';
import { assetPath, sitePath } from '../utils/paths';

const projects = (await getCollection('projects', ({ data }) => !data.draft));
const featured = projects
  .filter(({ data }) => data.featured && data.portfolioType === 'software')
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999))
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-grid container">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span><span data-i18n="home.hero.eyebrow">{site.eyebrow}</span></p>
        <h1 data-i18n="home.hero.title" data-i18n-html>Software, systems, and websites built for <em>real use.</em></h1>
        <p class="hero-lead" data-i18n="home.hero.lead">RxN Developing is the independent team of Ryze and Ninja. We create custom software, automation, community tools, gaming systems, and websites for businesses.</p>
        <div class="hero-actions">
          <a class="button button--primary" href={sitePath('projects/')}><span data-i18n="home.hero.projects">Explore portfolio</span><span aria-hidden="true">↗</span></a>
          <a class="button button--ghost" href={sitePath('about/')} data-i18n="home.hero.team">Meet the team</a>
        </div>
      </div>
      <div class="hero-visual reveal" aria-label="RxN Developing identity">
        <div class="hero-logo-simple">
          <img src={assetPath('assets/brand/logo.png')} alt="RxN Developing" width="1536" height="1024" />
        </div>
        <p class="hero-visual__caption"><span>Ryze + Ninja</span><span data-i18n="home.hero.identity">Independent development team</span></p>
      </div>
    </div>
  </section>

  <section class="section portfolio-paths-section">
    <div class="container portfolio-paths">
      <a href={sitePath('projects/#software')} class="portfolio-path reveal">
        <span>01</span><p class="mono-label" data-i18n="home.paths.softwareLabel">Software portfolio</p><h2 data-i18n="portfolio.software.title">Software & systems</h2><p data-i18n="home.paths.softwareText">Applications, bots, automation, gaming tools, and custom digital systems.</p><strong data-i18n="home.paths.explore">Explore work →</strong>
      </a>
      <a href={sitePath('projects/#websites')} class="portfolio-path portfolio-path--web reveal">
        <span>02</span><p class="mono-label" data-i18n="home.paths.webLabel">Web portfolio</p><h2 data-i18n="portfolio.web.title">Website development</h2><p data-i18n="home.paths.webText">Distinctive, responsive websites for restaurants, companies, professionals, and services.</p><strong data-i18n="home.paths.discover">Explore our websites →</strong>
      </a>
    </div>
  </section>

  <section class="section projects-preview">
    <div class="container">
      <div class="section-topline">
      <SectionHeading eyebrow="Selected software" title="Technical projects built with intent." description="A growing archive of tools, systems, and experiments created by RxN Developing." eyebrowKey="home.selected.eyebrow" titleKey="home.selected.title" descriptionKey="home.selected.description" />
        <a class="text-link" href={sitePath('projects/')}><span data-i18n="home.selected.all">View all projects</span><span aria-hidden="true">→</span></a>
      </div>
      {featured.length > 0
        ? <div class="project-grid">{featured.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
        : <EmptyProjects />}
    </div>
  </section>

  <section class="section skills-section">
    <div class="container split-heading">
      <SectionHeading eyebrow="Capabilities" title="Built across software, websites, communities, and games." eyebrowKey="home.capabilities.eyebrow" titleKey="home.capabilities.title" />
      <p data-i18n="home.capabilities.text">We combine practical development with experimentation, designing solutions that stay useful, adaptable, and clear.</p>
    </div>
    <div class="container capability-grid">
      {skills.areas.map((skill, index) => (
        <article class="capability-card reveal" style={`--delay:${index * 40}ms`}>
          <h3 data-i18n={`skills.area.${index}.title`}>{skill.title}</h3>
          <p data-i18n={`skills.area.${index}.description`}>{skill.description}</p>
        </article>
      ))}
    </div>
    <div class="container language-strip" aria-label="Primary languages">
      <span class="mono-label" data-i18n="home.stack">Primary stack</span>
      <ul>{skills.languages.map((language) => <li>{language}</li>)}</ul>
    </div>
  </section>

  <section class="section team-preview">
    <div class="container">
      <SectionHeading eyebrow="The team" title="Two perspectives. One shared direction." description="RxN Developing brings development, testing, design, and technical problem-solving into one focused team." eyebrowKey="home.team.eyebrow" titleKey="home.team.title" descriptionKey="home.team.description" />
      <div class="team-grid">
        {team.map((member) => <TeamCard member={member} compact />)}
      </div>
      <div class="section-cta"><a class="button button--ghost" href={sitePath('about/')} data-i18n="home.team.more">More about RxN Developing →</a></div>
    </div>
  </section>

  <section class="contact-band">
    <div class="container contact-band__inner">
      <div><p class="eyebrow"><span></span><span data-i18n="home.contact.eyebrow">Start a conversation</span></p><h2 data-i18n="home.contact.title">Have an idea worth building?</h2></div>
      <a class="button button--light" href={sitePath('contact/')} data-i18n="home.contact.button">Get in touch ↗</a>
    </div>
  </section>
</BaseLayout>
