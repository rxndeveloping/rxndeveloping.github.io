---
import BaseLayout from '../layouts/BaseLayout.astro';
import skills from '../data/skills.json';
import { sitePath } from '../utils/paths';

if (!import.meta.env.DEV) {
  return Astro.redirect('/404/');
}
---

<BaseLayout title="Project Studio" description="Create and save RxN Developing project entries locally." noindex>
  <section class="studio-page">
    <div class="container studio-heading">
      <div>
        <p class="eyebrow"><span></span>Local publishing tool</p>
        <h1>Project Studio</h1>
      </div>
      <p>Compile a project without editing the layout. Your files stay on your computer and are written only after you choose the website folder.</p>
    </div>

    <form class="container studio-form" data-project-form>
      <div class="studio-editing" data-editing-banner hidden>
        <div><span class="mono-label">Editing project</span><strong data-editing-title></strong></div>
        <button class="button button--ghost" type="button" data-cancel-edit>Start a new project</button>
      </div>
      <section class="studio-section">
        <div class="studio-section__heading"><span>01</span><div><h2>Project basics</h2><p>Only the title and short description are required.</p></div></div>
        <div class="form-grid">
          <label class="field field--wide"><span>Project title *</span><input name="title" required autocomplete="off" placeholder="Project title" /></label>
          <label class="field"><span>URL slug *</span><input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="project-title" /></label>
          <label class="field"><span>Portfolio section</span><select name="portfolioType"><option value="software">Software & systems</option><option value="website">Website development</option></select></label>
          <label class="field"><span>Position in portfolio</span><input type="number" name="portfolioOrder" min="1" step="1" placeholder="1 = first" /></label>
          <label class="field"><span>Category</span><input name="category" placeholder="Software, Gaming, Automation…" /></label>
          <label class="field"><span>Status</span><input name="status" placeholder="Completed, In development…" /></label>
          <label class="field"><span>Development period</span><input name="developmentPeriod" placeholder="2026 or Jan–Mar 2026" /></label>
          <label class="field field--wide"><span>Short description *</span><textarea name="shortDescription" rows="3" required placeholder="A concise summary for the project card."></textarea></label>
          <label class="field field--wide"><span>Full description</span><textarea name="description" rows="8" placeholder="Describe the purpose, process, important decisions, and outcome."></textarea></label>
          <label class="field field--wide"><span>Systems or features developed</span><textarea name="systems" rows="5" placeholder="One item per line"></textarea></label>
        </div>
      </section>

      <details class="studio-section studio-translations">
        <summary><span>Translations</span><small>Optional project content for Italian, French, and Spanish</small></summary>
        <p class="studio-translations__help">The project title and technology names stay unchanged. Empty translated fields automatically fall back to English.</p>
        {[
          { code: 'it', label: 'Italian' },
          { code: 'fr', label: 'French' },
          { code: 'es', label: 'Spanish' }
        ].map(({ code, label }) => (
          <fieldset class="translation-editor">
            <legend>{label}</legend>
            <div class="form-grid">
              <label class="field"><span>Category</span><input name={`${code}Category`} /></label>
              <label class="field"><span>Status</span><input name={`${code}Status`} /></label>
              <label class="field field--wide"><span>Short description</span><textarea name={`${code}ShortDescription`} rows="3"></textarea></label>
              <label class="field field--wide"><span>Full description</span><textarea name={`${code}Description`} rows="6"></textarea></label>
              <label class="field field--wide"><span>Systems or features — one per line, in the same order as English</span><textarea name={`${code}Systems`} rows="5"></textarea></label>
              <label class="field"><span>Ryze’s role</span><textarea name={`${code}RoleRyze`} rows="3"></textarea></label>
              <label class="field"><span>Ninja’s role</span><textarea name={`${code}RoleNinja`} rows="3"></textarea></label>
            </div>
          </fieldset>
        ))}
      </details>

      <section class="studio-section">
        <div class="studio-section__heading"><span>02</span><div><h2>Technologies and team</h2><p>Select the primary languages and describe who worked on the project. Entering a role automatically includes that member.</p></div></div>
        <fieldset class="choice-fieldset">
          <legend>Technologies</legend>
          <div class="choice-grid">
            {skills.languages.map((language) => <label class="choice"><input type="checkbox" name="technologies" value={language} /><span>{language}</span></label>)}
          </div>
          <label class="field field--inline"><span>Other technologies</span><input name="otherTechnologies" placeholder="Unity, JSON, APIs… separated by commas" /></label>
        </fieldset>
        <div class="contributor-editor">
          <label class="contributor-option"><input type="checkbox" name="memberRyze" /><span>Ryze</span></label>
          <label class="field"><span>Ryze’s role</span><input name="roleRyze" placeholder="Lead development, UI design…" /></label>
          <label class="contributor-option"><input type="checkbox" name="memberNinja" /><span>Ninja</span></label>
          <label class="field"><span>Ninja’s role</span><input name="roleNinja" placeholder="Development, testing…" /></label>
        </div>
      </section>

      <section class="studio-section">
        <div class="studio-section__heading"><span>03</span><div><h2>Images and video</h2><p>Files are copied and renamed automatically when you save the project.</p></div></div>
        <div class="studio-existing-media" data-existing-media hidden>
          <div>
            <span class="mono-label">Media already saved</span>
            <p>These files will be kept automatically. Select a file below only when you want to add or replace something.</p>
          </div>
          <div class="studio-existing-media__grid" data-existing-media-grid></div>
        </div>
        <div class="form-grid">
          <label class="field"><span>Cover image <small data-cover-help></small></span><input type="file" name="cover" accept="image/*" /></label>
          <label class="field"><span>Cover alt text</span><input name="coverAlt" placeholder="Describe the cover image" /></label>
          <label class="field field--wide"><span>New gallery images <small data-gallery-help></small></span><input type="file" name="gallery" accept="image/*" multiple data-gallery-input /></label>
          <div class="studio-new-gallery field--wide" data-new-gallery-grid hidden></div>
          <label class="choice field--wide" data-replace-gallery-option hidden><input type="checkbox" name="replaceGallery" /><span>Replace the complete existing gallery with the newly selected images</span></label>
          <label class="field"><span>Video type</span><select name="videoType"><option value="">No video</option><option value="youtube">YouTube</option><option value="vimeo">Vimeo</option><option value="local">Local MP4 / WebM</option></select></label>
          <label class="field"><span>Video title</span><input name="videoTitle" placeholder="Project demonstration" /></label>
          <label class="field field--wide" data-external-video><span>YouTube/Vimeo URL or ID</span><input name="videoUrl" placeholder="https://…" /></label>
          <label class="field field--wide" data-local-video hidden><span>Local video files</span><input type="file" name="localVideos" accept="video/mp4,video/webm" multiple /></label>
          <label class="field field--wide"><span>Video poster</span><input type="file" name="videoPoster" accept="image/*" /></label>
        </div>
      </section>

      <section class="studio-section">
        <div class="studio-section__heading"><span>04</span><div><h2>Links and publishing</h2><p>All links are optional. Project repository links remain independent from team contacts.</p></div></div>
        <div class="form-grid">
          <label class="field"><span>GitHub repository</span><input type="url" name="github" placeholder="https://github.com/…" /></label>
          <label class="field"><span>Live demo</span><input type="url" name="demo" placeholder="https://…" /></label>
          <label class="field"><span>Download</span><input type="url" name="download" placeholder="https://…" /></label>
          <div class="publish-options">
            <label class="choice"><input type="checkbox" name="featured" /><span>Featured on Home</span></label>
            <label class="choice"><input type="checkbox" name="draft" /><span>Keep as draft</span></label>
          </div>
          <label class="field"><span>Position among featured projects</span><input type="number" name="featuredOrder" min="1" step="1" placeholder="1 = first" /></label>
        </div>
      </section>

      <div class="studio-actions">
        <button class="button button--primary" type="submit" data-save-project>Choose website folder & save</button>
        <button class="button button--ghost" type="button" data-download-markdown>Download Markdown only</button>
        <a class="text-link" href={sitePath('projects/')}>Back to projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="studio-status" role="status" aria-live="polite" data-studio-status></div>
    </form>

    <section class="container studio-manager" data-project-manager>
      <div class="studio-manager__intro">
        <p class="eyebrow">Manage projects</p>
        <h2>Edit or remove an existing project</h2>
        <p>Select the website folder once, then load a project into the form or remove it. Existing media is preserved unless you select replacement files.</p>
      </div>
      <div class="studio-manager__controls">
        <button class="button button--ghost" type="button" data-load-projects>Choose website folder</button>
        <label class="field"><span>Project</span><select data-project-select disabled><option value="">Choose the website folder first</option></select></label>
        <button class="button button--primary" type="button" data-edit-project disabled>Load selected project for editing</button>
        <label class="choice"><input type="checkbox" data-delete-media checked /><span>Also remove project images and videos</span></label>
        <button class="button studio-delete" type="button" data-delete-project disabled>Delete selected project</button>
        <div class="studio-status" role="status" aria-live="polite" data-manager-status></div>
      </div>
    </section>

    <aside class="container studio-help">
      <h2>After saving</h2>
      <ol>
        <li>Run <code>pnpm build</code> to check the project.</li>
        <li>Run <code>pnpm dev</code> and inspect the new card and detail page.</li>
        <li>Commit and push the changes to publish them with GitHub Pages.</li>
      </ol>
      <p>Direct saving works in current Chrome and Edge on localhost or HTTPS. The browser will always ask which folder you want to grant access to.</p>
    </aside>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-project-form]');
  const status = document.querySelector<HTMLElement>('[data-studio-status]');
  const downloadButton = document.querySelector<HTMLButtonElement>('[data-download-markdown]');
  const videoType = form?.elements.namedItem('videoType') as HTMLSelectElement | null;
  const titleInput = form?.elements.namedItem('title') as HTMLInputElement | null;
  const slugInput = form?.elements.namedItem('slug') as HTMLInputElement | null;
  const externalVideo = document.querySelector<HTMLElement>('[data-external-video]');
  const localVideo = document.querySelector<HTMLElement>('[data-local-video]');
  const loadProjectsButton = document.querySelector<HTMLButtonElement>('[data-load-projects]');
  const projectSelect = document.querySelector<HTMLSelectElement>('[data-project-select]');
  const editProjectButton = document.querySelector<HTMLButtonElement>('[data-edit-project]');
  const deleteProjectButton = document.querySelector<HTMLButtonElement>('[data-delete-project]');
  const deleteMediaInput = document.querySelector<HTMLInputElement>('[data-delete-media]');
  const managerStatus = document.querySelector<HTMLElement>('[data-manager-status]');
  const editingBanner = document.querySelector<HTMLElement>('[data-editing-banner]');
  const editingTitle = document.querySelector<HTMLElement>('[data-editing-title]');
  const cancelEditButton = document.querySelector<HTMLButtonElement>('[data-cancel-edit]');
  const saveProjectButton = document.querySelector<HTMLButtonElement>('[data-save-project]');
  const existingMediaPanel = document.querySelector<HTMLElement>('[data-existing-media]');
  const existingMediaGrid = document.querySelector<HTMLElement>('[data-existing-media-grid]');
  const replaceGalleryOption = document.querySelector<HTMLElement>('[data-replace-gallery-option]');
  const coverHelp = document.querySelector<HTMLElement>('[data-cover-help]');
  const galleryHelp = document.querySelector<HTMLElement>('[data-gallery-help]');
  const galleryInput = document.querySelector<HTMLInputElement>('[data-gallery-input]');
  const newGalleryGrid = document.querySelector<HTMLElement>('[data-new-gallery-grid]');
  const ryzeRoleInput = form?.elements.namedItem('roleRyze') as HTMLInputElement | null;
  const ninjaRoleInput = form?.elements.namedItem('roleNinja') as HTMLInputElement | null;
  const ryzeMemberInput = form?.elements.namedItem('memberRyze') as HTMLInputElement | null;
  const ninjaMemberInput = form?.elements.namedItem('memberNinja') as HTMLInputElement | null;
  let managerRoot: any = null;
  type ProjectImage = { src: string; alt: string; caption?: string; position?: string };
  type ProjectVideo = { type: string; title: string; url?: string; poster?: string; mp4?: string; webm?: string; caption?: string };
  type ProjectTranslation = { language: 'it' | 'fr' | 'es'; shortDescription?: string; description?: string; category?: string; status?: string; systems: string[]; roleRyze?: string; roleNinja?: string };
  type ParsedProject = {
    title: string; slug: string; portfolioType: 'software' | 'website'; portfolioOrder?: number; featuredOrder?: number; shortDescription: string; description: string;
    category?: string; status?: string; developmentPeriod?: string;
    technologies: string[]; systems: string[];
    contributors: Array<{ member: string; role: string }>;
    cover?: ProjectImage; gallery: ProjectImage[]; videos: ProjectVideo[];
    links: Record<string, string>; translations: ProjectTranslation[]; featured: boolean; draft: boolean;
  };
  type ManagedProject = { file: string; slug: string; title: string; text: string; data: ParsedProject };
  let managedProjects: ManagedProject[] = [];
  let editingProject: ManagedProject | null = null;
  let pendingGalleryFiles: File[] = [];
  let pendingPreviewUrls: string[] = [];

  const slugify = (value: string) => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const quote = (value: string) => JSON.stringify(value);
  const extension = (file: File) => file.name.toLowerCase().match(/\.[a-z0-9]+$/)?.[0] || '';
  const lines = (value: FormDataEntryValue | null) => String(value || '').split(/\r?\n/).map((item) => item.trim()).filter(Boolean);

  const parseValue = (value = '') => {
    const trimmed = value.trim();
    if (!trimmed) return '';
    if (trimmed === 'true') return true;
    if (trimmed === 'false') return false;
    if (/^-?\d+(?:\.\d+)?$/.test(trimmed)) return Number(trimmed);
    if (trimmed.startsWith('"') || trimmed.startsWith('[') || trimmed.startsWith('{')) {
      try { return JSON.parse(trimmed); } catch { return trimmed.slice(1, -1); }
    }
    return trimmed.replace(/^['"]|['"]$/g, '');
  };

  function parseProjectFile(text: string, file: string): ManagedProject {
    const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    if (!match) throw new Error(`${file} does not contain valid project frontmatter.`);
    const header = match[1].split(/\r?\n/);
    const scalar = (key: string) => {
      const line = header.find((item) => item.startsWith(`${key}:`));
      return line ? parseValue(line.slice(key.length + 1)) : '';
    };
    const simpleList = (key: string) => {
      const start = header.findIndex((item) => item === `${key}:`);
      const values: string[] = [];
      if (start < 0) return values;
      for (let index = start + 1; index < header.length; index += 1) {
        const line = header[index];
        if (!line.startsWith('  ')) break;
        const item = line.match(/^  -\s+(.+)$/);
        if (item) values.push(String(parseValue(item[1])));
      }
      return values;
    };
    const objectSection = (key: string) => {
      const start = header.findIndex((item) => item === `${key}:`);
      const value: Record<string, string> = {};
      if (start < 0) return value;
      for (let index = start + 1; index < header.length; index += 1) {
        const line = header[index];
        if (!line.startsWith('  ') || line.startsWith('  -')) break;
        const entry = line.match(/^  ([A-Za-z][A-Za-z0-9]*):\s*(.*)$/);
        if (entry) value[entry[1]] = String(parseValue(entry[2]));
      }
      return value;
    };
    const objectList = (key: string) => {
      const start = header.findIndex((item) => item === `${key}:`);
      const values: Array<Record<string, unknown>> = [];
      let current: Record<string, unknown> | null = null;
      if (start < 0) return values;
      for (let index = start + 1; index < header.length; index += 1) {
        const line = header[index];
        if (!line.startsWith('  ')) break;
        const first = line.match(/^  -\s+([A-Za-z][A-Za-z0-9]*):\s*(.*)$/);
        const next = line.match(/^    ([A-Za-z][A-Za-z0-9]*):\s*(.*)$/);
        if (first) {
          current = { [first[1]]: parseValue(first[2]) };
          values.push(current);
        } else if (next && current) current[next[1]] = parseValue(next[2]);
      }
      return values;
    };
    const cover = objectSection('cover');
    const data: ParsedProject = {
      title: String(scalar('title') || file.replace(/\.md$/, '')),
      slug: String(scalar('slug') || file.replace(/\.md$/, '')),
      portfolioType: scalar('portfolioType') === 'website' ? 'website' : 'software',
      portfolioOrder: typeof scalar('portfolioOrder') === 'number' ? Number(scalar('portfolioOrder')) : undefined,
      featuredOrder: typeof scalar('featuredOrder') === 'number' ? Number(scalar('featuredOrder')) : undefined,
      shortDescription: String(scalar('shortDescription')),
      description: match[2].trim(),
      category: String(scalar('category') || ''),
      status: String(scalar('status') || ''),
      developmentPeriod: String(scalar('developmentPeriod') || ''),
      technologies: simpleList('technologies'),
      systems: simpleList('systems'),
      contributors: objectList('contributors') as Array<{ member: string; role: string }>,
      cover: cover.src ? cover as ProjectImage : undefined,
      gallery: objectList('gallery') as ProjectImage[],
      videos: objectList('videos') as ProjectVideo[],
      links: objectSection('links'),
      translations: objectList('translations').map((item) => ({
        language: item.language as 'it' | 'fr' | 'es',
        shortDescription: String(item.shortDescription || ''),
        description: String(item.description || ''),
        category: String(item.category || ''),
        status: String(item.status || ''),
        systems: Array.isArray(item.systems) ? item.systems.map(String) : [],
        roleRyze: String(item.roleRyze || ''),
        roleNinja: String(item.roleNinja || '')
      })),
      featured: scalar('featured') === true,
      draft: scalar('draft') === true
    };
    return { file, slug: data.slug, title: data.title, text, data };
  }

  function setStatus(message: string, type: 'success' | 'error' | 'info' = 'info') {
    if (!status) return;
    status.textContent = message;
    status.dataset.type = type;
  }

  function updateVideoFields() {
    const type = videoType?.value;
    if (externalVideo) externalVideo.hidden = !type || type === 'local';
    if (localVideo) localVideo.hidden = type !== 'local';
  }
  videoType?.addEventListener('change', updateVideoFields);
  updateVideoFields();

  function moveItem<T>(items: T[], index: number, direction: -1 | 1) {
    const target = index + direction;
    if (target < 0 || target >= items.length) return;
    [items[index], items[target]] = [items[target], items[index]];
  }

  function orderButtons(onMove: (direction: -1 | 1) => void, index: number, length: number) {
    const controls = document.createElement('div');
    controls.className = 'studio-media-order';
    const previous = document.createElement('button');
    const next = document.createElement('button');
    previous.type = next.type = 'button';
    previous.textContent = '←';
    next.textContent = '→';
    previous.title = 'Move image earlier';
    next.title = 'Move image later';
    previous.disabled = index === 0;
    next.disabled = index === length - 1;
    previous.addEventListener('click', () => onMove(-1));
    next.addEventListener('click', () => onMove(1));
    controls.append(previous, next);
    return controls;
  }

  function renderExistingMedia() {
    if (!existingMediaGrid || !editingProject) return;
    existingMediaGrid.replaceChildren();
    const cover = editingProject.data.cover;
    if (cover) {
      const figure = document.createElement('figure');
      const image = document.createElement('img');
      const caption = document.createElement('figcaption');
      image.src = `/${cover.src.replace(/^\//, '')}`;
      image.alt = cover.alt;
      caption.textContent = 'Current cover';
      figure.append(image, caption);
      existingMediaGrid.append(figure);
    }
    editingProject.data.gallery.forEach((item, index) => {
      const figure = document.createElement('figure');
      const image = document.createElement('img');
      const caption = document.createElement('figcaption');
      image.src = `/${item.src.replace(/^\//, '')}`;
      image.alt = item.alt || `Gallery ${index + 1}`;
      image.loading = 'lazy';
      caption.textContent = `Gallery ${index + 1}`;
      figure.append(image, caption, orderButtons((direction) => {
        moveItem(editingProject!.data.gallery, index, direction);
        renderExistingMedia();
      }, index, editingProject!.data.gallery.length));
      existingMediaGrid.append(figure);
    });
  }

  function renderPendingGallery() {
    pendingPreviewUrls.forEach((url) => URL.revokeObjectURL(url));
    pendingPreviewUrls = [];
    if (!newGalleryGrid) return;
    newGalleryGrid.replaceChildren();
    newGalleryGrid.hidden = !pendingGalleryFiles.length;
    pendingGalleryFiles.forEach((file, index) => {
      const figure = document.createElement('figure');
      const image = document.createElement('img');
      const caption = document.createElement('figcaption');
      const url = URL.createObjectURL(file);
      pendingPreviewUrls.push(url);
      image.src = url;
      image.alt = file.name;
      caption.textContent = `${index + 1}. ${file.name}`;
      figure.append(image, caption, orderButtons((direction) => {
        moveItem(pendingGalleryFiles, index, direction);
        renderPendingGallery();
      }, index, pendingGalleryFiles.length));
      newGalleryGrid.append(figure);
    });
  }

  galleryInput?.addEventListener('change', () => {
    pendingGalleryFiles = [...(galleryInput.files || [])];
    renderPendingGallery();
  });

  titleInput?.addEventListener('input', () => {
    if (slugInput && !slugInput.dataset.edited) slugInput.value = slugify(titleInput.value);
  });
  slugInput?.addEventListener('input', () => {
    slugInput.dataset.edited = slugInput.value ? 'true' : '';
    slugInput.value = slugify(slugInput.value);
  });
  ryzeRoleInput?.addEventListener('input', () => {
    if (ryzeMemberInput && ryzeRoleInput.value.trim()) ryzeMemberInput.checked = true;
  });
  ninjaRoleInput?.addEventListener('input', () => {
    if (ninjaMemberInput && ninjaRoleInput.value.trim()) ninjaMemberInput.checked = true;
  });

  function projectData() {
    if (!form) throw new Error('Project form is unavailable.');
    const data = new FormData(form);
    const slug = slugify(String(data.get('slug') || data.get('title') || ''));
    const cover = (data.get('cover') as File);
    const gallery = [...pendingGalleryFiles];
    const poster = data.get('videoPoster') as File;
    const localVideos = [...((form.elements.namedItem('localVideos') as HTMLInputElement).files || [])];
    const selectedTech = data.getAll('technologies').map(String);
    const otherTech = String(data.get('otherTechnologies') || '').split(',').map((item) => item.trim()).filter(Boolean);
    const technologies = [...new Set([...selectedTech, ...otherTech])];

    const output: string[] = ['---'];
    output.push(`title: ${quote(String(data.get('title') || ''))}`);
    output.push(`slug: ${quote(slug)}`);
    output.push(`portfolioType: ${quote(String(data.get('portfolioType') || 'software'))}`);
    const portfolioOrder = String(data.get('portfolioOrder') || '').trim();
    if (portfolioOrder) output.push(`portfolioOrder: ${Number(portfolioOrder)}`);
    output.push(`shortDescription: ${quote(String(data.get('shortDescription') || ''))}`);
    for (const key of ['category', 'status', 'developmentPeriod']) {
      const value = String(data.get(key) || '').trim();
      if (value) output.push(`${key}: ${quote(value)}`);
    }
    if (technologies.length) {
      output.push('technologies:');
      technologies.forEach((item) => output.push(`  - ${quote(item)}`));
    }
    const systems = lines(data.get('systems'));
    if (systems.length) {
      output.push('systems:');
      systems.forEach((item) => output.push(`  - ${quote(item)}`));
    }
    const contributors: Array<{ member: string; role: string }> = [];
    const roleRyze = String(data.get('roleRyze') || '').trim();
    const roleNinja = String(data.get('roleNinja') || '').trim();
    if (data.get('memberRyze') || roleRyze) contributors.push({ member: 'ryze', role: roleRyze || 'Development' });
    if (data.get('memberNinja') || roleNinja) contributors.push({ member: 'ninja', role: roleNinja || 'Development' });
    if (contributors.length) {
      output.push('contributors:');
      contributors.forEach((item) => { output.push(`  - member: ${quote(item.member)}`); output.push(`    role: ${quote(item.role)}`); });
    }
    const projectTranslations = (['it', 'fr', 'es'] as const).map((language) => {
      const prefix = language;
      return {
        language,
        category: String(data.get(`${prefix}Category`) || '').trim(),
        status: String(data.get(`${prefix}Status`) || '').trim(),
        shortDescription: String(data.get(`${prefix}ShortDescription`) || '').trim(),
        description: String(data.get(`${prefix}Description`) || '').trim(),
        systems: lines(data.get(`${prefix}Systems`)),
        roleRyze: String(data.get(`${prefix}RoleRyze`) || '').trim(),
        roleNinja: String(data.get(`${prefix}RoleNinja`) || '').trim()
      };
    }).filter((item) => item.category || item.status || item.shortDescription || item.description || item.systems.length || item.roleRyze || item.roleNinja);
    if (projectTranslations.length) {
      output.push('translations:');
      projectTranslations.forEach((item) => {
        output.push(`  - language: ${quote(item.language)}`);
        for (const key of ['category', 'status', 'shortDescription', 'description', 'roleRyze', 'roleNinja'] as const) {
          if (item[key]) output.push(`    ${key}: ${quote(item[key])}`);
        }
        if (item.systems.length) output.push(`    systems: ${JSON.stringify(item.systems)}`);
      });
    }
    const files: Array<{ file: File; name: string }> = [];
    const existing = editingProject?.data;
    const coverAlt = String(data.get('coverAlt') || existing?.cover?.alt || `${data.get('title')} project cover`);
    if (cover?.size) {
      const name = `cover${extension(cover)}`;
      files.push({ file: cover, name });
      output.push('cover:');
      output.push(`  src: ${quote(`assets/projects/${slug}/${name}`)}`);
      output.push(`  alt: ${quote(coverAlt)}`);
    } else if (existing?.cover) {
      output.push('cover:');
      output.push(`  src: ${quote(existing.cover.src)}`);
      output.push(`  alt: ${quote(coverAlt)}`);
      if (existing.cover.caption) output.push(`  caption: ${quote(existing.cover.caption)}`);
      if (existing.cover.position) output.push(`  position: ${quote(existing.cover.position)}`);
    }
    const replaceGallery = Boolean(data.get('replaceGallery'));
    if (gallery.length && (!existing?.gallery.length || replaceGallery)) {
      output.push('gallery:');
      gallery.forEach((file, index) => {
        const name = `image-${String(index + 1).padStart(2, '0')}${extension(file)}`;
        files.push({ file, name });
        output.push(`  - src: ${quote(`assets/projects/${slug}/${name}`)}`);
        output.push(`    alt: ${quote(`${data.get('title')} screenshot ${index + 1}`)}`);
      });
    } else if (existing?.gallery.length) {
      output.push('gallery:');
      existing.gallery.forEach((image) => {
        output.push(`  - src: ${quote(image.src)}`);
        output.push(`    alt: ${quote(image.alt)}`);
        if (image.caption) output.push(`    caption: ${quote(image.caption)}`);
        if (image.position) output.push(`    position: ${quote(image.position)}`);
      });
      gallery.forEach((file, index) => {
        const number = existing.gallery.length + index + 1;
        const name = `image-${String(number).padStart(2, '0')}${extension(file)}`;
        files.push({ file, name });
        output.push(`  - src: ${quote(`assets/projects/${slug}/${name}`)}`);
        output.push(`    alt: ${quote(`${data.get('title')} screenshot ${number}`)}`);
      });
    }
    const type = String(data.get('videoType') || '');
    const videoTitle = String(data.get('videoTitle') || 'Project demonstration');
    const videoUrl = String(data.get('videoUrl') || '').trim();
    const existingVideo = existing?.videos[0];
    if ((type === 'youtube' || type === 'vimeo') && videoUrl) {
      output.push('videos:');
      output.push(`  - type: ${quote(type)}`);
      output.push(`    url: ${quote(videoUrl)}`);
      output.push(`    title: ${quote(videoTitle)}`);
      if (poster?.size) {
        const name = `video-poster${extension(poster)}`;
        files.push({ file: poster, name });
        output.push(`    poster: ${quote(`assets/projects/${slug}/${name}`)}`);
      } else if (existingVideo?.poster) output.push(`    poster: ${quote(existingVideo.poster)}`);
      if (existingVideo?.caption) output.push(`    caption: ${quote(existingVideo.caption)}`);
    } else if (type === 'local' && (localVideos.length || existingVideo?.type === 'local')) {
      output.push('videos:');
      output.push('  - type: "local"');
      output.push(`    title: ${quote(videoTitle)}`);
      if (localVideos.length) {
        localVideos.forEach((file) => {
          const ext = extension(file);
          const format = ext === '.webm' ? 'webm' : 'mp4';
          const name = `video${ext}`;
          files.push({ file, name });
          output.push(`    ${format}: ${quote(`assets/projects/${slug}/${name}`)}`);
        });
      } else {
        if (existingVideo?.mp4) output.push(`    mp4: ${quote(existingVideo.mp4)}`);
        if (existingVideo?.webm) output.push(`    webm: ${quote(existingVideo.webm)}`);
      }
      if (poster?.size) {
        const name = `video-poster${extension(poster)}`;
        files.push({ file: poster, name });
        output.push(`    poster: ${quote(`assets/projects/${slug}/${name}`)}`);
      } else if (existingVideo?.poster) output.push(`    poster: ${quote(existingVideo.poster)}`);
      if (existingVideo?.caption) output.push(`    caption: ${quote(existingVideo.caption)}`);
    }
    const links = ['github', 'demo', 'download'].map((key) => [key, String(data.get(key) || '').trim()] as const).filter(([, value]) => value);
    if (links.length) {
      output.push('links:');
      links.forEach(([key, value]) => output.push(`  ${key}: ${quote(value)}`));
    }
    output.push(`featured: ${data.get('featured') ? 'true' : 'false'}`);
    const featuredOrder = String(data.get('featuredOrder') || '').trim();
    if (featuredOrder) output.push(`featuredOrder: ${Number(featuredOrder)}`);
    output.push(`draft: ${data.get('draft') ? 'true' : 'false'}`);
    output.push('---', '', String(data.get('description') || '').trim(), '');
    return { slug, markdown: output.join('\n'), files };
  }

  async function nestedDirectory(root: any, parts: string[]) {
    let directory = root;
    for (const part of parts) directory = await directory.getDirectoryHandle(part, { create: true });
    return directory;
  }
  async function writeFile(directory: any, name: string, content: Blob | string) {
    const handle = await directory.getFileHandle(name, { create: true });
    const writable = await handle.createWritable();
    await writable.write(content);
    await writable.close();
  }

  async function verifyWebsiteRoot(root: any) {
    const packageFile = await root.getFileHandle('package.json');
    const packageText = await (await packageFile.getFile()).text();
    if (!packageText.includes('rxn-developing-website')) throw new Error('That is not the rxn-developing-website root folder.');
  }

  function setFormValue(name: string, value: string | number | boolean | undefined) {
    if (!form) return;
    const control = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
    if (!control) return;
    if (control instanceof HTMLInputElement && control.type === 'checkbox') control.checked = Boolean(value);
    else control.value = String(value ?? '');
  }

  function loadProjectIntoForm(project: ManagedProject) {
    if (!form) return;
    editingProject = project;
    form.reset();
    const data = project.data;
    pendingGalleryFiles = [];
    renderPendingGallery();
    for (const key of ['title', 'slug', 'portfolioType', 'portfolioOrder', 'featuredOrder', 'shortDescription', 'description', 'category', 'status', 'developmentPeriod'] as const) setFormValue(key, data[key]);
    setFormValue('systems', data.systems.join('\n'));
    const technologyInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="technologies"]')];
    const knownTechnologies = new Set(technologyInputs.map((input) => input.value));
    technologyInputs.forEach((input) => { input.checked = data.technologies.includes(input.value); });
    setFormValue('otherTechnologies', data.technologies.filter((item) => !knownTechnologies.has(item)).join(', '));
    const ryze = data.contributors.find((item) => item.member === 'ryze');
    const ninja = data.contributors.find((item) => item.member === 'ninja');
    setFormValue('memberRyze', Boolean(ryze));
    setFormValue('roleRyze', ryze?.role);
    setFormValue('memberNinja', Boolean(ninja));
    setFormValue('roleNinja', ninja?.role);
    setFormValue('coverAlt', data.cover?.alt);
    const video = data.videos[0];
    setFormValue('videoType', video?.type);
    setFormValue('videoTitle', video?.title);
    setFormValue('videoUrl', video?.url);
    setFormValue('github', data.links.github);
    setFormValue('demo', data.links.demo);
    setFormValue('download', data.links.download);
    setFormValue('featured', data.featured);
    setFormValue('draft', data.draft);
    (['it', 'fr', 'es'] as const).forEach((language) => {
      const translation = data.translations.find((item) => item.language === language);
      const prefix = language;
      setFormValue(`${prefix}Category`, translation?.category);
      setFormValue(`${prefix}Status`, translation?.status);
      setFormValue(`${prefix}ShortDescription`, translation?.shortDescription);
      setFormValue(`${prefix}Description`, translation?.description);
      setFormValue(`${prefix}Systems`, translation?.systems.join('\n'));
      setFormValue(`${prefix}RoleRyze`, translation?.roleRyze);
      setFormValue(`${prefix}RoleNinja`, translation?.roleNinja);
    });
    if (existingMediaPanel) existingMediaPanel.hidden = false;
    if (replaceGalleryOption) replaceGalleryOption.hidden = !data.gallery.length;
    if (coverHelp) coverHelp.textContent = data.cover ? '— leave empty to keep the current cover' : '';
    if (galleryHelp) galleryHelp.textContent = data.gallery.length ? '— existing images are kept and new ones are added' : '';
    renderExistingMedia();
    if (slugInput) {
      slugInput.readOnly = true;
      slugInput.dataset.edited = 'true';
    }
    if (editingBanner) editingBanner.hidden = false;
    if (editingTitle) editingTitle.textContent = data.title;
    if (saveProjectButton) saveProjectButton.textContent = 'Save project changes';
    updateVideoFields();
    setStatus(`Editing ${data.title}. Existing media will stay in place unless replacement files are selected.`);
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function stopEditing() {
    editingProject = null;
    form?.reset();
    pendingGalleryFiles = [];
    renderPendingGallery();
    if (slugInput) {
      slugInput.readOnly = false;
      delete slugInput.dataset.edited;
    }
    if (editingBanner) editingBanner.hidden = true;
    if (editingTitle) editingTitle.textContent = '';
    if (saveProjectButton) saveProjectButton.textContent = 'Choose website folder & save';
    if (existingMediaPanel) existingMediaPanel.hidden = true;
    if (existingMediaGrid) existingMediaGrid.replaceChildren();
    if (replaceGalleryOption) replaceGalleryOption.hidden = true;
    if (coverHelp) coverHelp.textContent = '';
    if (galleryHelp) galleryHelp.textContent = '';
    updateVideoFields();
    setStatus('Ready to create a new project.');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    try {
      const picker = (window as any).showDirectoryPicker;
      if (!picker) throw new Error('Direct saving is not supported here. Open Project Studio in current Chrome or Edge, or use “Download Markdown only”.');
      const project = projectData();
      if (!editingProject) setStatus('Choose the rxn-developing-website folder in the browser window…');
      const root = editingProject && managerRoot ? managerRoot : await picker({ mode: 'readwrite' });
      await verifyWebsiteRoot(root);
      const contentDir = await nestedDirectory(root, ['src', 'content', 'projects']);
      const mediaDir = await nestedDirectory(root, ['public', 'assets', 'projects', project.slug]);
      const projectFile = editingProject?.file || `${project.slug}.md`;
      await writeFile(contentDir, projectFile, project.markdown);
      for (const item of project.files) await writeFile(mediaDir, item.name, item.file);
      managerRoot = root;
      if (editingProject) {
        editingProject = parseProjectFile(project.markdown, projectFile);
        if (editingTitle) editingTitle.textContent = editingProject.title;
        setStatus(`Updated ${projectFile}. ${project.files.length ? `${project.files.length} replacement media file(s) saved.` : 'Existing media preserved.'}`, 'success');
      } else setStatus(`Saved ${project.slug}.md and ${project.files.length} media file(s). Astro will update the local preview automatically.`, 'success');
      await refreshManagedProjects();
    } catch (error) {
      if ((error as Error).name === 'AbortError') setStatus('Folder selection cancelled.');
      else setStatus((error as Error).message, 'error');
    }
  });

  downloadButton?.addEventListener('click', () => {
    if (!form?.reportValidity()) return;
    const project = projectData();
    const url = URL.createObjectURL(new Blob([project.markdown], { type: 'text/markdown' }));
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = `${project.slug}.md`;
    anchor.click();
    URL.revokeObjectURL(url);
    setStatus('Markdown downloaded. Media files must be copied manually into the matching project folder.', 'success');
  });

  async function refreshManagedProjects() {
    if (!managerRoot || !projectSelect || !deleteProjectButton || !editProjectButton) return;
    const contentDir = await nestedDirectory(managerRoot, ['src', 'content', 'projects']);
    managedProjects = [];
    for await (const [name, handle] of contentDir.entries()) {
      if (handle.kind !== 'file' || !name.endsWith('.md')) continue;
      const text = await (await handle.getFile()).text();
      managedProjects.push(parseProjectFile(text, name));
    }
    managedProjects.sort((a, b) => a.title.localeCompare(b.title));
    projectSelect.innerHTML = managedProjects.length
      ? `<option value="">Select a project</option>${managedProjects.map((project, index) => `<option value="${index}">${project.title}</option>`).join('')}`
      : '<option value="">No projects found</option>';
    projectSelect.disabled = !managedProjects.length;
    editProjectButton.disabled = true;
    deleteProjectButton.disabled = true;
    if (managerStatus) managerStatus.textContent = managedProjects.length ? `${managedProjects.length} project(s) found.` : 'No project files were found.';
  }

  loadProjectsButton?.addEventListener('click', async () => {
    try {
      const picker = (window as any).showDirectoryPicker;
      if (!picker) throw new Error('Project management requires current Chrome or Edge.');
      managerRoot = await picker({ mode: 'readwrite' });
      await verifyWebsiteRoot(managerRoot);
      await refreshManagedProjects();
    } catch (error) {
      if ((error as Error).name !== 'AbortError' && managerStatus) managerStatus.textContent = (error as Error).message;
    }
  });

  projectSelect?.addEventListener('change', () => {
    if (editProjectButton) editProjectButton.disabled = !projectSelect.value;
    if (deleteProjectButton) deleteProjectButton.disabled = !projectSelect.value;
  });

  editProjectButton?.addEventListener('click', () => {
    if (!projectSelect?.value) return;
    loadProjectIntoForm(managedProjects[Number(projectSelect.value)]);
  });

  cancelEditButton?.addEventListener('click', stopEditing);

  deleteProjectButton?.addEventListener('click', async () => {
    if (!managerRoot || !projectSelect?.value) return;
    const project = managedProjects[Number(projectSelect.value)];
    const removeMedia = Boolean(deleteMediaInput?.checked);
    const confirmed = window.confirm(`Delete “${project.title}”${removeMedia ? ' and all media in its project folder' : ''}? This cannot be undone from Project Studio.`);
    if (!confirmed) return;
    try {
      const contentDir = await nestedDirectory(managerRoot, ['src', 'content', 'projects']);
      await contentDir.removeEntry(project.file);
      if (removeMedia) {
        const projectsMediaDir = await nestedDirectory(managerRoot, ['public', 'assets', 'projects']);
        try { await projectsMediaDir.removeEntry(project.slug, { recursive: true }); } catch (error) { if ((error as Error).name !== 'NotFoundError') throw error; }
      }
      await refreshManagedProjects();
      if (editingProject?.file === project.file) stopEditing();
      if (managerStatus) managerStatus.textContent = `Deleted ${project.title}${removeMedia ? ' and its media' : ''}.`;
    } catch (error) {
      if (managerStatus) managerStatus.textContent = `Could not delete the project: ${(error as Error).message}`;
    }
  });
</script>
