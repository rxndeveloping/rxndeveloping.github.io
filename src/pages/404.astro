---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="not-found">
    <div class="container not-found__inner">
      <span class="not-found__code">404</span>
      <p class="eyebrow"><span></span>Signal lost</p>
      <h1>This route doesn’t lead anywhere.</h1>
      <p>The page may have moved, or the address may be incomplete.</p>
      <div class="hero-actions"><a class="button button--primary" href={sitePath()}>Return home</a><a class="button button--ghost" href={sitePath('projects/')}>View projects</a></div>
    </div>
  </section>
</BaseLayout>
