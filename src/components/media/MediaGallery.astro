---
import { assetPath } from '../../utils/paths';
interface ImageItem { src: string; alt: string; caption?: string; position?: string; }
interface Props { images: ImageItem[]; }
const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="media-gallery" data-gallery>
    {images.map((image, index) => (
      <figure class:list={['gallery-item', index === 0 && images.length > 2 && 'gallery-item--feature']}>
        <button type="button" data-gallery-open={index} aria-label={`Open image ${index + 1}: ${image.alt}`}>
          <img src={assetPath(image.src)} alt={image.alt} loading="lazy" style={`object-position:${image.position || 'center'}`} />
          <span aria-hidden="true">Expand ↗</span>
        </button>
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    ))}
    <dialog class="lightbox" data-lightbox>
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close image viewer">Close ×</button>
      <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous image">←</button>
      <figure>
        <img data-lightbox-image alt="" />
        <figcaption data-lightbox-caption></figcaption>
      </figure>
      <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next image">→</button>
    </dialog>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = gallery.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = gallery.querySelector<HTMLElement>('[data-lightbox-caption]');
    let active = 0;

    const show = (index: number) => {
      active = (index + buttons.length) % buttons.length;
      const source = buttons[active].querySelector<HTMLImageElement>('img');
      if (!source || !image) return;
      image.src = source.src;
      image.alt = source.alt;
      if (caption) caption.textContent = buttons[active].closest('figure')?.querySelector('figcaption')?.textContent || '';
    };

    buttons.forEach((button, index) => button.addEventListener('click', () => {
      show(index);
      dialog?.showModal();
    }));
    gallery.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog?.close());
    gallery.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(active - 1));
    gallery.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(active + 1));
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>
