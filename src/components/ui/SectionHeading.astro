---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`]}>
  <p class="eyebrow"><span></span>{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p class="section-heading__copy">{description}</p>}
</div>
