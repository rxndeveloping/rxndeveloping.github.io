---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  eyebrowKey?: string;
  titleKey?: string;
  descriptionKey?: string;
}
const { eyebrow, title, description, align = 'left', eyebrowKey, titleKey, descriptionKey } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`]}>
  <p class="eyebrow"><span></span><span data-i18n={eyebrowKey}>{eyebrow}</span></p>
  <h2 data-i18n={titleKey}>{title}</h2>
  {description && <p class="section-heading__copy" data-i18n={descriptionKey}>{description}</p>}
</div>
