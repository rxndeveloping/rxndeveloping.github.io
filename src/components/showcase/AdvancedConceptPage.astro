---
import ShowcaseShell from '../../layouts/ShowcaseShell.astro';
import T from './ShowcaseText.astro';
import type { AdvancedConcept } from '../../data/advancedShowcases';
interface Props { concept: AdvancedConcept; section?: string }
const { concept, section = '' } = Astro.props;
const page = concept.pages.find((item) => item.slug === section);
const nav = [{ href:`/showcase/${concept.slug}/`, label:{en:'Home',it:'Home',fr:'Accueil',es:'Inicio'} }, ...concept.pages.map((item)=>({href:`/showcase/${concept.slug}/${item.slug}/`,label:item.label}))];
const cta = { href:`/showcase/${concept.slug}/${concept.pages[1].slug}/`, label: concept.pages[1].label };
const isTool = page?.slug === concept.pages[1].slug;
const toolTitles = {
  tickets:{en:'Live ticket studio',it:'Ticket studio live',fr:'Billetterie live',es:'Estudio de entradas'},fitness:{en:'Membership configurator',it:'Configuratore abbonamento',fr:'Configurateur abonnement',es:'Configurador de membresía'},automotive:{en:'Finance configurator',it:'Configuratore finanziamento',fr:'Configurateur financement',es:'Configurador de financiación'},clinic:{en:'Guided care finder',it:'Care finder guidato',fr:'Orientation guidée',es:'Orientación guiada'},travel:{en:'Live itinerary builder',it:'Itinerary builder live',fr:'Créateur d’itinéraire',es:'Creador de itinerario'},academy:{en:'Adaptive skill assessment',it:'Skill assessment adattivo',fr:'Évaluation adaptative',es:'Evaluación adaptativa'}
};
---
<ShowcaseShell title={`${page?.title.en || concept.headline.en} — ${concept.brand}`} description={concept.intro.en} brand={concept.brand} variant={concept.variant as any} home={`/showcase/${concept.slug}/`} nav={nav} cta={cta}>
  {!page ? <>
    <section class="advanced-hero"><img src={concept.image} alt={`${concept.brand} concept`} /><div class="advanced-hero__copy"><T class="advanced-kicker" {...concept.category} /><T as="h1" {...concept.headline} /><T as="p" {...concept.intro} /><div class="advanced-actions"><a class="advanced-button advanced-button--accent" href={`/showcase/${concept.slug}/${concept.pages[1].slug}/`}><T {...concept.pages[1].label} /> ↗</a><a class="advanced-button" href={`/showcase/${concept.slug}/${concept.pages[0].slug}/`}><T {...concept.pages[0].label} /></a></div></div></section>
    <section class="advanced-stats">{concept.stats.map((stat)=><div><strong>{stat.value}</strong><T {...stat.label} /></div>)}</section>
    <section class="advanced-section"><div class="advanced-head"><div><T class="advanced-kicker" en="Selected system surfaces" it="Superfici principali" fr="Surfaces principales" es="Superficies principales" /><T as="h2" en="More than a landing page." it="Più di una landing page." fr="Plus qu’une landing page." es="Más que una landing page." /></div><T as="p" en="This concept connects information architecture, conversion, service operations, and an interactive product flow in one coherent system." it="Questo concept unisce architettura informativa, conversione, operatività e un flusso prodotto interattivo." fr="Ce concept réunit information, conversion, opérations et parcours produit interactif." es="Este concepto une información, conversión, operaciones y un flujo interactivo." /></div><div class="advanced-grid">{concept.cards.map((card)=><article class="advanced-card"><span>{card.eyebrow}</span><T as="h3" {...card.title} /><T as="p" {...card.text} /><strong>{card.meta}</strong></article>)}</div></section>
  </> : <>
    <section class="advanced-section advanced-section--panel"><div class="advanced-head"><div><T class="advanced-kicker" {...concept.category} /><T as="h1" {...page.title} /></div><T as="p" {...page.intro} /></div></section>
    {isTool ? <section class="advanced-section"><div class="advanced-system" data-advanced-tool={concept.tool}>
      <div class="advanced-system__main"><span class="system-label"><T {...toolTitles[concept.tool]} /></span><T as="h2" en="Configure it live." it="Configuralo dal vivo." fr="Configurez-le en direct." es="Configúralo en vivo." /><T as="p" en="This interactive module runs entirely inside the demonstration. Values are illustrative and no request or payment is transmitted." it="Il modulo funziona interamente nella demo. I valori sono indicativi e nessuna richiesta o pagamento viene trasmesso." fr="Ce module fonctionne dans la démo. Les valeurs sont indicatives et aucune demande n’est transmise." es="El módulo funciona dentro de la demo. Los valores son ilustrativos y no se transmite ninguna solicitud." />
        {concept.tool === 'tickets' && <><div class="system-options"><button class="system-option active" data-choice="34"><strong>Continental Masters</strong><small>18 OCT · 18:30</small></button><button class="system-option" data-choice="26"><strong>Valorant Night Shift</strong><small>02 NOV · 20:00</small></button></div><div class="seat-map">{Array.from({length:32},(_,i)=><button type="button" data-seat={i+1}>{String.fromCharCode(65+Math.floor(i/8))}{i%8+1}</button>)}</div></>}
        {concept.tool === 'fitness' && <><div class="system-options"><button class="system-option active" data-choice="69"><strong><T en="Open gym" it="Sala libera" fr="Salle libre" es="Sala libre" /></strong><small>€69 / month</small></button><button class="system-option" data-choice="99"><strong><T en="Classes unlimited" it="Corsi illimitati" fr="Cours illimités" es="Clases ilimitadas" /></strong><small>€99 / month</small></button><button class="system-option" data-choice="45"><strong><T en="Coach session" it="Sessione coach" fr="Session coach" es="Sesión coach" /></strong><small>+€45</small></button><button class="system-option" data-choice="25"><strong><T en="Recovery lab" it="Recovery lab" fr="Recovery lab" es="Recovery lab" /></strong><small>+€25</small></button></div></>}
        {concept.tool === 'automotive' && <><div class="system-options"><button class="system-option active" data-choice="92800"><strong>Apex R6 Touring</strong><small>€92,800</small></button><button class="system-option" data-choice="84500"><strong>Vector GT S</strong><small>€84,500</small></button><button class="system-option" data-choice="78900"><strong>Northline E-01</strong><small>€78,900</small></button></div><div class="system-range"><label><T en="Deposit" it="Anticipo" fr="Apport" es="Entrada" /><output data-range-output>€18,000</output></label><input type="range" min="5000" max="40000" step="1000" value="18000" data-range /></div></>}
        {concept.tool === 'clinic' && <><div class="system-options"><button class="system-option" data-choice="cardiology"><strong><T en="Chest or circulation" it="Torace o circolazione" fr="Thorax ou circulation" es="Pecho o circulación" /></strong><small><T en="Prevention pathway" it="Percorso prevenzione" fr="Parcours prévention" es="Ruta preventiva" /></small></button><button class="system-option" data-choice="movement"><strong><T en="Movement or pain" it="Movimento o dolore" fr="Mouvement ou douleur" es="Movimiento o dolor" /></strong><small><T en="Sports medicine" it="Medicina sportiva" fr="Médecine du sport" es="Medicina deportiva" /></small></button><button class="system-option" data-choice="sleep"><strong><T en="Sleep or stress" it="Sonno o stress" fr="Sommeil ou stress" es="Sueño o estrés" /></strong><small><T en="Mind & sleep" it="Mente e sonno" fr="Esprit et sommeil" es="Mente y sueño" /></small></button><button class="system-option" data-choice="general"><strong><T en="Not sure yet" it="Non sono sicuro" fr="Je ne sais pas" es="No estoy seguro" /></strong><small><T en="Initial orientation" it="Orientamento iniziale" fr="Orientation initiale" es="Orientación inicial" /></small></button></div></>}
        {concept.tool === 'travel' && <><div class="system-options"><button class="system-option active" data-choice="4800"><strong><T en="Northern Japan" it="Giappone del nord" fr="Nord du Japon" es="Norte de Japón" /></strong><small>12 nights · from €4,800</small></button><button class="system-option" data-choice="3200"><strong>Andalucía</strong><small>9 nights · from €3,200</small></button><button class="system-option" data-choice="5600"><strong>Iceland</strong><small>15 nights · from €5,600</small></button><button class="system-option" data-choice="900"><strong><T en="Private guide pack" it="Pacchetto guide private" fr="Pack guides privés" es="Pack de guías privados" /></strong><small>+€900</small></button></div><div class="system-range"><label><T en="Travellers" it="Viaggiatori" fr="Voyageurs" es="Viajeros" /><output data-range-output>2</output></label><input type="range" min="1" max="6" value="2" data-range /></div></>}
        {concept.tool === 'academy' && <><div class="system-options"><button class="system-option" data-choice="20"><strong>HTML / CSS</strong><small><T en="I can build layouts" it="Creo layout" fr="Je crée des layouts" es="Creo layouts" /></small></button><button class="system-option" data-choice="25"><strong>JavaScript</strong><small><T en="I understand application logic" it="Comprendo la logica" fr="Je comprends la logique" es="Entiendo la lógica" /></small></button><button class="system-option" data-choice="30"><strong>Backend / API</strong><small><T en="I have shipped an API" it="Ho pubblicato una API" fr="J’ai livré une API" es="He publicado una API" /></small></button><button class="system-option" data-choice="25"><strong>Git / Deploy</strong><small><T en="I use production workflows" it="Uso workflow production" fr="J’utilise des workflows production" es="Uso flujos de producción" /></small></button></div></>}
      </div><aside class="advanced-system__side"><span class="system-label"><T en="Live summary" it="Riepilogo live" fr="Résumé live" es="Resumen en vivo" /></span><div class="system-total"><span data-summary-label><T en="Indicative total" it="Totale indicativo" fr="Total indicatif" es="Total orientativo" /></span><strong data-system-total>—</strong><T as="p" en="Update the options to see the system respond immediately." it="Aggiorna le opzioni per vedere il sistema rispondere subito." fr="Modifiez les options pour voir le système répondre." es="Modifica las opciones para ver la respuesta del sistema." /><button class="system-submit" type="button" data-system-submit><T en="Generate summary" it="Genera riepilogo" fr="Générer le résumé" es="Generar resumen" /> ↗</button><div class="system-result" data-system-result hidden><strong><T en="Configuration ready" it="Configurazione pronta" fr="Configuration prête" es="Configuración lista" /></strong><T as="p" en="The simulated request has been prepared. No information was transmitted." it="La richiesta simulata è pronta. Nessuna informazione è stata trasmessa." fr="La demande simulée est prête. Aucune information n’a été transmise." es="La solicitud simulada está lista. No se transmitió información." /></div></div></aside>
    </div></section> : <section class="advanced-section"><div class="advanced-grid">{concept.cards.map((card)=><article class="advanced-card"><span>{card.eyebrow}</span><T as="h3" {...card.title} /><T as="p" {...card.text} /><strong>{card.meta}</strong></article>)}</div><div class="advanced-timeline" style="margin-top:80px">{['01','02','03','04'].map((step,index)=><article><span>{step}</span><T as="h3" en={['Discover','Compare','Personalise','Continue'][index]} it={['Scopri','Confronta','Personalizza','Continua'][index]} fr={['Découvrir','Comparer','Personnaliser','Continuer'][index]} es={['Descubrir','Comparar','Personalizar','Continuar'][index]} /><T as="p" en="A connected step in the service journey, designed to keep context and reduce friction." it="Un passaggio connesso del servizio, pensato per mantenere il contesto e ridurre gli attriti." fr="Une étape connectée du service, conçue pour garder le contexte et réduire les frictions." es="Un paso conectado del servicio, diseñado para mantener el contexto y reducir fricciones." /></article>)}</div></section>}
  </>}
</ShowcaseShell>

<script>
  document.querySelectorAll<HTMLElement>('[data-advanced-tool]').forEach((tool) => {
    const kind = tool.dataset.advancedTool;
    const options = [...tool.querySelectorAll<HTMLButtonElement>('[data-choice]')];
    const range = tool.querySelector<HTMLInputElement>('[data-range]');
    const output = tool.querySelector<HTMLOutputElement>('[data-range-output]');
    const total = tool.querySelector<HTMLElement>('[data-system-total]');
    const selected = new Set<HTMLButtonElement>(options.filter((item)=>item.classList.contains('active')));
    const single = ['tickets','automotive','clinic'].includes(kind || '');
    function calculate(){
      const values=[...selected].map((item)=>Number(item.dataset.choice)||0);
      let value=values.reduce((sum,item)=>sum+item,0);
      if(kind==='tickets') value=value+(tool.querySelectorAll('[data-seat].active').length*value);
      if(kind==='automotive') value=Math.max(0,((value-(Number(range?.value)||0))/48)*1.035);
      if(kind==='travel') value=value*(Number(range?.value)||1);
      if(kind==='academy') { total!.textContent=`${Math.min(value,100)} / 100`; return; }
      if(kind==='clinic') { total!.textContent=selected.size ? 'MATCH READY' : '—'; return; }
      total!.textContent=value ? new Intl.NumberFormat('en-IE',{style:'currency',currency:'EUR',maximumFractionDigits:kind==='automotive'?0:0}).format(value) : '—';
    }
    options.forEach((item)=>item.addEventListener('click',()=>{if(single)options.forEach((other)=>{other.classList.remove('active');selected.delete(other)});item.classList.toggle('active');if(item.classList.contains('active'))selected.add(item);else selected.delete(item);calculate()}));
    tool.querySelectorAll<HTMLButtonElement>('[data-seat]').forEach((seat)=>seat.addEventListener('click',()=>{seat.classList.toggle('active');calculate()}));
    range?.addEventListener('input',()=>{if(output)output.textContent=kind==='automotive'?`€${Number(range.value).toLocaleString()}`:range.value;calculate()});
    tool.querySelector('[data-system-submit]')?.addEventListener('click',()=>{const result=tool.querySelector<HTMLElement>('[data-system-result]');if(result)result.hidden=false});
    calculate();
  });
</script>
