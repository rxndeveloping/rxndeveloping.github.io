<dialog class="showcase-detail" data-showcase-detail aria-labelledby="showcase-detail-title">
  <button class="showcase-detail__close" type="button" data-detail-close aria-label="Close">×</button>
  <div class="showcase-detail__media" data-detail-media hidden><img data-detail-image alt="" /></div>
  <div class="showcase-detail__content">
    <span class="showcase-detail__eyebrow" data-detail-eyebrow></span>
    <h2 id="showcase-detail-title" data-detail-title></h2>
    <p class="showcase-detail__lead" data-detail-copy></p>
    <div class="showcase-detail__facts">
      <div><span data-label-format>FORMAT</span><strong data-detail-format></strong></div>
      <div><span data-label-status>STATUS</span><strong data-detail-status></strong></div>
      <div><span data-label-reference>REFERENCE</span><strong data-detail-code></strong></div>
    </div>
    <div class="showcase-detail__article" data-detail-article hidden>
      <p data-article-one></p><p data-article-two></p>
    </div>
    <form class="showcase-detail__form" data-detail-form novalidate>
      <h3 data-detail-form-title></h3>
      <div class="showcase-detail__fields">
        <label><span data-label-name></span><input name="name" required autocomplete="name" /></label>
        <label><span data-label-email></span><input name="email" required type="email" autocomplete="email" /></label>
        <label data-detail-date><span data-label-date></span><input name="date" required type="date" /></label>
        <label><span data-label-option></span><select name="option"><option value="standard" data-option-standard></option><option value="complete" data-option-complete></option><option value="custom" data-option-custom></option></select></label>
      </div>
      <label class="showcase-detail__consent"><input required type="checkbox" /><span data-label-consent></span></label>
      <button type="submit" data-detail-submit></button>
    </form>
    <section class="showcase-detail__confirmation" data-detail-confirmation hidden aria-live="polite"><b>✓</b><h3 data-confirmation-title></h3><p data-confirmation-copy></p><strong data-confirmation-code></strong></section>
  </div>
</dialog>

<script>
  type Lang='en'|'it'|'fr'|'es';
  const copy={
    en:{format:'Format',status:'Status',reference:'Reference',ready:'Interactive demo',name:'Full name',email:'Email',date:'Preferred date',option:'Request type',standard:'Standard',complete:'Complete',custom:'Custom',consent:'I understand this is a fictional portfolio demonstration.',details:'Request details',profile:'Contact profile',article:'Save and continue',case:'Discuss this case',booking:'Complete booking request',plan:'Activate selected plan',contact:'Speak with a specialist',submit:'Confirm demo request',done:'Request prepared',doneCopy:'Nothing was transmitted. Your demonstration reference is ready.',required:'Complete this field.',emailError:'Enter a valid email address.',dateError:'Select a valid date.',articleOne:'This expanded view adds context, decisions, and practical information instead of sending you to an empty destination.',articleTwo:'The interaction is part of the portfolio demonstration and can be explored without creating a real account or transaction.'},
    it:{format:'Formato',status:'Stato',reference:'Riferimento',ready:'Demo interattiva',name:'Nome completo',email:'Email',date:'Data preferita',option:'Tipo di richiesta',standard:'Standard',complete:'Completa',custom:'Personalizzata',consent:'Ho capito che questa è una dimostrazione immaginaria del portfolio.',details:'Richiedi dettagli',profile:'Contatta il profilo',article:'Salva e continua',case:'Parla di questo caso',booking:'Completa la prenotazione',plan:'Attiva il piano selezionato',contact:'Parla con uno specialista',submit:'Conferma richiesta demo',done:'Richiesta preparata',doneCopy:'Nessun dato è stato trasmesso. Il riferimento dimostrativo è pronto.',required:'Completa questo campo.',emailError:'Inserisci un indirizzo email valido.',dateError:'Seleziona una data valida.',articleOne:'Questa vista approfondita aggiunge contesto, decisioni e informazioni utili invece di portarti verso una destinazione vuota.',articleTwo:'L’interazione fa parte della dimostrazione portfolio e può essere esplorata senza creare un account o una transazione reale.'},
    fr:{format:'Format',status:'Statut',reference:'Référence',ready:'Démo interactive',name:'Nom complet',email:'E-mail',date:'Date souhaitée',option:'Type de demande',standard:'Standard',complete:'Complète',custom:'Sur mesure',consent:'Je comprends qu’il s’agit d’une démonstration fictive du portfolio.',details:'Demander les détails',profile:'Contacter le profil',article:'Enregistrer et continuer',case:'Discuter de ce cas',booking:'Finaliser la réservation',plan:'Activer l’offre choisie',contact:'Parler à un spécialiste',submit:'Confirmer la demande démo',done:'Demande préparée',doneCopy:'Aucune donnée n’a été transmise. Votre référence de démonstration est prête.',required:'Complétez ce champ.',emailError:'Saisissez une adresse e-mail valide.',dateError:'Sélectionnez une date valide.',articleOne:'Cette vue détaillée apporte du contexte, des décisions et des informations pratiques au lieu de mener vers une destination vide.',articleTwo:'Cette interaction fait partie de la démonstration du portfolio et peut être explorée sans compte ni transaction réelle.'},
    es:{format:'Formato',status:'Estado',reference:'Referencia',ready:'Demo interactiva',name:'Nombre completo',email:'Correo electrónico',date:'Fecha preferida',option:'Tipo de solicitud',standard:'Estándar',complete:'Completa',custom:'Personalizada',consent:'Entiendo que esta es una demostración ficticia del portfolio.',details:'Solicitar detalles',profile:'Contactar perfil',article:'Guardar y continuar',case:'Hablar de este caso',booking:'Completar reserva',plan:'Activar el plan elegido',contact:'Hablar con un especialista',submit:'Confirmar solicitud demo',done:'Solicitud preparada',doneCopy:'No se transmitió ningún dato. Tu referencia de demostración está lista.',required:'Completa este campo.',emailError:'Introduce un correo electrónico válido.',dateError:'Selecciona una fecha válida.',articleOne:'Esta vista ampliada añade contexto, decisiones e información práctica en lugar de llevarte a un destino vacío.',articleTwo:'La interacción forma parte de la demostración del portfolio y puede explorarse sin crear una cuenta ni una transacción real.'}
  };
  const dialog=document.querySelector<HTMLDialogElement>('[data-showcase-detail]');
  const form=dialog?.querySelector<HTMLFormElement>('[data-detail-form]');
  const lang=():Lang=>(document.documentElement.lang as Lang)||'en';
  const set=(selector:string,value:string)=>{const element=dialog?.querySelector<HTMLElement>(selector);if(element)element.textContent=value};
  const fieldError=(field:HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement,message:string)=>{field.closest('label')?.querySelector('.showcase-field-error')?.remove();const error=document.createElement('small');error.className='showcase-field-error';error.setAttribute('role','alert');error.textContent=message;field.closest('label')?.append(error);field.setAttribute('aria-invalid','true');};
  const clearError=(field:HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement)=>{field.closest('label')?.querySelector('.showcase-field-error')?.remove();field.removeAttribute('aria-invalid');};
  const validate=(target:HTMLFormElement)=>{const labels=copy[lang()];let first:HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement|undefined;target.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input,textarea,select').forEach(field=>{clearError(field);const emptyCheckbox=field instanceof HTMLInputElement&&field.type==='checkbox'&&!field.checked;if(field.required&&(emptyCheckbox||!field.value.trim())){fieldError(field,field.type==='date'?labels.dateError:labels.required);if(!first)first=field;}else if(field.type==='email'&&field.value&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value)){fieldError(field,labels.emailError);if(!first)first=field;}});if(first)first.focus();return !first;};
  const context=(trigger:HTMLElement)=>{const root=trigger.closest<HTMLElement>('article,section,.advanced-card,.nox-card,.aureon-project')||trigger.parentElement;const title=root?.querySelector<HTMLElement>('h1,h2,h3,[data-action-title],strong')?.textContent?.trim()||trigger.textContent?.trim()||'';const body=root?.querySelector<HTMLElement>('p')?.textContent?.trim()||'';const meta=root?.querySelector<HTMLElement>('small,time,.experience-kicker,.system-label')?.textContent?.trim()||'';const image=root?.querySelector<HTMLImageElement>('img')?.src||trigger.dataset.image||'';return{root,title,body,meta,image};};
  function renderLabels(mode:string){const labels=copy[lang()];set('[data-label-format]',labels.format);set('[data-label-status]',labels.status);set('[data-label-reference]',labels.reference);set('[data-label-name]',labels.name);set('[data-label-email]',labels.email);set('[data-label-date]',labels.date);set('[data-label-option]',labels.option);set('[data-label-consent]',labels.consent);set('[data-option-standard]',labels.standard);set('[data-option-complete]',labels.complete);set('[data-option-custom]',labels.custom);set('[data-confirmation-title]',labels.done);set('[data-confirmation-copy]',labels.doneCopy);set('[data-article-one]',labels.articleOne);set('[data-article-two]',labels.articleTwo);const titles:Record<string,string>={details:labels.details,profile:labels.profile,article:labels.article,case:labels.case,booking:labels.booking,plan:labels.plan,contact:labels.contact};set('[data-detail-form-title]',titles[mode]||labels.details);set('[data-detail-submit]',labels.submit);}
  function open(trigger:HTMLElement){if(!dialog)return;const mode=trigger.dataset.showcaseAction||'details';const item=context(trigger);renderLabels(mode);set('[data-detail-eyebrow]',item.meta||mode.toUpperCase());set('[data-detail-title]',item.title);set('[data-detail-copy]',item.body||copy[lang()].articleOne);set('[data-detail-format]',mode.toUpperCase());set('[data-detail-status]',copy[lang()].ready);set('[data-detail-code]',`${document.body.className.match(/showcase--([\w-]+)/)?.[1]?.slice(0,3).toUpperCase()||'RXN'}-${String(Math.abs(item.title.split('').reduce((a,c)=>a+c.charCodeAt(0),0))).padStart(4,'0').slice(-4)}`);const media=dialog.querySelector<HTMLElement>('[data-detail-media]');const img=dialog.querySelector<HTMLImageElement>('[data-detail-image]');if(media&&img){media.hidden=!item.image;if(item.image)img.src=item.image;}const article=dialog.querySelector<HTMLElement>('[data-detail-article]');if(article)article.hidden=mode!=='article';const date=dialog.querySelector<HTMLElement>('[data-detail-date]');const needsDate=['booking','plan','contact'].includes(mode);if(date){date.hidden=!needsDate;const dateInput=date.querySelector<HTMLInputElement>('input');if(dateInput)dateInput.required=needsDate;}form?.reset();dialog.querySelector<HTMLElement>('[data-detail-confirmation]')?.setAttribute('hidden','');form?.removeAttribute('hidden');dialog.dataset.mode=mode;dialog.showModal();document.body.classList.add('showcase-modal-open');const href=(trigger as HTMLAnchorElement).href;if(href&&href.includes(location.pathname)&&!href.startsWith('mailto:'))history.pushState({showcaseDetail:true},'',href);}
  document.addEventListener('click',(event)=>{const trigger=(event.target as HTMLElement).closest<HTMLElement>('[data-showcase-action]');if(trigger){event.preventDefault();open(trigger);return;}const mail=(event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="mailto:"]');if(mail){event.preventDefault();mail.dataset.showcaseAction='contact';open(mail);return;}const inertLink=(event.target as HTMLElement).closest<HTMLAnchorElement>('main a:not([href])');if(inertLink){event.preventDefault();inertLink.dataset.showcaseAction='details';open(inertLink);return;}const button=(event.target as HTMLElement).closest<HTMLButtonElement>('main button');if(!button||button.type==='submit'||button.matches('[data-next],[data-back],[data-party],[data-time],[data-experience],[data-choice],[data-seat],[data-range],[data-order-add],[data-filter],[data-archive-filter],[data-dashboard-tab],[data-class-day],[data-class-book],[data-plan],[data-demo-submit],[data-system-submit],[data-detail-close]'))return;if(button.closest('form'))return;button.dataset.showcaseAction='details';open(button);});
  dialog?.querySelector('[data-detail-close]')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',event=>{if(event.target===dialog)dialog.close()});dialog?.addEventListener('close',()=>{document.body.classList.remove('showcase-modal-open');if(history.state?.showcaseDetail)history.back();});
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&dialog?.open)dialog.close()});
  document.querySelectorAll<HTMLFormElement>('form').forEach(item=>item.noValidate=true);
  document.addEventListener('submit',event=>{const target=event.target as HTMLFormElement;if(!target||!target.closest('.showcase'))return;if(!validate(target)){event.preventDefault();event.stopImmediatePropagation();}},true);
  document.addEventListener('input',event=>{const field=event.target as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement;if(field.matches('input,textarea,select'))clearError(field)});
  form?.addEventListener('submit',event=>{event.preventDefault();if(!validate(form))return;form.hidden=true;const confirmation=dialog?.querySelector<HTMLElement>('[data-detail-confirmation]');const code=dialog?.querySelector<HTMLElement>('[data-confirmation-code]');if(code)code.textContent=`RXN-${Math.random().toString(36).slice(2,8).toUpperCase()}`;if(confirmation)confirmation.hidden=false;});
  window.addEventListener('showcase-language-change',()=>{if(dialog?.open)renderLabels(dialog.dataset.mode||'details')});
  window.addEventListener('popstate',()=>{if(dialog?.open)dialog.close()});
  const query=new URLSearchParams(location.search);const requested=query.get('content');if(requested){const target=document.querySelector<HTMLElement>(`[data-content-id="${CSS.escape(requested)}"]`);if(target)setTimeout(()=>open(target),80)}
</script>

<style is:global>
  body.showcase-modal-open{overflow:hidden}.showcase-detail{width:min(1040px,calc(100% - 28px));max-height:calc(100vh - 28px);padding:0;border:1px solid color-mix(in srgb,currentColor 22%,transparent);background:#111;color:#f5f2ed;box-shadow:0 30px 100px #0008}.showcase-detail::backdrop{background:#050505b8;backdrop-filter:blur(9px)}.showcase-detail__close{position:sticky;float:right;top:14px;right:14px;z-index:5;width:44px;height:44px;border:1px solid #ffffff45;background:#111;color:#fff;font-size:25px;cursor:pointer}.showcase-detail__media{height:300px;background:#222}.showcase-detail__media img{width:100%;height:100%;object-fit:cover}.showcase-detail__content{padding:clamp(28px,6vw,75px)}.showcase-detail__eyebrow{display:block;color:#ff5d50;font:750 11px/1.3 Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}.showcase-detail h2{font:720 clamp(42px,7vw,82px)/.96 'Inter Variable',Arial,sans-serif;letter-spacing:-.045em;margin:25px 0}.showcase-detail__lead{max-width:760px;color:#c5c0ba;font:18px/1.7 'Inter Variable',Arial,sans-serif}.showcase-detail__facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#ffffff25;border:1px solid #ffffff25;margin:40px 0}.showcase-detail__facts>div{padding:20px;background:#171717}.showcase-detail__facts span{display:block;color:#999;font:700 10px Arial,sans-serif;text-transform:uppercase;letter-spacing:.1em}.showcase-detail__facts strong{display:block;margin-top:12px;font:650 18px 'Inter Variable',Arial,sans-serif}.showcase-detail__article{border-left:3px solid #ff5d50;padding:5px 0 5px 24px;margin:35px 0}.showcase-detail__article p{color:#d2cdc7;font:17px/1.75 'Inter Variable',Arial,sans-serif}.showcase-detail__form{margin-top:45px;border-top:1px solid #ffffff2c;padding-top:35px}.showcase-detail__form h3,.showcase-detail__confirmation h3{font:650 30px 'Inter Variable',Arial,sans-serif;margin:0 0 25px}.showcase-detail__fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.showcase-detail__fields label>span,.showcase-detail__consent>span{display:block;font:700 11px Arial,sans-serif;text-transform:uppercase;letter-spacing:.09em}.showcase-detail input,.showcase-detail select{width:100%;margin-top:9px;padding:15px;border:1px solid #ffffff35;background:#1a1a1a;color:#fff;font:16px 'Inter Variable',Arial,sans-serif}.showcase-detail__consent{display:flex;align-items:center;gap:10px;margin:20px 0}.showcase-detail__consent input{width:auto;margin:0}.showcase-detail__form>button{border:0;background:#ff5d50;color:#fff;padding:17px 22px;font:750 12px Arial,sans-serif;cursor:pointer}.showcase-field-error{display:block!important;color:#ff8278!important;font:700 12px/1.4 Arial,sans-serif!important;margin-top:8px!important;text-transform:none!important;letter-spacing:0!important}.showcase-detail [aria-invalid="true"]{border-color:#ff8278;box-shadow:0 0 0 1px #ff8278}.showcase-detail__confirmation{padding:35px;border:1px solid #63db9d;margin-top:35px}.showcase-detail__confirmation>b{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:#63db9d;color:#08150e;margin-bottom:25px}.showcase-detail__confirmation p{color:#c5c0ba}.showcase-detail__confirmation>strong{display:block;margin-top:22px;font:700 18px monospace;color:#63db9d}@media(max-width:650px){.showcase-detail__fields,.showcase-detail__facts{grid-template-columns:1fr}.showcase-detail__media{height:210px}.showcase-detail__content{padding:28px 22px}.showcase-detail h2{font-size:40px}}
</style>
