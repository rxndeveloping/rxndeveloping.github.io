<script>
  type Lang = 'en' | 'it' | 'fr' | 'es';
  const messages = {
    en: { required:'Complete this field.', email:'Enter a valid email address.', date:'Select a valid date.' },
    it: { required:'Completa questo campo.', email:'Inserisci un indirizzo email valido.', date:'Seleziona una data valida.' },
    fr: { required:'Complétez ce champ.', email:'Saisissez une adresse e-mail valide.', date:'Sélectionnez une date valide.' },
    es: { required:'Completa este campo.', email:'Introduce un correo electrónico válido.', date:'Selecciona una fecha válida.' }
  };
  const language = (): Lang => (document.documentElement.lang as Lang) || 'en';
  const clearError = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
    field.closest('label')?.querySelector('.showcase-field-error')?.remove();
    field.removeAttribute('aria-invalid');
    field.setCustomValidity('');
  };
  const showError = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, message: string) => {
    clearError(field);
    const error = document.createElement('small');
    error.className = 'showcase-field-error';
    error.role = 'alert';
    error.textContent = message;
    field.closest('label')?.append(error);
    field.setAttribute('aria-invalid','true');
    field.setCustomValidity(message);
  };
  const validate = (form: HTMLFormElement) => {
    const copy = messages[language()];
    let first: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | undefined;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input,textarea,select').forEach((field) => {
      clearError(field);
      const unchecked = field instanceof HTMLInputElement && ['checkbox','radio'].includes(field.type) && !field.checked;
      if (field.required && (unchecked || !field.value.trim())) {
        showError(field, field.type === 'date' ? copy.date : copy.required);
        first ||= field;
      } else if (field.type === 'email' && field.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value)) {
        showError(field, copy.email);
        first ||= field;
      }
    });
    first?.focus();
    return !first;
  };

  document.querySelectorAll<HTMLFormElement>('form').forEach((form) => form.noValidate = true);
  document.addEventListener('submit', (event) => {
    const form = event.target as HTMLFormElement;
    if (!form?.closest('.showcase')) return;
    if (!validate(form)) {
      event.preventDefault();
      event.stopImmediatePropagation();
    }
  }, true);
  document.addEventListener('input', (event) => {
    const field = event.target as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    if (field.matches('input,textarea,select')) clearError(field);
  });
  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-content-href]');
    if (!trigger?.dataset.contentHref) return;
    event.preventDefault();
    const url = new URL(trigger.dataset.contentHref, location.origin);
    const lang = new URLSearchParams(location.search).get('lang');
    if (lang && lang !== 'en') url.searchParams.set('lang', lang);
    location.assign(`${url.pathname}${url.search}${url.hash}`);
  });
</script>
