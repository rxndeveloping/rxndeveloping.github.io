---
import T from '../ShowcaseText.astro';
import type { AdvancedConcept } from '../../../data/advancedShowcases';
interface Props{concept:AdvancedConcept;section?:string}
const{concept,section=''}=Astro.props;
const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="vx-home">
  <section class="vx-stage"><img src={concept.image} alt="Esports arena live event"/><div class="vx-stage__hud"><T class="vx-live" en="● LIVE FEED / VTX-01" it="● SEGNALE LIVE / VTX-01" fr="● FLUX LIVE / VTX-01" es="● SEÑAL LIVE / VTX-01"/><T en="DOORS 17:30 · MATCH 18:30" it="PORTE 17:30 · MATCH 18:30" fr="PORTES 17:30 · MATCH 18:30" es="PUERTAS 17:30 · PARTIDO 18:30"/></div><div class="vx-stage__copy"><T class="vx-code" {...concept.category}/><T as="h1" {...concept.headline}/><div class="vx-stage__actions"><a href="/showcase/vertex-arena/tickets/"><T en="ENTER TICKET CONTROL" it="APRI CONTROLLO BIGLIETTI" fr="OUVRIR LA BILLETTERIE" es="ABRIR CONTROL DE ENTRADAS"/> →</a><strong>CONTINENTAL MASTERS / FINAL</strong></div></div><aside class="vx-score"><T en="MAP 03 / LIVE" it="MAPPA 03 / LIVE" fr="MAP 03 / LIVE" es="MAPA 03 / LIVE"/><div><strong>NOVA</strong><b>11</b></div><div><strong>ORBIT</strong><b>09</b></div><T as="small" en="ROUND 21 · 00:42" it="ROUND 21 · 00:42" fr="MANCHE 21 · 00:42" es="RONDA 21 · 00:42"/></aside></section>
  <section class="vx-ops"><header><T en="ARENA OPERATIONS" it="OPERAZIONI ARENA" fr="OPÉRATIONS ARÈNE" es="OPERACIONES DE ARENA"/><T as="b" en="ALL SYSTEMS NOMINAL" it="TUTTI I SISTEMI OPERATIVI" fr="TOUS LES SYSTÈMES OPÉRATIONNELS" es="TODOS LOS SISTEMAS OPERATIVOS"/></header><div class="vx-ops__grid"><article><T en="NEXT MATCH" it="PROSSIMO MATCH" fr="PROCHAIN MATCH" es="PRÓXIMO PARTIDO"/><strong>18:30</strong><T en="Continental Masters · Grand Final" it="Continental Masters · Gran finale" fr="Continental Masters · Grande finale" es="Continental Masters · Gran final"/></article><article><T en="ATTENDANCE" it="PRESENZE" fr="PRÉSENCE" es="ASISTENCIA"/><strong>8,421</strong><T en="70.1% scanned at gates" it="70,1% scansionato ai gate" fr="70,1 % contrôlé aux portes" es="70,1 % escaneado"/></article><article><T en="QUEUE" it="CODA" fr="FILE" es="COLA"/><strong>04 MIN</strong><T en="Average north gate wait" it="Attesa media gate nord" fr="Attente porte nord" es="Espera puerta norte"/></article><article><T en="SEATS" it="POSTI" fr="PLACES" es="ASIENTOS"/><strong>412</strong><T en="Still available tonight" it="Ancora disponibili stasera" fr="Encore disponibles" es="Aún disponibles"/></article></div></section>
  <section class="vx-bracket"><div><T en="UPPER FINAL" it="FINALE UPPER" fr="FINALE UPPER" es="FINAL SUPERIOR"/><b>NOVA 2</b><b>ORBIT 1</b></div><i></i><div><T en="LOWER FINAL" it="FINALE LOWER" fr="FINALE LOWER" es="FINAL INFERIOR"/><b>RIFT 0</b><b>EMBER 2</b></div><i></i><div class="active"><T en="GRAND FINAL" it="GRAN FINALE" fr="GRANDE FINALE" es="GRAN FINAL"/><b>NOVA</b><b>EMBER</b></div></section>
</main> : section==='tickets' ? <main class="vx-console" data-advanced-tool="tickets">
  <aside class="vx-console__rail"><T en="TICKET CONTROL" it="CONTROLLO BIGLIETTI" fr="BILLETTERIE" es="CONTROL DE ENTRADAS"/><T as="b" en="01 EVENT" it="01 EVENTO" fr="01 ÉVÉNEMENT" es="01 EVENTO"/><T as="b" en="02 SECTION" it="02 SETTORE" fr="02 ZONE" es="02 SECTOR"/><T as="b" en="03 SEATS" it="03 POSTI" fr="03 PLACES" es="03 ASIENTOS"/><T as="b" en="04 PASS" it="04 CONFERMA" fr="04 PASS" es="04 PASE"/></aside><section class="vx-console__map"><header><div><span>CONTINENTAL MASTERS</span><T as="h1" en="Select your sector." it="Seleziona il settore." fr="Choisissez votre zone." es="Selecciona tu sector."/></div><strong>18 OCT · 18:30</strong></header><div class="vx-arena-map"><T class="vx-screen" en="MAIN STAGE" it="PALCO PRINCIPALE" fr="SCÈNE PRINCIPALE" es="ESCENARIO PRINCIPAL"/><div class="seat-map">{Array.from({length:48},(_,i)=><button type="button" data-seat={i+1}>{String.fromCharCode(65+Math.floor(i/8))}{i%8+1}</button>)}</div></div></section><aside class="vx-cart"><T en="LIVE CART" it="CARRELLO LIVE" fr="PANIER LIVE" es="CARRITO LIVE"/><div class="system-options"><button class="system-option active" data-choice="34"><strong>STANDARD</strong><small>€34 / <T en="seat" it="posto" fr="place" es="asiento"/></small></button><button class="system-option" data-choice="58"><strong>LOWER BOWL</strong><small>€58 / <T en="seat" it="posto" fr="place" es="asiento"/></small></button><button class="system-option" data-choice="96"><strong>PREMIUM</strong><small>€96 / <T en="seat" it="posto" fr="place" es="asiento"/></small></button></div><div class="system-total"><T en="Current total" it="Totale attuale" fr="Total actuel" es="Total actual"/><strong data-system-total>€34</strong><button class="system-submit" data-system-submit><T en="LOCK SEATS" it="BLOCCA POSTI" fr="BLOQUER LES PLACES" es="BLOQUEAR ASIENTOS"/></button><div class="system-result" data-system-result hidden><T as="strong" en="SEATS HELD / 05:00" it="POSTI BLOCCATI / 05:00" fr="PLACES BLOQUÉES / 05:00" es="ASIENTOS BLOQUEADOS / 05:00"/><T as="p" en="Your seats are temporarily held. Complete the contact and access details before the timer expires." it="I posti sono bloccati temporaneamente. Completa contatti e dati di accesso prima della scadenza." fr="Vos places sont temporairement bloquées. Complétez les coordonnées avant l’expiration." es="Tus asientos están bloqueados temporalmente. Completa los datos antes de que expire."/><button data-showcase-action="booking"><T en="CONTINUE TO BOOKING" it="CONTINUA LA PRENOTAZIONE" fr="CONTINUER LA RÉSERVATION" es="CONTINUAR RESERVA"/> →</button></div></div></aside>
</main> : section==='events' ? <main class="vx-events-page">
  <header><T en="EVENT PROGRAMME / SEASON 08" it="PROGRAMMA EVENTI / STAGIONE 08" fr="PROGRAMME / SAISON 08" es="PROGRAMA / TEMPORADA 08"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>
  <section>{[['18 OCT','CONTINENTAL MASTERS','GRAND FINAL · 18:30','412'],['02 NOV','VERTEX COMMUNITY CUP','OPEN BRACKET · 14:00','860'],['16 NOV','CREATOR SHOWDOWN','LIVE EVENT · 19:00','248']].map((event,index)=><article><time>{event[0]}</time><span>0{index+1}</span><div><small>{event[2]}</small><h2>{event[1]}</h2></div><strong>{event[3]} <T en="SEATS" it="POSTI" fr="PLACES" es="ASIENTOS"/></strong><a href="/showcase/vertex-arena/tickets/"><T en="GET TICKETS" it="BIGLIETTI" fr="BILLETS" es="ENTRADAS"/> ↗</a></article>)}</section>
</main> : <main class="vx-venue-page">
  <header><T en="VENUE SYSTEM / VTX-01" it="SISTEMA VENUE / VTX-01" fr="SYSTÈME DU LIEU / VTX-01" es="SISTEMA DEL RECINTO / VTX-01"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>
  <section class="vx-venue-map"><div class="stage"><T en="MAIN STAGE" it="PALCO PRINCIPALE" fr="SCÈNE PRINCIPALE" es="ESCENARIO PRINCIPAL"/></div><div class="zone z1">A / PREMIUM</div><div class="zone z2">B / STANDARD</div><div class="zone z3">C / ACCESSIBLE</div><div class="zone z4">D / CREATOR</div></section>
  <section class="vx-venue-guide"><article><b>01</b><T as="h2" en="Getting here" it="Come arrivare" fr="Venir" es="Cómo llegar"/><T as="p" en="Metro M2, north entrance, and managed ride-share zone." it="Metro M2, ingresso nord e area ride-sharing gestita." fr="Métro M2, entrée nord et zone VTC." es="Metro M2, entrada norte y zona de transporte."/></article><article><b>02</b><T as="h2" en="Accessibility" it="Accessibilità" fr="Accessibilité" es="Accesibilidad"/><T as="p" en="Step-free routes, companion seating, quiet room, and caption devices." it="Percorsi senza gradini, posti accompagnatori, quiet room e sottotitoli." fr="Parcours sans marches, places accompagnateurs et salle calme." es="Rutas sin escalones, asientos de acompañante y sala tranquila."/></article><article><b>03</b><T as="h2" en="Food & services" it="Food e servizi" fr="Restauration et services" es="Comida y servicios"/><T as="p" en="Six food counters, refill points, lockers, and merchandise collection." it="Sei punti food, refill, locker e ritiro merchandise." fr="Six comptoirs, points d’eau, casiers et retrait merchandising." es="Seis puestos, recarga de agua, taquillas y recogida de productos."/></article></section>
</main>}
