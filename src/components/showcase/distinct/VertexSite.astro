---
import T from '../ShowcaseText.astro'; import type { AdvancedConcept } from '../../../data/advancedShowcases';
interface Props{concept:AdvancedConcept;section?:string} const{concept,section=''}=Astro.props; const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="vx-home"><section class="vx-stage"><img src={concept.image} alt="Esports arena live event"/><div class="vx-stage__hud"><span class="vx-live">● LIVE FEED / VTX-01</span><span>DOORS 17:30 · MATCH 18:30</span></div><div class="vx-stage__copy"><T class="vx-code" {...concept.category}/><T as="h1" {...concept.headline}/><div class="vx-stage__actions"><a href="/showcase/vertex-arena/tickets/"><T en="ENTER TICKET CONTROL" it="APRI CONTROLLO BIGLIETTI" fr="OUVRIR LA BILLETTERIE" es="ABRIR CONTROL DE ENTRADAS"/> →</a><strong>CONTINENTAL MASTERS / FINAL</strong></div></div><aside class="vx-score"><span>MAP 03 / LIVE</span><div><strong>NOVA</strong><b>11</b></div><div><strong>ORBIT</strong><b>09</b></div><small>ROUND 21 · 00:42</small></aside></section><section class="vx-ops"><header><span>ARENA OPERATIONS</span><b>ALL SYSTEMS NOMINAL</b></header><div class="vx-ops__grid"><article><span>NEXT MATCH</span><strong>18:30</strong><T en="Continental Masters · Grand Final" it="Continental Masters · Gran finale" fr="Continental Masters · Grande finale" es="Continental Masters · Gran final"/></article><article><span>ATTENDANCE</span><strong>8,421</strong><T en="70.1% scanned at gates" it="70,1% scansionato ai gate" fr="70,1 % contrôlé aux portes" es="70,1 % escaneado"/></article><article><span>QUEUE</span><strong>04 MIN</strong><T en="Average north gate wait" it="Attesa media gate nord" fr="Attente porte nord" es="Espera puerta norte"/></article><article><span>SEATS</span><strong>412</strong><T en="Still available tonight" it="Ancora disponibili stasera" fr="Encore disponibles" es="Aún disponibles"/></article></div></section><section class="vx-bracket"><div><span>UPPER FINAL</span><b>NOVA 2</b><b>ORBIT 1</b></div><i></i><div><span>LOWER FINAL</span><b>RIFT 0</b><b>EMBER 2</b></div><i></i><div class="active"><span>GRAND FINAL</span><b>NOVA</b><b>EMBER</b></div></section></main> : section==='tickets' ? <main class="vx-console" data-advanced-tool="tickets"><aside class="vx-console__rail"><span>TICKET CONTROL</span><b>01 EVENT</b><b>02 SECTION</b><b>03 SEATS</b><b>04 PASS</b></aside><section class="vx-console__map"><header><div><span>CONTINENTAL MASTERS</span><T as="h1" en="Select your sector." it="Seleziona il settore." fr="Choisissez votre zone." es="Selecciona tu sector." /></div><strong>18 OCT · 18:30</strong></header><div class="vx-arena-map"><div class="vx-screen">MAIN STAGE</div><div class="seat-map">{Array.from({length:48},(_,i)=><button type="button" data-seat={i+1}>{String.fromCharCode(65+Math.floor(i/8))}{i%8+1}</button>)}</div></div></section><aside class="vx-cart"><span>LIVE CART</span><div class="system-options"><button class="system-option active" data-choice="34"><strong>STANDARD</strong><small>€34 / seat</small></button><button class="system-option" data-choice="58"><strong>LOWER BOWL</strong><small>€58 / seat</small></button><button class="system-option" data-choice="96"><strong>PREMIUM</strong><small>€96 / seat</small></button></div><div class="system-total"><span><T en="Current total" it="Totale attuale" fr="Total actuel" es="Total actual"/></span><strong data-system-total>€34</strong><button class="system-submit" data-system-submit><T en="LOCK SEATS" it="BLOCCA POSTI" fr="BLOQUER LES PLACES" es="BLOQUEAR ASIENTOS"/></button><div class="system-result" data-system-result hidden><strong>SEATS HELD / 04:59</strong></div></div></aside></main> : <main class="vx-list"><header><span>VERTEX / {section?.toUpperCase()}</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>{concept.cards.map((card,index)=><article><span>0{index+1}</span><div><small>{card.eyebrow}</small><T as="h2" {...card.title}/></div><T as="p" {...card.text}/><strong>{card.meta}</strong><a href={index===0?'/showcase/vertex-arena/tickets/':'#'}>OPEN →</a></article>)}</main>}
