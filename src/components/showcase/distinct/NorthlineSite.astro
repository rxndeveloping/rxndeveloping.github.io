---
import T from '../ShowcaseText.astro';
import type { AdvancedConcept } from '../../../data/advancedShowcases';
import { showcaseExtraHref } from '../../../data/showcaseContent';
interface Props{concept:AdvancedConcept;section?:string}
const{concept,section=''}=Astro.props;
const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="nl-home">
  <section class="nl-hero"><div class="nl-hero__top"><T en="STOCK / 086" it="DISPONIBILI / 086" fr="STOCK / 086" es="INVENTARIO / 086"/><T {...concept.category}/><T en="EU DELIVERY" it="CONSEGNA UE" fr="LIVRAISON UE" es="ENTREGA UE"/></div><img src={concept.image} alt="Performance car on road"/><div class="nl-hero__name"><T as="small" en="01 / FEATURED" it="01 / IN EVIDENZA" fr="01 / À LA UNE" es="01 / DESTACADO"/><h1>APEX<br/>R6 TOURING</h1><a href="/showcase/northline-motors/configure/"><T en="CONFIGURE" it="CONFIGURA" fr="CONFIGURER" es="CONFIGURAR"/> ↗</a></div><div class="nl-hero__spec"><div><b>510</b><span>HP</span></div><div><b>3.7</b><span>0—100</span></div><div><b>AWD</b><T en="DRIVE" it="TRAZIONE" fr="TRANSMISSION" es="TRACCIÓN"/></div><div><b>8,200</b><span>KM</span></div></div></section>
  <section class="nl-stock"><header><T as="b" en="AVAILABLE NOW" it="DISPONIBILI ORA" fr="DISPONIBLES" es="DISPONIBLES AHORA"/><T en="VERIFIED / WARRANTED / EU DELIVERY" it="VERIFICATE / GARANTITE / CONSEGNA UE" fr="VÉRIFIÉES / GARANTIES / LIVRAISON UE" es="VERIFICADOS / GARANTIZADOS / ENTREGA UE"/></header>{concept.cards.map((card,index)=><article><span>0{index+1}</span><T as="h2" {...card.title}/><T as="p" {...card.text}/><strong>{card.meta}</strong><a href="/showcase/northline-motors/configure/"><T en="BUILD DEAL" it="CREA OFFERTA" fr="CRÉER L’OFFRE" es="CREAR OFERTA"/> →</a></article>)}</section>
</main> : section==='configure' ? <main class="nl-config" data-advanced-tool="automotive">
  <header><T en="DEAL BUILDER / 01" it="CONFIGURATORE OFFERTA / 01" fr="CONFIGURATEUR D’OFFRE / 01" es="CONFIGURADOR DE OFERTA / 01"/><T as="h1" en="Configure the deal, not just the car." it="Configura l’accordo, non solo l’auto." fr="Configurez l’accord, pas seulement la voiture." es="Configura el acuerdo, no solo el coche."/></header>
  <div class="nl-config__viewport"><img src={concept.image} alt="Selected performance vehicle"/><div class="nl-config__models system-options"><button class="system-option active" data-choice="92800"><strong>APEX R6</strong><small>€92,800</small></button><button class="system-option" data-choice="84500"><strong>VECTOR GT S</strong><small>€84,500</small></button><button class="system-option" data-choice="78900"><strong>E-01</strong><small>€78,900</small></button></div></div>
  <aside><T en="FINANCE CONTROL" it="CONTROLLO FINANZIAMENTO" fr="CONTRÔLE FINANCEMENT" es="CONTROL DE FINANCIACIÓN"/><div class="system-range"><label><T en="Deposit" it="Anticipo" fr="Apport" es="Entrada"/><output data-range-output>€18,000</output></label><input type="range" min="5000" max="40000" step="1000" value="18000" data-range/></div><dl><div><dt><T en="TERM" it="DURATA" fr="DURÉE" es="PLAZO"/></dt><dd>48 <T en="MONTHS" it="MESI" fr="MOIS" es="MESES"/></dd></div><div><dt>APR</dt><dd>3.5%</dd></div><div><dt><T en="WARRANTY" it="GARANZIA" fr="GARANTIE" es="GARANTÍA"/></dt><dd>24 <T en="MONTHS" it="MESI" fr="MOIS" es="MESES"/></dd></div></dl><div class="system-total"><T en="EST. MONTHLY" it="RATA STIMATA" fr="MENSUALITÉ EST." es="CUOTA EST."/><strong data-system-total>—</strong><button class="system-submit" data-system-submit><T en="REQUEST TEST DRIVE" it="RICHIEDI TEST DRIVE" fr="DEMANDER UN ESSAI" es="SOLICITAR PRUEBA"/> ↗</button><div class="system-result" data-system-result hidden><T as="strong" en="CONFIGURATION SAVED" it="CONFIGURAZIONE SALVATA" fr="CONFIGURATION ENREGISTRÉE" es="CONFIGURACIÓN GUARDADA"/><T as="p" en="Choose a preferred date and leave contact details to complete the demonstration." it="Scegli una data preferita e lascia i contatti per completare la dimostrazione." fr="Choisissez une date et renseignez vos coordonnées pour terminer la démo." es="Elige una fecha e introduce tus datos para completar la demo."/><button data-content-href={showcaseExtraHref('northline-motors','test-drive-request')}><T en="COMPLETE TEST DRIVE REQUEST" it="COMPLETA RICHIESTA TEST DRIVE" fr="FINALISER LA DEMANDE D’ESSAI" es="COMPLETAR SOLICITUD DE PRUEBA"/> →</button></div></div></aside>
</main> : section==='ownership' ? <main class="nl-ownership-page">
  <header><T en="OWNERSHIP / ACTIVE SERVICES" it="GESTIONE / SERVIZI ATTIVI" fr="SERVICES PROPRIÉTAIRE" es="SERVICIOS DE PROPIEDAD"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>
  <section class="nl-ownership-summary"><article><T en="Next service" it="Prossimo service" fr="Prochain entretien" es="Próximo servicio"/><strong>2,800 KM</strong><span>18 OCT / MILANO</span></article><article><T en="Warranty" it="Garanzia" fr="Garantie" es="Garantía"/><strong>18 <T en="MONTHS" it="MESI" fr="MOIS" es="MESES"/></strong><T en="ACTIVE / EU" it="ATTIVA / UE" fr="ACTIVE / UE" es="ACTIVA / UE"/></article><article><T en="Vehicle health" it="Stato veicolo" fr="État du véhicule" es="Estado del vehículo"/><strong>96%</strong><T en="NO ACTIONS REQUIRED" it="NESSUNA AZIONE RICHIESTA" fr="AUCUNE ACTION REQUISE" es="SIN ACCIONES PENDIENTES"/></article></section>
  <section class="nl-ownership-services"><article><b>01</b><T as="h2" en="Service plan" it="Piano service" fr="Plan d’entretien" es="Plan de servicio"/><T as="p" en="Scheduled maintenance, digital history, collection, and return." it="Manutenzione programmata, storico digitale, ritiro e riconsegna." fr="Entretien planifié, historique numérique, collecte et retour." es="Mantenimiento programado, historial digital, recogida y entrega."/><button data-content-href={showcaseExtraHref('northline-motors','service-plan-management')}><T en="MANAGE PLAN" it="GESTISCI PIANO" fr="GÉRER LE PLAN" es="GESTIONAR PLAN"/> →</button></article><article><b>02</b><T as="h2" en="Secure storage" it="Deposito sicuro" fr="Stockage sécurisé" es="Almacenamiento seguro"/><T as="p" en="Climate control, battery care, monthly movement, and status reports." it="Clima controllato, cura batteria, movimento mensile e report." fr="Climatisation, batterie, mouvement mensuel et rapports." es="Climatización, batería, movimiento mensual e informes."/><button data-content-href={showcaseExtraHref('northline-motors','secure-storage-availability')}><T en="CHECK AVAILABILITY" it="VERIFICA DISPONIBILITÀ" fr="VOIR LES DISPONIBILITÉS" es="VER DISPONIBILIDAD"/> →</button></article><article><b>03</b><T as="h2" en="Roadside support" it="Assistenza stradale" fr="Assistance routière" es="Asistencia en carretera"/><T as="p" en="European recovery, onward travel, and specialist vehicle transport." it="Recupero europeo, viaggio sostitutivo e trasporto specializzato." fr="Dépannage européen, poursuite du voyage et transport spécialisé." es="Recuperación europea, viaje alternativo y transporte especializado."/><button data-content-href={showcaseExtraHref('northline-motors','roadside-support-cover')}><T en="VIEW COVER" it="VEDI COPERTURA" fr="VOIR LA COUVERTURE" es="VER COBERTURA"/> →</button></article></section>
</main> : <main class="nl-inventory">
  <header><span>NORTHLINE / {section?.toUpperCase()}</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><div class="nl-filter"><T en="FILTER" it="FILTRA" fr="FILTRE" es="FILTRO"/><button data-nl-filter="all"><T en="BODY: ALL" it="CARROZZERIA: TUTTE" fr="CARROSSERIE : TOUTES" es="CARROCERÍA: TODAS"/></button><button data-nl-filter="performance"><T en="POWER: 500+" it="POTENZA: 500+" fr="PUISSANCE : 500+" es="POTENCIA: 500+"/></button><button data-nl-filter="electric"><T en="DRIVE: ELECTRIC" it="TRAZIONE: ELETTRICA" fr="TRANSMISSION : ÉLECTRIQUE" es="TRACCIÓN: ELÉCTRICA"/></button><button data-nl-sort><T en="SORT: RECENT" it="ORDINA: RECENTI" fr="TRI : RÉCENT" es="ORDEN: RECIENTE"/></button></div>{concept.cards.map((card,index)=><article data-nl-stock={index===2?'electric':index===0?'performance':'gt'}><div class="nl-thumb"><span>0{index+1}</span><b>{card.eyebrow}</b></div><T as="h2" {...card.title}/><T as="p" {...card.text}/><strong>{card.meta}</strong><label><input type="checkbox"/> <T en="COMPARE" it="CONFRONTA" fr="COMPARER" es="COMPARAR"/></label></article>)}
</main>}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-nl-filter]').forEach((button) => button.addEventListener('click', () => {
    const filter = button.dataset.nlFilter || 'all';
    document.querySelectorAll('[data-nl-filter]').forEach((item) => item.classList.toggle('active', item === button));
    document.querySelectorAll<HTMLElement>('[data-nl-stock]').forEach((card) => card.hidden = filter !== 'all' && card.dataset.nlStock !== filter);
  }));
  document.querySelector<HTMLButtonElement>('[data-nl-sort]')?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const parent = button.closest('.nl-filter')?.parentElement;
    const cards = [...parent?.querySelectorAll<HTMLElement>('[data-nl-stock]') || []].reverse();
    cards.forEach((card) => parent?.append(card));
    button.classList.toggle('active');
  });
</script>
