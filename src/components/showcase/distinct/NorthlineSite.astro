---
import T from '../ShowcaseText.astro'; import type { AdvancedConcept } from '../../../data/advancedShowcases'; interface Props{concept:AdvancedConcept;section?:string} const{concept,section=''}=Astro.props; const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="nl-home"><section class="nl-hero"><div class="nl-hero__top"><span>STOCK / 086</span><T {...concept.category}/><span>EU DELIVERY</span></div><img src={concept.image} alt="Performance car on road"/><div class="nl-hero__name"><small>01 / FEATURED</small><h1>APEX<br/>R6 TOURING</h1><a href="/showcase/northline-motors/configure/">CONFIGURE ↗</a></div><div class="nl-hero__spec"><div><b>510</b><span>HP</span></div><div><b>3.7</b><span>0—100</span></div><div><b>AWD</b><span>DRIVE</span></div><div><b>8,200</b><span>KM</span></div></div></section><section class="nl-stock"><header><b>AVAILABLE NOW</b><span>VERIFIED / WARRANTED / EU DELIVERY</span></header>{concept.cards.map((card,index)=><article><span>0{index+1}</span><T as="h2" {...card.title}/><T as="p" {...card.text}/><strong>{card.meta}</strong><a href="/showcase/northline-motors/configure/">BUILD DEAL →</a></article>)}</section></main> : section==='configure' ? <main class="nl-config" data-advanced-tool="automotive"><header><span>DEAL BUILDER / 01</span><T as="h1" en="Configure the deal, not just the car." it="Configura l’accordo, non solo l’auto." fr="Configurez l’accord, pas seulement la voiture." es="Configura el acuerdo, no solo el coche."/></header><div class="nl-config__viewport"><img src={concept.image} alt="Selected performance vehicle"/><div class="nl-config__models system-options"><button class="system-option active" data-choice="92800"><strong>APEX R6</strong><small>€92,800</small></button><button class="system-option" data-choice="84500"><strong>VECTOR GT S</strong><small>€84,500</small></button><button class="system-option" data-choice="78900"><strong>E-01</strong><small>€78,900</small></button></div></div><aside><span>FINANCE CONTROL</span><div class="system-range"><label><T en="Deposit" it="Anticipo" fr="Apport" es="Entrada"/><output data-range-output>€18,000</output></label><input type="range" min="5000" max="40000" step="1000" value="18000" data-range/></div><dl><div><dt>TERM</dt><dd>48 MONTHS</dd></div><div><dt>APR</dt><dd>3.5%</dd></div><div><dt>WARRANTY</dt><dd>24 MONTHS</dd></div></dl><div class="system-total"><span>EST. MONTHLY</span><strong data-system-total>—</strong><button class="system-submit" data-system-submit>REQUEST TEST DRIVE ↗</button><div class="system-result" data-system-result hidden><strong>CONFIGURATION SAVED</strong></div></div></aside></main> : <main class="nl-inventory"><header><span>NORTHLINE / {section?.toUpperCase()}</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><div class="nl-filter"><span>FILTER</span><button>BODY: ALL</button><button>POWER: 400+</button><button>DRIVE: ALL</button><button>SORT: RECENT</button></div>{concept.cards.map((card,index)=><article><div class="nl-thumb"><span>0{index+1}</span><b>{card.eyebrow}</b></div><T as="h2" {...card.title}/><T as="p" {...card.text}/><strong>{card.meta}</strong><label><input type="checkbox"/> COMPARE</label></article>)}</main>}
