---
import T from '../ShowcaseText.astro';
import type { AdvancedConcept } from '../../../data/advancedShowcases';
interface Props{concept:AdvancedConcept;section?:string}
const{concept,section=''}=Astro.props;
const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="fg-app">
  <aside class="fg-files"><b>FORGE_EXPLORER</b><T en="▾ CURRICULUM" it="▾ PROGRAMMA" fr="▾ PROGRAMME" es="▾ TEMARIO"/><a class="active">01_start_here.md</a><a>02_systems.ts</a><a>03_ship_project.tsx</a><T en="▾ WORKSPACE" it="▾ SPAZIO DI LAVORO" fr="▾ ESPACE DE TRAVAIL" es="▾ ESPACIO DE TRABAJO"/><a>checkpoint_04</a><a>code_review</a><a>portfolio</a><footer>● <T en="COHORT ONLINE" it="COORTE ONLINE" fr="COHORTE EN LIGNE" es="COHORTE EN LÍNEA"/></footer></aside><section class="fg-editor"><header><span>01_start_here.md</span><b>PREVIEW</b></header><div class="fg-code"><small>01&nbsp;&nbsp;# FORGE DIGITAL ACADEMY</small><T as="h1" {...concept.headline}/><T as="p" {...concept.intro}/><div class="fg-command"><span>$ forge assess --skills=current</span><a href="/showcase/forge-digital-academy/skill-path/"><T en="RUN ASSESSMENT" it="AVVIA VALUTAZIONE" fr="LANCER L’ÉVALUATION" es="INICIAR EVALUACIÓN"/> ↗</a></div></div><div class="fg-terminal"><header>TERMINAL&nbsp;&nbsp; OUTPUT&nbsp;&nbsp; PROBLEMS 0</header><p><span>forge@cohort:~$</span> programme --status</p><T as="p" en="✓ mentor connected · ✓ lab ready · ✓ deploy target active" it="✓ mentor connesso · ✓ lab pronto · ✓ deploy attivo" fr="✓ mentor connecté · ✓ lab prêt · ✓ déploiement actif" es="✓ mentor conectado · ✓ lab listo · ✓ despliegue activo"/></div></section><aside class="fg-progress"><T en="LEARNING GRAPH" it="GRAFO FORMATIVO" fr="GRAPHE D’APPRENTISSAGE" es="GRAFO DE APRENDIZAJE"/><div class="fg-node done">HTML/CSS</div><i></i><div class="fg-node active">TYPESCRIPT</div><i></i><div class="fg-node">SYSTEMS</div><i></i><div class="fg-node">SHIP</div><footer><strong>32%</strong><T as="small" en="PATH COMPLETE" it="PERCORSO COMPLETATO" fr="PARCOURS TERMINÉ" es="RUTA COMPLETADA"/></footer></aside>
</main> : section==='skill-path' ? <main class="fg-assess" data-advanced-tool="academy">
  <aside><b>ASSESSMENT.EXE</b><T en="SESSION / LOCAL" it="SESSIONE / LOCALE" fr="SESSION / LOCALE" es="SESIÓN / LOCAL"/><ol><T as="li" class="active" en="01 SKILLS" it="01 COMPETENZE" fr="01 COMPÉTENCES" es="01 HABILIDADES"/><T as="li" en="02 EXPERIENCE" it="02 ESPERIENZA" fr="02 EXPÉRIENCE" es="02 EXPERIENCIA"/><T as="li" en="03 GOAL" it="03 OBIETTIVO" fr="03 OBJECTIF" es="03 OBJETIVO"/><T as="li" en="04 PATH" it="04 PERCORSO" fr="04 PARCOURS" es="04 RUTA"/></ol></aside><section><header><T en="QUESTION SET 01 / 04" it="DOMANDE 01 / 04" fr="QUESTIONS 01 / 04" es="PREGUNTAS 01 / 04"/><T as="h1" en="What can you ship without a tutorial?" it="Cosa sai pubblicare senza tutorial?" fr="Que pouvez-vous livrer sans tutoriel ?" es="¿Qué puedes lanzar sin tutorial?"/><T as="p" {...page.intro}/></header><div class="fg-skills system-options"><button class="system-option" data-choice="20"><code>&lt;/&gt;</code><strong>HTML / CSS</strong><small>LAYOUTS + RESPONSIVE</small></button><button class="system-option" data-choice="25"><code>JS</code><strong>JAVASCRIPT</strong><small>STATE + INTERACTIONS</small></button><button class="system-option" data-choice="30"><code>API</code><strong>BACKEND</strong><small>DATA + SERVICES</small></button><button class="system-option" data-choice="25"><code>GIT</code><strong>DELIVERY</strong><small>TEST + DEPLOY</small></button></div><button class="system-submit" data-system-submit><T en="COMPILE RESULT" it="CALCOLA RISULTATO" fr="CALCULER LE RÉSULTAT" es="CALCULAR RESULTADO"/> →</button></section><aside class="fg-score"><T en="READINESS" it="PREPARAZIONE" fr="PRÉPARATION" es="PREPARACIÓN"/><strong data-system-total>0 / 100</strong><div class="fg-log"><T as="p" en="waiting_for_input..." it="in_attesa_input..." fr="attente_entrée..." es="esperando_entrada..."/><p>skills_selected: <b>0</b></p><p>path_match: pending</p></div><div class="system-result" data-system-result hidden><T as="strong" en="RECOMMENDED: FULL-STACK SYSTEMS" it="CONSIGLIATO: SISTEMI FULL-STACK" fr="CONSEILLÉ : SYSTÈMES FULL-STACK" es="RECOMENDADO: SISTEMAS FULL-STACK"/><T as="p" en="STARTING MODULE / TYPESCRIPT FOUNDATIONS" it="MODULO INIZIALE / FONDAMENTI TYPESCRIPT" fr="MODULE INITIAL / BASES TYPESCRIPT" es="MÓDULO INICIAL / BASES TYPESCRIPT"/><button data-showcase-action="plan"><T en="VIEW RECOMMENDED PATH" it="VEDI PERCORSO CONSIGLIATO" fr="VOIR LE PARCOURS CONSEILLÉ" es="VER RUTA RECOMENDADA"/> →</button></div></aside>
</main> : section==='programs' ? <main class="fg-programs-page">
  <header><T en="PROGRAM CATALOGUE / 2026" it="CATALOGO PROGRAMMI / 2026" fr="CATALOGUE DES PROGRAMMES / 2026" es="CATÁLOGO DE PROGRAMAS / 2026"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><section>{concept.cards.map((card,index)=><article><header><span>0{index+1}</span><small>{card.eyebrow}</small></header><T as="h2" {...card.title}/><T as="p" {...card.text}/><dl><div><dt><T en="Duration" it="Durata" fr="Durée" es="Duración"/></dt><dd>{index===0?'12':index===1?'8':'6'} <T en="WEEKS" it="SETTIMANE" fr="SEMAINES" es="SEMANAS"/></dd></div><div><dt><T en="Live labs" it="Lab live" fr="Labs live" es="Labs en vivo"/></dt><dd>{18-index*4}</dd></div><div><dt><T en="Mentor reviews" it="Revisioni mentor" fr="Revues mentor" es="Revisiones de mentor"/></dt><dd>{8-index}</dd></div></dl><footer><strong>{card.meta}</strong><a href="/showcase/forge-digital-academy/pricing/"><T en="VIEW PRICE & SYLLABUS" it="VEDI PREZZO E SYLLABUS" fr="VOIR PRIX ET PROGRAMME" es="VER PRECIO Y TEMARIO"/> →</a></footer></article>)}</section>
</main> : <main class="fg-dashboard">
  <aside><b>FORGE_</b><T as="a" en="OVERVIEW" it="PANORAMICA" fr="VUE D’ENSEMBLE" es="RESUMEN"/><a class="active">{section?.toUpperCase()}</a><T as="a" en="CALENDAR" it="CALENDARIO" fr="CALENDRIER" es="CALENDARIO"/><T as="a" en="REVIEWS" it="REVISIONI" fr="REVUES" es="REVISIONES"/><T as="a" en="PORTFOLIO" it="PORTFOLIO" fr="PORTFOLIO" es="PORTFOLIO"/></aside><section><header><div><span>COHORT / FS-26</span><T as="h1" {...page.title}/></div><T as="p" {...page.intro}/></header><div class="fg-sprints">{concept.cards.map((card,index)=><article><span>SPRINT 0{index+1}</span><T as="h2" {...card.title}/><T as="p" {...card.text}/><div><i style={`--w:${45+index*21}%`}></i></div><footer><strong>{card.meta}</strong><button><T en="OPEN WORKSPACE" it="APRI WORKSPACE" fr="OUVRIR L’ESPACE" es="ABRIR ESPACIO"/> →</button></footer></article>)}</div></section><aside class="fg-activity"><T en="LIVE ACTIVITY" it="ATTIVITÀ LIVE" fr="ACTIVITÉ LIVE" es="ACTIVIDAD LIVE"/><p><b>09:42</b> code_review approved</p><p><b>09:18</b> build passed</p><p><b>08:55</b> checkpoint submitted</p><p><b>YDAY</b> mentor note added</p></aside>
</main>}
