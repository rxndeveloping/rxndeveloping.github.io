---
import T from '../ShowcaseText.astro'; import type { AdvancedConcept } from '../../../data/advancedShowcases'; interface Props{concept:AdvancedConcept;section?:string} const{concept,section=''}=Astro.props; const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="fg-app"><aside class="fg-files"><b>FORGE_EXPLORER</b><span>▾ CURRICULUM</span><a class="active">01_start_here.md</a><a>02_systems.ts</a><a>03_ship_project.tsx</a><span>▾ WORKSPACE</span><a>checkpoint_04</a><a>code_review</a><a>portfolio</a><footer>● COHORT ONLINE</footer></aside><section class="fg-editor"><header><span>01_start_here.md</span><b>PREVIEW</b></header><div class="fg-code"><small>01&nbsp;&nbsp;# FORGE DIGITAL ACADEMY</small><T as="h1" {...concept.headline}/><T as="p" {...concept.intro}/><div class="fg-command"><span>$ forge assess --skills=current</span><a href="/showcase/forge-digital-academy/skill-path/">RUN ASSESSMENT ↗</a></div></div><div class="fg-terminal"><header>TERMINAL&nbsp;&nbsp; OUTPUT&nbsp;&nbsp; PROBLEMS 0</header><p><span>forge@cohort:~$</span> programme --status</p><p>✓ mentor connected &nbsp; ✓ lab ready &nbsp; ✓ deploy target active</p></div></section><aside class="fg-progress"><span>LEARNING GRAPH</span><div class="fg-node done">HTML/CSS</div><i></i><div class="fg-node active">TYPESCRIPT</div><i></i><div class="fg-node">SYSTEMS</div><i></i><div class="fg-node">SHIP</div><footer><strong>32%</strong><small>PATH COMPLETE</small></footer></aside></main> : section==='skill-path' ? <main class="fg-assess" data-advanced-tool="academy"><aside><b>ASSESSMENT.EXE</b><span>SESSION / LOCAL</span><ol><li class="active">01 SKILLS</li><li>02 EXPERIENCE</li><li>03 GOAL</li><li>04 PATH</li></ol></aside><section><header><span>QUESTION SET 01 / 04</span><T as="h1" en="What can you ship without a tutorial?" it="Cosa sai pubblicare senza tutorial?" fr="Que pouvez-vous livrer sans tutoriel ?" es="¿Qué puedes lanzar sin tutorial?"/><T as="p" {...page.intro}/></header><div class="fg-skills system-options"><button class="system-option" data-choice="20"><code>&lt;/&gt;</code><strong>HTML / CSS</strong><small>LAYOUTS + RESPONSIVE</small></button><button class="system-option" data-choice="25"><code>JS</code><strong>JAVASCRIPT</strong><small>STATE + INTERACTIONS</small></button><button class="system-option" data-choice="30"><code>API</code><strong>BACKEND</strong><small>DATA + SERVICES</small></button><button class="system-option" data-choice="25"><code>GIT</code><strong>DELIVERY</strong><small>TEST + DEPLOY</small></button></div><button class="system-submit" data-system-submit>COMPILE RESULT →</button></section><aside class="fg-score"><span>READINESS</span><strong data-system-total>0 / 100</strong><div class="fg-log"><p>waiting_for_input...</p><p>skills_selected: <b>0</b></p><p>path_match: pending</p></div><div class="system-result" data-system-result hidden><strong>RECOMMENDED: FULL-STACK SYSTEMS</strong><p>STARTING MODULE / TYPESCRIPT FOUNDATIONS</p></div></aside></main> : <main class="fg-dashboard"><aside><b>FORGE_</b><a>OVERVIEW</a><a class="active">{section?.toUpperCase()}</a><a>CALENDAR</a><a>REVIEWS</a><a>PORTFOLIO</a></aside><section><header><div><span>COHORT / FS-26</span><T as="h1" {...page.title}/></div><T as="p" {...page.intro}/></header><div class="fg-sprints">{concept.cards.map((card,index)=><article><span>SPRINT 0{index+1}</span><T as="h2" {...card.title}/><T as="p" {...card.text}/><div><i style={`--w:${45+index*21}%`}></i></div><footer><strong>{card.meta}</strong><button>OPEN WORKSPACE →</button></footer></article>)}</div></section><aside class="fg-activity"><span>LIVE ACTIVITY</span><p><b>09:42</b> code_review approved</p><p><b>09:18</b> build passed</p><p><b>08:55</b> checkpoint submitted</p><p><b>YDAY</b> mentor note added</p></aside></main>}
