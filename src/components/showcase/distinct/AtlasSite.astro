---
import T from '../ShowcaseText.astro';
import type { AdvancedConcept } from '../../../data/advancedShowcases';
interface Props{concept:AdvancedConcept;section?:string}
const{concept,section=''}=Astro.props;
const page=concept.pages.find(p=>p.slug===section);
const atlasCardDetails=[
 {eyebrow:{en:'12 DAYS / AUTUMN',it:'12 GIORNI / AUTUNNO',fr:'12 JOURS / AUTOMNE',es:'12 DÍAS / OTOÑO'},meta:{en:'FROM €4,800',it:'DA €4.800',fr:'À PARTIR DE 4 800 €',es:'DESDE 4.800 €'}},
 {eyebrow:{en:'9 DAYS / SPRING',it:'9 GIORNI / PRIMAVERA',fr:'9 JOURS / PRINTEMPS',es:'9 DÍAS / PRIMAVERA'},meta:{en:'FROM €3,200',it:'DA €3.200',fr:'À PARTIR DE 3 200 €',es:'DESDE 3.200 €'}},
 {eyebrow:{en:'15 DAYS / SUMMER',it:'15 GIORNI / ESTATE',fr:'15 JOURS / ÉTÉ',es:'15 DÍAS / VERANO'},meta:{en:'FROM €5,600',it:'DA €5.600',fr:'À PARTIR DE 5 600 €',es:'DESDE 5.600 €'}}
];
---
{!page ? <main class="at-home">
  <header class="at-mast"><span>ATLAS / JOURNEYS — ISSUE 08</span><T as="h1" {...concept.headline}/><div><T as="p" {...concept.intro}/><a href="/showcase/atlas-journeys/trip-builder/"><T en="BEGIN A JOURNEY" it="INIZIA UN VIAGGIO" fr="COMMENCER UN VOYAGE" es="EMPEZAR UN VIAJE"/> ↗</a></div></header>
  <section class="at-cover"><img src={concept.image} alt="Remote travel landscape"/><div class="at-note at-note--one"><T en="FIELD NOTE / 041" it="NOTA DAL CAMPO / 041" fr="NOTE DE TERRAIN / 041" es="NOTA DE CAMPO / 041"/><strong>64°08′ N</strong><T en="The road leaves the map here." it="Qui la strada lascia la mappa." fr="Ici, la route quitte la carte." es="Aquí la carretera deja el mapa."/></div><div class="at-note at-note--two"><T en="NEXT DEPARTURE" it="PROSSIMA PARTENZA" fr="PROCHAIN DÉPART" es="PRÓXIMA SALIDA"/><T as="strong" en="14 OCT" it="14 OTT" fr="14 OCT" es="14 OCT"/><T as="small" en="4 PLACES REMAIN" it="4 POSTI RIMASTI" fr="4 PLACES RESTANTES" es="QUEDAN 4 PLAZAS"/></div></section>
  <section class="at-editions">{concept.cards.map((card,index)=><article><b>{String(index+1).padStart(2,'0')}</b><T as="small" {...atlasCardDetails[index].eyebrow}/><T as="h2" {...card.title}/><T as="p" {...card.text}/><footer><T as="strong" {...atlasCardDetails[index].meta}/><a href="/showcase/atlas-journeys/trip-builder/"><T en="BUILD ROUTE" it="CREA ITINERARIO" fr="CRÉER L’ITINÉRAIRE" es="CREAR RUTA"/> →</a></footer></article>)}</section>
</main> : section==='trip-builder' ? <main class="at-builder" data-advanced-tool="travel">
  <aside><T en="YOUR ROUTE / DRAFT 01" it="IL TUO ITINERARIO / BOZZA 01" fr="VOTRE ITINÉRAIRE / BROUILLON 01" es="TU RUTA / BORRADOR 01"/><ol><T as="li" class="active" en="PLACE" it="LUOGO" fr="LIEU" es="LUGAR"/><T as="li" en="PACE" it="RITMO" fr="RYTHME" es="RITMO"/><T as="li" en="STAYS" it="SOGGIORNI" fr="SÉJOURS" es="ALOJAMIENTOS"/><T as="li" en="EXPERIENCES" it="ESPERIENZE" fr="EXPÉRIENCES" es="EXPERIENCIAS"/><T as="li" en="REVIEW" it="RIEPILOGO" fr="RÉCAPITULATIF" es="REVISIÓN"/></ol><T as="small" en="AUTOSAVED LOCALLY" it="SALVATO IN LOCALE" fr="SAUVEGARDÉ LOCALEMENT" es="GUARDADO LOCALMENTE"/></aside>
  <section><header><T as="h1" en="Pin the first place." it="Fissa il primo luogo." fr="Épinglez le premier lieu." es="Fija el primer lugar."/><T as="p" {...page.intro}/></header><div class="at-map"><span class="pin p1">01</span><span class="pin p2">02</span><span class="pin p3">03</span><div class="at-route"></div></div><div class="at-destinations system-options"><button class="system-option active" data-choice="4800"><T as="strong" en="NORTHERN JAPAN" it="GIAPPONE DEL NORD" fr="NORD DU JAPON" es="NORTE DE JAPÓN"/><small>12 <T en="NIGHTS" it="NOTTI" fr="NUITS" es="NOCHES"/> / €4,800</small></button><button class="system-option" data-choice="3200"><strong>ANDALUCÍA</strong><small>9 <T en="NIGHTS" it="NOTTI" fr="NUITS" es="NOCHES"/> / €3,200</small></button><button class="system-option" data-choice="5600"><T as="strong" en="ICELAND" it="ISLANDA" fr="ISLANDE" es="ISLANDIA"/><small>15 <T en="NIGHTS" it="NOTTI" fr="NUITS" es="NOCHES"/> / €5,600</small></button><button class="system-option" data-choice="900"><T as="strong" en="PRIVATE GUIDE" it="GUIDA PRIVATA" fr="GUIDE PRIVÉ" es="GUÍA PRIVADA"/><small>+ €900</small></button></div></section>
  <aside class="at-budget"><T en="TRIP ESTIMATE" it="STIMA VIAGGIO" fr="ESTIMATION VOYAGE" es="ESTIMACIÓN DEL VIAJE"/><div class="system-range"><label><T en="Travellers" it="Viaggiatori" fr="Voyageurs" es="Viajeros"/><output data-range-output>2</output></label><input type="range" min="1" max="6" value="2" data-range/></div><div class="system-total"><strong data-system-total>—</strong><T as="p" en="Indicative total including stays and selected field experiences." it="Totale indicativo con soggiorni ed esperienze selezionate." fr="Total indicatif avec séjours et expériences." es="Total orientativo con estancias y experiencias."/><button class="system-submit" data-system-submit><T en="SAVE ROUTE" it="SALVA ITINERARIO" fr="ENREGISTRER L’ITINÉRAIRE" es="GUARDAR RUTA"/> →</button><div class="system-result" data-system-result hidden><T as="strong" en="ROUTE SAVED / DRAFT 01" it="ITINERARIO SALVATO / BOZZA 01" fr="ITINÉRAIRE ENREGISTRÉ / BROUILLON 01" es="RUTA GUARDADA / BORRADOR 01"/><button data-showcase-action="contact"><T en="REVIEW WITH A SPECIALIST" it="RIVEDI CON UNO SPECIALISTA" fr="REVOIR AVEC UN SPÉCIALISTE" es="REVISAR CON UN ESPECIALISTA"/> →</button></div></div></aside>
</main> : section==='destinations' ? <main class="at-destinations-page">
  <header><T en="DESTINATION INDEX / SEASONAL" it="INDICE DESTINAZIONI / STAGIONALE" fr="INDEX DES DESTINATIONS / SAISON" es="ÍNDICE DE DESTINOS / TEMPORADA"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/><nav><button><T en="Season" it="Stagione" fr="Saison" es="Temporada"/> ▾</button><button><T en="Landscape" it="Paesaggio" fr="Paysage" es="Paisaje"/> ▾</button><button><T en="Pace" it="Ritmo" fr="Rythme" es="Ritmo"/> ▾</button></nav></header>
  <section>{concept.cards.map((card,index)=><article class={index===0?'wide':''}><div class="at-destination-image"><span>{String(index+1).padStart(2,'0')}</span><b>{index===0?'JP':index===1?'ES':'IS'}</b></div><T as="small" {...atlasCardDetails[index].eyebrow}/><T as="h2" {...card.title}/><T as="p" {...card.text}/><footer><T as="strong" {...atlasCardDetails[index].meta}/><a href="/showcase/atlas-journeys/trip-builder/"><T en="ADD TO ROUTE" it="AGGIUNGI AL VIAGGIO" fr="AJOUTER À L’ITINÉRAIRE" es="AÑADIR A LA RUTA"/> →</a></footer></article>)}</section>
</main> : <main class="at-journal">
  <header><span>ATLAS FIELD LIBRARY / {section?.toUpperCase()}</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><section>{concept.cards.map((card,index)=><article><div class="at-journal__num">#{41+index}</div><T as="small" {...atlasCardDetails[index].eyebrow}/><T as="h2" {...card.title}/><T as="p" {...card.text}/><footer><T as="strong" {...atlasCardDetails[index].meta}/><T en="8 MIN READ" it="8 MIN DI LETTURA" fr="8 MIN DE LECTURE" es="8 MIN DE LECTURA"/></footer></article>)}</section>
</main>}
