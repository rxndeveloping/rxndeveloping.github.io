---
import T from '../ShowcaseText.astro'; import type { AdvancedConcept } from '../../../data/advancedShowcases'; interface Props{concept:AdvancedConcept;section?:string} const{concept,section=''}=Astro.props; const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="at-home"><header class="at-mast"><span>ATLAS / JOURNEYS — ISSUE 08</span><T as="h1" {...concept.headline}/><div><T as="p" {...concept.intro}/><a href="/showcase/atlas-journeys/trip-builder/"><T en="BEGIN A JOURNEY" it="INIZIA UN VIAGGIO" fr="COMMENCER UN VOYAGE" es="EMPEZAR UN VIAJE"/> ↗</a></div></header><section class="at-cover"><img src={concept.image} alt="Remote travel landscape"/><div class="at-note at-note--one"><span>FIELD NOTE / 041</span><strong>64°08′ N</strong><T en="The road leaves the map here." it="Qui la strada lascia la mappa." fr="Ici, la route quitte la carte." es="Aquí la carretera deja el mapa."/></div><div class="at-note at-note--two"><span>NEXT DEPARTURE</span><strong>14 OCT</strong><small>4 PLACES REMAIN</small></div></section><section class="at-editions">{concept.cards.map((card,index)=><article><b>{String(index+1).padStart(2,'0')}</b><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/><footer><strong>{card.meta}</strong><a href="/showcase/atlas-journeys/trip-builder/">BUILD ROUTE →</a></footer></article>)}</section></main> : section==='trip-builder' ? <main class="at-builder" data-advanced-tool="travel"><aside><span>YOUR ROUTE / DRAFT 01</span><ol><li class="active">PLACE</li><li>PACE</li><li>STAYS</li><li>EXPERIENCES</li><li>REVIEW</li></ol><small>AUTOSAVED LOCALLY</small></aside><section><header><T as="h1" en="Pin the first place." it="Fissa il primo luogo." fr="Épinglez le premier lieu." es="Fija el primer lugar."/><T as="p" {...page.intro}/></header><div class="at-map"><span class="pin p1">01</span><span class="pin p2">02</span><span class="pin p3">03</span><div class="at-route"></div></div><div class="at-destinations system-options"><button class="system-option active" data-choice="4800"><strong>NORTHERN JAPAN</strong><small>12 NIGHTS / €4,800</small></button><button class="system-option" data-choice="3200"><strong>ANDALUCÍA</strong><small>9 NIGHTS / €3,200</small></button><button class="system-option" data-choice="5600"><strong>ICELAND</strong><small>15 NIGHTS / €5,600</small></button><button class="system-option" data-choice="900"><strong>PRIVATE GUIDE</strong><small>+ €900</small></button></div></section><aside class="at-budget"><span>TRIP ESTIMATE</span><div class="system-range"><label><T en="Travellers" it="Viaggiatori" fr="Voyageurs" es="Viajeros"/><output data-range-output>2</output></label><input type="range" min="1" max="6" value="2" data-range/></div><div class="system-total"><strong data-system-total>—</strong><T as="p" en="Indicative total including stays and selected field experiences." it="Totale indicativo con soggiorni ed esperienze selezionate." fr="Total indicatif avec séjours et expériences." es="Total orientativo con estancias y experiencias."/><button class="system-submit" data-system-submit>SAVE ROUTE →</button><div class="system-result" data-system-result hidden><strong>ROUTE SAVED / DRAFT 01</strong></div></div></aside></main> : <main class="at-journal"><header><span>ATLAS FIELD LIBRARY / {section?.toUpperCase()}</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><section>{concept.cards.map((card,index)=><article><div class="at-journal__num">#{41+index}</div><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/><footer><strong>{card.meta}</strong><span>8 MIN READ</span></footer></article>)}</section></main>}
