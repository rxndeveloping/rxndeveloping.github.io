---
import T from '../ShowcaseText.astro';
import type { AdvancedConcept } from '../../../data/advancedShowcases';
import { showcaseExtraHref } from '../../../data/showcaseContent';
interface Props{concept:AdvancedConcept;section?:string}
const{concept,section=''}=Astro.props;
const page=concept.pages.find(p=>p.slug===section);
const classes=[
 {time:'07:00',name:'Foundations 45',coach:'MILA',goal:{en:'Strength',it:'Forza',fr:'Force',es:'Fuerza'},spots:'4'},
 {time:'12:30',name:'Engine 30',coach:'NOAH',goal:{en:'Conditioning',it:'Condizionamento',fr:'Conditionnement',es:'Acondicionamiento'},spots:'2'},
 {time:'18:30',name:'Velocity',coach:'AMIR',goal:{en:'Speed',it:'Velocità',fr:'Vitesse',es:'Velocidad'},spots:'WAIT'},
 {time:'20:00',name:'Reset Lab',coach:'ANA',goal:{en:'Recovery',it:'Recupero',fr:'Récupération',es:'Recuperación'},spots:'8'}
];
---
{!page ? <main class="kt-home">
  <section class="kt-hero"><div class="kt-hero__type"><span>KINETIC / PERFORMANCE CLUB</span><T as="h1" en="MOVE. MEASURE. REPEAT." it="MUOVI. MISURA. RIPETI." fr="BOUGEZ. MESUREZ. RECOMMENCEZ." es="MUÉVETE. MIDE. REPITE."/><T as="p" {...concept.intro}/><a href="/showcase/kinetic-fitness-club/membership/"><T en="BUILD YOUR PLAN" it="CREA IL TUO PIANO" fr="CRÉER VOTRE PLAN" es="CREA TU PLAN"/> ↗</a></div><div class="kt-hero__image"><img src={concept.image} alt="Modern performance gym"/><div class="kt-pulse"><b>84</b><span><T en="READINESS" it="PRONTEZZA" fr="PRÉPARATION" es="PREPARACIÓN"/></span></div></div></section>
  <section class="kt-now"><header><b><T en="TODAY AT KINETIC" it="OGGI DA KINETIC" fr="AUJOURD’HUI" es="HOY EN KINETIC"/></b><T en="LIVE CAPACITY / MILAN 01" it="CAPIENZA LIVE / MILANO 01" fr="CAPACITÉ LIVE / MILAN 01" es="AFORO LIVE / MILÁN 01"/></header>{classes.map(item=><article><time>{item.time}</time><strong>{item.name}</strong><div><i></i><span>{item.spots} <T en="SPOTS" it="POSTI" fr="PLACES" es="PLAZAS"/></span></div><a href="/showcase/kinetic-fitness-club/classes/"><T en="BOOK" it="PRENOTA" fr="RÉSERVER" es="RESERVAR"/> +</a></article>)}</section>
  <section class="kt-metrics"><div><T en="WEEK 32" it="SETTIMANA 32" fr="SEMAINE 32" es="SEMANA 32"/><strong>4.8</strong><T as="small" en="SESSIONS / WEEK" it="SESSIONI / SETTIMANA" fr="SÉANCES / SEMAINE" es="SESIONES / SEMANA"/></div><div><T en="LOAD BALANCE" it="BILANCIO CARICO" fr="ÉQUILIBRE DE CHARGE" es="EQUILIBRIO DE CARGA"/><strong>92%</strong><T as="small" en="OPTIMAL RANGE" it="RANGE OTTIMALE" fr="ZONE OPTIMALE" es="RANGO ÓPTIMO"/></div><div><T en="RECOVERY" it="RECUPERO" fr="RÉCUPÉRATION" es="RECUPERACIÓN"/><strong>+14</strong><T as="small" en="VS LAST MONTH" it="VS MESE SCORSO" fr="VS MOIS DERNIER" es="VS MES ANTERIOR"/></div></section>
</main> : section==='membership' ? <main class="kt-builder" data-advanced-tool="fitness">
  <header><T en="MEMBERSHIP STUDIO / LIVE" it="STUDIO ABBONAMENTO / LIVE" fr="STUDIO ABONNEMENT / LIVE" es="ESTUDIO DE MEMBRESÍA / LIVE"/><T as="h1" en="Pay for the way you actually train." it="Paga per come ti alleni davvero." fr="Payez pour votre vraie façon de vous entraîner." es="Paga por cómo entrenas de verdad."/><T as="p" {...page.intro}/></header>
  <div class="kt-builder__body"><section><h2><T en="01 / BASE" it="01 / BASE" fr="01 / BASE" es="01 / BASE"/></h2><div class="system-options"><button class="system-option active" data-choice="69"><strong>OPEN GYM</strong><small>06:00—23:00 · €69</small></button><button class="system-option" data-choice="99"><strong>UNLIMITED</strong><small><T en="ALL CLASSES" it="TUTTI I CORSI" fr="TOUS LES COURS" es="TODAS LAS CLASES"/> · €99</small></button></div><h2><T en="02 / ADD-ONS" it="02 / EXTRA" fr="02 / OPTIONS" es="02 / EXTRAS"/></h2><div class="system-options"><button class="system-option" data-choice="45"><strong>1:1 COACH</strong><small>+ €45</small></button><button class="system-option" data-choice="25"><T as="strong" en="RECOVERY" it="RECUPERO" fr="RÉCUPÉRATION" es="RECUPERACIÓN"/><small>+ €25</small></button><button class="system-option" data-choice="18"><T as="strong" en="NUTRITION" it="NUTRIZIONE" fr="NUTRITION" es="NUTRICIÓN"/><small>+ €18</small></button></div></section><aside><T en="YOUR MONTH" it="IL TUO MESE" fr="VOTRE MOIS" es="TU MES"/><strong data-system-total>€69</strong><div class="kt-bar"><i></i><i></i><i></i><i></i><i></i></div><T as="p" en="Cancel or reconfigure monthly. No joining fee in this concept." it="Annulla o riconfigura ogni mese. Nessun costo di iscrizione nel concept." fr="Annulez ou reconfigurez chaque mois." es="Cancela o reconfigura cada mes."/><button class="system-submit" data-system-submit><T en="START 7-DAY TRIAL" it="INIZIA PROVA DI 7 GIORNI" fr="COMMENCER L’ESSAI" es="EMPEZAR PRUEBA"/></button><div class="system-result" data-system-result hidden><T as="strong" en="TRIAL PLAN READY" it="PIANO DI PROVA PRONTO" fr="OFFRE D’ESSAI PRÊTE" es="PLAN DE PRUEBA LISTO"/><T as="p" en="Review personal details, preferred start date, and club access before activation." it="Rivedi dati personali, data di inizio e accesso al club prima dell’attivazione." fr="Vérifiez vos coordonnées, la date de début et l’accès au club." es="Revisa datos, fecha de inicio y acceso al club."/><button data-content-href={showcaseExtraHref('kinetic-fitness-club','membership-activation')}><T en="COMPLETE MEMBERSHIP" it="COMPLETA ABBONAMENTO" fr="FINALISER L’ABONNEMENT" es="COMPLETAR MEMBRESÍA"/> →</button></div></aside></div>
</main> : section==='classes' ? <main class="kt-class-page" data-class-schedule>
  <header><T en="LIVE CLASS SCHEDULE" it="CALENDARIO CORSI LIVE" fr="PLANNING DES COURS" es="HORARIO DE CLASES"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>
  <nav><button class="active" data-class-day="0"><T en="Today" it="Oggi" fr="Aujourd’hui" es="Hoy"/></button><button data-class-day="1"><T en="Tomorrow" it="Domani" fr="Demain" es="Mañana"/></button><button data-class-day="2"><T en="This weekend" it="Weekend" fr="Ce week-end" es="Este fin de semana"/></button></nav>
  <section>{classes.map(item=><article><time>{item.time}</time><div><T as="small" {...item.goal}/><h2>{item.name}</h2><p><T en="Coach" it="Coach" fr="Coach" es="Entrenador"/> {item.coach} · 45 MIN</p></div><strong>{item.spots==='WAIT'?<T en="WAITLIST" it="LISTA D’ATTESA" fr="LISTE D’ATTENTE" es="LISTA DE ESPERA"/>:<>{item.spots} <T en="SPOTS LEFT" it="POSTI RIMASTI" fr="PLACES RESTANTES" es="PLAZAS DISPONIBLES"/></>}</strong><button data-content-href={showcaseExtraHref('kinetic-fitness-club',`class-${item.name.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`)}><T en="Book class" it="Prenota corso" fr="Réserver" es="Reservar"/> →</button></article>)}</section>
</main> : <main class="kt-performance-page">
  <header><T en="MEMBER PERFORMANCE / WEEK 32" it="PERFORMANCE MEMBRO / SETTIMANA 32" fr="PERFORMANCE MEMBRE / SEMAINE 32" es="RENDIMIENTO / SEMANA 32"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>
  <section class="kt-performance-summary"><article><T en="Readiness" it="Prontezza" fr="Préparation" es="Preparación"/><strong>84</strong><i style="--p:84%"></i></article><article><T en="Training load" it="Carico di allenamento" fr="Charge d’entraînement" es="Carga de entrenamiento"/><strong>612</strong><i style="--p:71%"></i></article><article><T en="Recovery" it="Recupero" fr="Récupération" es="Recuperación"/><strong>92%</strong><i style="--p:92%"></i></article></section>
  <section class="kt-performance-chart"><header><T en="Four-week load trend" it="Andamento carico di quattro settimane" fr="Tendance de charge sur quatre semaines" es="Tendencia de carga de cuatro semanas"/><button data-performance-export><T en="Export data" it="Esporta dati" fr="Exporter" es="Exportar"/> ↓</button></header><div>{[52,68,61,82,74,90,77,86].map((value,index)=><i style={`--h:${value}%`}><span>W{index+1}</span></i>)}</div></section>
  <section class="kt-performance-log">{concept.cards.map((card,index)=><article><span>0{index+1}</span><T as="h2" {...card.title}/><T as="p" {...card.text}/><strong>{card.meta}</strong></article>)}</section>
</main>}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-class-day]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-class-day]').forEach(item=>item.classList.remove('active'));button.classList.add('active');const offset=Number(button.dataset.classDay)||0;document.querySelectorAll<HTMLElement>('.kt-class-page article time').forEach((time,index)=>{const base=[7,12,18,20][index]||7;const minutes=offset===1?30:0;time.textContent=`${String((base+offset)%24).padStart(2,'0')}:${String(minutes).padStart(2,'0')}`})}));
  document.querySelector<HTMLButtonElement>('[data-performance-export]')?.addEventListener('click',()=>{const csv='week,load\n1,52\n2,68\n3,61\n4,82\n5,74\n6,90\n7,77\n8,86';const url=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));const link=document.createElement('a');link.href=url;link.download='kinetic-performance.csv';link.click();URL.revokeObjectURL(url)});
</script>
