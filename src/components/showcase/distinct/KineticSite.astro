---
import T from '../ShowcaseText.astro'; import type { AdvancedConcept } from '../../../data/advancedShowcases'; interface Props{concept:AdvancedConcept;section?:string} const{concept,section=''}=Astro.props; const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="kt-home"><section class="kt-hero"><div class="kt-hero__type"><span>KINETIC / PERFORMANCE CLUB</span><T as="h1" en="MOVE. MEASURE. REPEAT." it="MUOVI. MISURA. RIPETI." fr="BOUGEZ. MESUREZ. RECOMMENCEZ." es="MUÉVETE. MIDE. REPITE."/><T as="p" {...concept.intro}/><a href="/showcase/kinetic-fitness-club/membership/"><T en="BUILD YOUR PLAN" it="CREA IL TUO PIANO" fr="CRÉER VOTRE PLAN" es="CREA TU PLAN"/> ↗</a></div><div class="kt-hero__image"><img src={concept.image} alt="Modern performance gym"/><div class="kt-pulse"><b>84</b><span><T en="READINESS" it="PRONTEZZA" fr="PRÉPARATION" es="PREPARACIÓN"/></span></div></div></section><section class="kt-now"><header><b><T en="TODAY AT KINETIC" it="OGGI DA KINETIC" fr="AUJOURD’HUI" es="HOY EN KINETIC"/></b><span>LIVE CAPACITY / MILANO 01</span></header>{[['07:00','FOUNDATIONS','04'],['12:30','ENGINE 30','02'],['18:30','VELOCITY','WAIT'],['20:00','RESET LAB','08']].map(row=><article><time>{row[0]}</time><strong>{row[1]}</strong><div><i></i><span>{row[2]} SPOTS</span></div><button>BOOK +</button></article>)}</section><section class="kt-metrics"><div><span>WEEK 32</span><strong>4.8</strong><small>SESSIONS / WEEK</small></div><div><span>LOAD BALANCE</span><strong>92%</strong><small>OPTIMAL RANGE</small></div><div><span>RECOVERY</span><strong>+14</strong><small>VS LAST MONTH</small></div></section></main> : section==='membership' ? <main class="kt-builder" data-advanced-tool="fitness"><header><span>MEMBERSHIP STUDIO / LIVE</span><T as="h1" en="Pay for the way you actually train." it="Paga per come ti alleni davvero." fr="Payez pour votre vraie façon de vous entraîner." es="Paga por cómo entrenas de verdad."/><T as="p" {...page.intro}/></header><div class="kt-builder__body"><section><h2>01 / BASE</h2><div class="system-options"><button class="system-option active" data-choice="69"><strong>OPEN GYM</strong><small>06:00—23:00 · €69</small></button><button class="system-option" data-choice="99"><strong>UNLIMITED</strong><small>ALL CLASSES · €99</small></button></div><h2>02 / LAYERS</h2><div class="system-options"><button class="system-option" data-choice="45"><strong>1:1 COACH</strong><small>+ €45</small></button><button class="system-option" data-choice="25"><strong>RECOVERY</strong><small>+ €25</small></button><button class="system-option" data-choice="18"><strong>NUTRITION</strong><small>+ €18</small></button></div></section><aside><span>YOUR MONTH</span><strong data-system-total>€69</strong><div class="kt-bar"><i></i><i></i><i></i><i></i><i></i></div><T as="p" en="Cancel or reconfigure monthly. No joining fee in this concept." it="Annulla o riconfigura ogni mese. Nessun costo di iscrizione nel concept." fr="Annulez ou reconfigurez chaque mois." es="Cancela o reconfigura cada mes."/><button class="system-submit" data-system-submit><T en="START 7-DAY TRIAL" it="INIZIA PROVA DI 7 GIORNI" fr="COMMENCER L’ESSAI" es="EMPEZAR PRUEBA"/></button><div class="system-result" data-system-result hidden><strong>TRIAL PLAN READY</strong></div></aside></div></main> : <main class="kt-program"><header><span>{section?.toUpperCase()} / KINETIC</span><T as="h1" {...page.title}/></header><section class="kt-program__grid">{concept.cards.map((card,index)=><article><b>0{index+1}</b><div class="kt-ring" style={`--p:${72+index*8}%`}><span>{72+index*8}</span></div><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/><strong>{card.meta}</strong></article>)}</section><footer><T {...page.intro}/><a href="/showcase/kinetic-fitness-club/membership/">BUILD MEMBERSHIP →</a></footer></main>}
