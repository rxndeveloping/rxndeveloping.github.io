---
import T from '../ShowcaseText.astro';
import type { AdvancedConcept } from '../../../data/advancedShowcases';
import { showcaseCardHref } from '../../../data/showcaseContent';
interface Props{concept:AdvancedConcept;section?:string}
const{concept,section=''}=Astro.props;
const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="nc-home">
  <section class="nc-welcome"><div><span>NOVACARE / BOLOGNA</span><T as="h1" {...concept.headline}/><T as="p" {...concept.intro}/><div class="nc-search"><span>⌕</span><T en="What can we help you with?" it="Come possiamo aiutarti?" fr="Comment pouvons-nous vous aider ?" es="¿Cómo podemos ayudarte?"/><a href="/showcase/novacare-clinic/care-finder/"><T en="START" it="INIZIA" fr="COMMENCER" es="EMPEZAR"/> →</a></div></div><img src={concept.image} alt="Medical consultation"/></section>
  <section class="nc-quick"><a href="/showcase/novacare-clinic/appointments/"><b>01</b><T en="Book an appointment" it="Prenota una visita" fr="Prendre rendez-vous" es="Reservar una cita"/><T en="Available today →" it="Disponibile oggi →" fr="Disponible aujourd’hui →" es="Disponible hoy →"/></a><a href="/showcase/novacare-clinic/specialists/"><b>02</b><T en="Find a specialist" it="Trova uno specialista" fr="Trouver un spécialiste" es="Buscar especialista"/><T en="32 clinical profiles →" it="32 profili clinici →" fr="32 profils cliniques →" es="32 perfiles clínicos →"/></a><a href="/showcase/novacare-clinic/care-finder/"><b>03</b><T en="Find the right care" it="Trova il percorso" fr="Trouver le bon soin" es="Encontrar atención"/><T en="Guided in 60 seconds →" it="Guidato in 60 secondi →" fr="Guidé en 60 secondes →" es="Guiado en 60 segundos →"/></a></section>
  <section class="nc-today"><header><T en="TODAY’S AVAILABILITY" it="DISPONIBILITÀ DI OGGI" fr="DISPONIBILITÉ DU JOUR" es="DISPONIBILIDAD DE HOY"/><T as="b" en="UPDATED 2 MIN AGO" it="AGGIORNATO 2 MIN FA" fr="MIS À JOUR IL Y A 2 MIN" es="ACTUALIZADO HACE 2 MIN"/></header>{concept.cards.map((card,index)=><article><div><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/></div><strong>{index===0?<T en="NEXT: TODAY 16:40" it="PROSSIMO: OGGI 16:40" fr="PROCHAIN : AUJ. 16:40" es="PRÓXIMO: HOY 16:40"/>:index===1?<T en="NEXT: TOMORROW" it="PROSSIMO: DOMANI" fr="PROCHAIN : DEMAIN" es="PRÓXIMO: MAÑANA"/>:<T en="VIDEO AVAILABLE" it="VIDEO DISPONIBILE" fr="VIDÉO DISPONIBLE" es="VIDEO DISPONIBLE"/>}</strong><button data-content-href={showcaseCardHref('novacare-clinic',card.title.en,index)}><T en="VIEW TEAM" it="VEDI TEAM" fr="VOIR L’ÉQUIPE" es="VER EQUIPO"/></button></article>)}</section>
</main> : section==='care-finder' ? <main class="nc-finder" data-advanced-tool="clinic">
  <aside><T en="CARE FINDER" it="TROVA PERCORSO" fr="ORIENTATION" es="ORIENTACIÓN"/><T as="b" en="01 — NEED" it="01 — ESIGENZA" fr="01 — BESOIN" es="01 — NECESIDAD"/><T as="b" en="02 — CONTEXT" it="02 — CONTESTO" fr="02 — CONTEXTE" es="02 — CONTEXTO"/><T as="b" en="03 — FORMAT" it="03 — FORMATO" fr="03 — FORMAT" es="03 — FORMATO"/><T as="b" en="04 — MATCH" it="04 — RISULTATO" fr="04 — RÉSULTAT" es="04 — RESULTADO"/><T as="small" en="This guide does not provide a diagnosis or emergency advice." it="La guida non fornisce diagnosi o assistenza d’emergenza." fr="Ce guide ne fournit pas de diagnostic." es="Esta guía no proporciona diagnóstico."/></aside>
  <section><T as="h1" en="What would you like help with?" it="Per cosa cerchi supporto?" fr="Pour quoi cherchez-vous de l’aide ?" es="¿Con qué necesitas ayuda?"/><T as="p" {...page.intro}/><div class="nc-finder__choices system-options"><button class="system-option" data-choice="cardiology"><b>♡</b><T as="strong" en="Heart & circulation" it="Cuore e circolazione" fr="Cœur et circulation" es="Corazón y circulación"/></button><button class="system-option" data-choice="movement"><b>↗</b><T as="strong" en="Movement & pain" it="Movimento e dolore" fr="Mouvement et douleur" es="Movimiento y dolor"/></button><button class="system-option" data-choice="sleep"><b>◐</b><T as="strong" en="Sleep & stress" it="Sonno e stress" fr="Sommeil et stress" es="Sueño y estrés"/></button><button class="system-option" data-choice="general"><b>+</b><T as="strong" en="General orientation" it="Orientamento generale" fr="Orientation générale" es="Orientación general"/></button></div><div class="nc-match"><T en="RECOMMENDED PATH" it="PERCORSO CONSIGLIATO" fr="PARCOURS CONSEILLÉ" es="RUTA RECOMENDADA"/><strong data-system-total>—</strong><button class="system-submit" data-system-submit><T en="SHOW AVAILABLE TEAM" it="MOSTRA IL TEAM DISPONIBILE" fr="VOIR L’ÉQUIPE" es="VER EQUIPO"/> →</button><div class="system-result" data-system-result hidden><T as="strong" en="NEXT SLOT / TODAY 16:40" it="PROSSIMO ORARIO / OGGI 16:40" fr="PROCHAIN CRÉNEAU / AUJ. 16:40" es="PRÓXIMA CITA / HOY 16:40"/><button data-content-href={showcaseCardHref('novacare-clinic',concept.cards[0].title.en,0)}><T en="OPEN MATCHED PROFILE" it="APRI PROFILO TROVATO" fr="OUVRIR LE PROFIL" es="ABRIR PERFIL"/> →</button></div></div></section>
</main> : section==='appointments' ? <main class="nc-appointment-page" data-nc-appointment>
  <header><T en="APPOINTMENT BOOKING / DEMO" it="PRENOTAZIONE VISITA / DEMO" fr="PRISE DE RENDEZ-VOUS / DÉMO" es="RESERVA DE CITA / DEMO"/><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header>
  <form><section><h2><T en="01 / Service" it="01 / Servizio" fr="01 / Service" es="01 / Servicio"/></h2><label><input type="radio" name="service" checked/><span><b>♡</b><T as="strong" en="Cardiology consultation" it="Visita cardiologica" fr="Consultation cardiologique" es="Consulta cardiológica"/><small>45 MIN · €120</small></span></label><label><input type="radio" name="service"/><span><b>↗</b><T as="strong" en="Sports medicine" it="Medicina sportiva" fr="Médecine du sport" es="Medicina deportiva"/><small>50 MIN · €95</small></span></label><label><input type="radio" name="service"/><span><b>◐</b><T as="strong" en="Sleep consultation" it="Visita del sonno" fr="Consultation sommeil" es="Consulta del sueño"/><small>60 MIN · €110</small></span></label></section><section><h2><T en="02 / Date and time" it="02 / Data e orario" fr="02 / Date et heure" es="02 / Fecha y hora"/></h2><label class="date"><T en="Preferred date" it="Data preferita" fr="Date souhaitée" es="Fecha preferida"/><input type="date" required value="2026-09-18"/></label><div class="nc-time-grid"><label><input type="radio" name="time" checked/><span>09:20</span></label><label><input type="radio" name="time"/><span>11:40</span></label><label><input type="radio" name="time"/><span>16:40</span></label><label><input type="radio" name="time"/><span>18:10</span></label></div><label class="date"><T en="Visit format" it="Formato visita" fr="Format de visite" es="Formato de consulta"/><select><option>IN CLINIC</option><option>VIDEO</option></select></label></section><aside><T en="APPOINTMENT SUMMARY" it="RIEPILOGO VISITA" fr="RÉCAPITULATIF" es="RESUMEN DE CITA"/><strong>18 SEP · 09:20</strong><T as="p" en="You can review and change the selection before confirming. No real booking is created." it="Puoi rivedere e cambiare la selezione prima di confermare. Non viene creata alcuna prenotazione reale." fr="Vous pouvez modifier la sélection avant confirmation. Aucun rendez-vous réel n’est créé." es="Puedes cambiar la selección antes de confirmar. No se crea ninguna cita real."/><button type="submit"><T en="REVIEW APPOINTMENT" it="RIVEDI APPUNTAMENTO" fr="VÉRIFIER LE RENDEZ-VOUS" es="REVISAR CITA"/> →</button><output hidden><T en="Demo appointment prepared." it="Appuntamento dimostrativo preparato." fr="Rendez-vous de démonstration préparé." es="Cita de demostración preparada."/></output></aside></form>
</main> : <main class="nc-directory">
  <header><span>{section?.toUpperCase()} / NOVACARE</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><div class="nc-directory__filters" data-nc-filters><label><T en="Area" it="Area" fr="Domaine" es="Área"/><select data-filter-key="area"><option value="all"><T en="All areas" it="Tutte le aree" fr="Tous les domaines" es="Todas las áreas"/></option><option value="cardiology"><T en="Cardiology" it="Cardiologia" fr="Cardiologie" es="Cardiología"/></option><option value="movement"><T en="Movement" it="Movimento" fr="Mouvement" es="Movimiento"/></option><option value="sleep"><T en="Sleep" it="Sonno" fr="Sommeil" es="Sueño"/></option></select></label><label><T en="Language" it="Lingua" fr="Langue" es="Idioma"/><select data-filter-key="language"><option value="all"><T en="Any language" it="Qualsiasi lingua" fr="Toutes langues" es="Cualquier idioma"/></option><option value="italian"><T en="Italian" it="Italiano" fr="Italien" es="Italiano"/></option><option value="english"><T en="English" it="Inglese" fr="Anglais" es="Inglés"/></option></select></label><label><T en="Format" it="Formato" fr="Format" es="Formato"/><select data-filter-key="format"><option value="all"><T en="Any format" it="Qualsiasi formato" fr="Tous formats" es="Cualquier formato"/></option><option value="clinic"><T en="In clinic" it="In clinica" fr="En clinique" es="En clínica"/></option><option value="video"><T en="Video" it="Video" fr="Vidéo" es="Vídeo"/></option></select></label></div><section data-nc-results>{concept.cards.map((card,index)=><article data-area={['cardiology','movement','sleep'][index]} data-language={index===2?'english':'italian'} data-format={index===2?'video':'clinic'}><div class="nc-avatar">DR<br/>0{index+1}</div><div><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/></div><strong>{index===0?<T en="TODAY 16:40" it="OGGI 16:40" fr="AUJ. 16:40" es="HOY 16:40"/>:index===1?<T en="TOMORROW" it="DOMANI" fr="DEMAIN" es="MAÑANA"/>:<T en="VIDEO AVAILABLE" it="VIDEO DISPONIBILE" fr="VIDÉO DISPONIBLE" es="VIDEO DISPONIBLE"/>}</strong><button data-content-href={showcaseCardHref('novacare-clinic',card.title.en,index)}><T en="DETAILS" it="DETTAGLI" fr="DÉTAILS" es="DETALLES"/> →</button></article>)}</section>
</main>}
<script>
  document.querySelector<HTMLFormElement>('[data-nc-appointment] form')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const output=form.querySelector<HTMLOutputElement>('output');if(output)output.hidden=false});
  const filterRoot=document.querySelector<HTMLElement>('[data-nc-filters]');
  const applyFilters=()=>{const values=Object.fromEntries([...filterRoot?.querySelectorAll<HTMLSelectElement>('select')||[]].map(select=>[select.dataset.filterKey||'',select.value]));document.querySelectorAll<HTMLElement>('[data-nc-results] article').forEach(card=>{card.hidden=Object.entries(values).some(([key,value])=>value!=='all'&&card.dataset[key]!==value)})};
  filterRoot?.querySelectorAll('select').forEach(select=>select.addEventListener('change',applyFilters));
</script>
