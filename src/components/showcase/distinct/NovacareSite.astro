---
import T from '../ShowcaseText.astro'; import type { AdvancedConcept } from '../../../data/advancedShowcases'; interface Props{concept:AdvancedConcept;section?:string} const{concept,section=''}=Astro.props; const page=concept.pages.find(p=>p.slug===section);
---
{!page ? <main class="nc-home"><section class="nc-welcome"><div><span>NOVACARE / BOLOGNA</span><T as="h1" {...concept.headline}/><T as="p" {...concept.intro}/><div class="nc-search"><span>⌕</span><T en="What can we help you with?" it="Come possiamo aiutarti?" fr="Comment pouvons-nous vous aider ?" es="¿Cómo podemos ayudarte?"/><a href="/showcase/novacare-clinic/care-finder/">START →</a></div></div><img src={concept.image} alt="Medical consultation"/></section><section class="nc-quick"><a href="/showcase/novacare-clinic/appointments/"><b>01</b><T en="Book an appointment" it="Prenota una visita" fr="Prendre rendez-vous" es="Reservar una cita"/><span>Available today →</span></a><a href="/showcase/novacare-clinic/specialists/"><b>02</b><T en="Find a specialist" it="Trova uno specialista" fr="Trouver un spécialiste" es="Buscar especialista"/><span>32 clinical profiles →</span></a><a href="/showcase/novacare-clinic/care-finder/"><b>03</b><T en="Find the right care" it="Trova il percorso" fr="Trouver le bon soin" es="Encontrar atención"/><span>Guided in 60 seconds →</span></a></section><section class="nc-today"><header><span><T en="TODAY’S AVAILABILITY" it="DISPONIBILITÀ DI OGGI" fr="DISPONIBILITÉ DU JOUR" es="DISPONIBILIDAD DE HOY"/></span><b>UPDATED 2 MIN AGO</b></header>{concept.cards.map(card=><article><div><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/></div><strong>{card.meta}</strong><button>VIEW TEAM</button></article>)}</section></main> : section==='care-finder' ? <main class="nc-finder" data-advanced-tool="clinic"><aside><span>CARE FINDER</span><b>01 — NEED</b><b>02 — CONTEXT</b><b>03 — FORMAT</b><b>04 — MATCH</b><small><T en="This guide does not provide a diagnosis or emergency advice." it="La guida non fornisce diagnosi o assistenza d’emergenza." fr="Ce guide ne fournit pas de diagnostic." es="Esta guía no proporciona diagnóstico."/></small></aside><section><T as="h1" en="What would you like help with?" it="Per cosa cerchi supporto?" fr="Pour quoi cherchez-vous de l’aide ?" es="¿Con qué necesitas ayuda?"/><T as="p" {...page.intro}/><div class="nc-finder__choices system-options"><button class="system-option" data-choice="cardiology"><b>♡</b><strong><T en="Heart & circulation" it="Cuore e circolazione" fr="Cœur et circulation" es="Corazón y circulación"/></strong></button><button class="system-option" data-choice="movement"><b>↗</b><strong><T en="Movement & pain" it="Movimento e dolore" fr="Mouvement et douleur" es="Movimiento y dolor"/></strong></button><button class="system-option" data-choice="sleep"><b>◐</b><strong><T en="Sleep & stress" it="Sonno e stress" fr="Sommeil et stress" es="Sueño y estrés"/></strong></button><button class="system-option" data-choice="general"><b>+</b><strong><T en="General orientation" it="Orientamento generale" fr="Orientation générale" es="Orientación general"/></strong></button></div><div class="nc-match"><span>RECOMMENDED PATH</span><strong data-system-total>—</strong><button class="system-submit" data-system-submit><T en="SHOW AVAILABLE TEAM" it="MOSTRA IL TEAM DISPONIBILE" fr="VOIR L’ÉQUIPE" es="VER EQUIPO"/> →</button><div class="system-result" data-system-result hidden><strong>NEXT SLOT / TODAY 16:40</strong></div></div></section></main> : <main class="nc-directory"><header><span>{section?.toUpperCase()} / NOVACARE</span><T as="h1" {...page.title}/><T as="p" {...page.intro}/></header><div class="nc-directory__filters"><button>AREA ▾</button><button>LANGUAGE ▾</button><button>FORMAT ▾</button><button>EARLIEST FIRST</button></div><section>{concept.cards.map((card,index)=><article><div class="nc-avatar">DR<br/>0{index+1}</div><div><small>{card.eyebrow}</small><T as="h2" {...card.title}/><T as="p" {...card.text}/></div><strong>{card.meta}</strong><button>DETAILS →</button></article>)}</section></main>}
