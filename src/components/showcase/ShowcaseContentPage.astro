---
import ShowcaseShell from '../../layouts/ShowcaseShell.astro';
import T from './ShowcaseText.astro';
import { advancedShowcases } from '../../data/advancedShowcases';
import { expansionBySlug } from '../../data/showcaseExpansion';
import { relatedContentFor, type ShowcaseContentRecord } from '../../data/showcaseContent';

interface Props { record: ShowcaseContentRecord }
const { record } = Astro.props;
const site = expansionBySlug(record.concept);
const advanced = advancedShowcases.find((item) => item.slug === record.concept);
if (!site) throw new Error(`Missing showcase site: ${record.concept}`);
const baseNav = advanced
  ? advanced.pages.map((item) => ({ href: `/showcase/${record.concept}/${item.slug}/`, label: item.label }))
  : site.pages.map((item) => ({ href: `/showcase/${record.concept}/${item.slug}/`, label: item.label }));
const nav = [{ href: `/showcase/${record.concept}/`, label: { en:'Home',it:'Home',fr:'Accueil',es:'Inicio' } }, ...baseNav];
const sourcePage = site.pages.find((item) => item.slug === record.section);
const sourceHref = sourcePage ? `/showcase/${record.concept}/${record.section}/` : `/showcase/${record.concept}/`;
const related = relatedContentFor(record);
const operational = ['booking','plan','event'].includes(record.kind);
const isProfile = ['profile','roster'].includes(record.kind);
const isCase = record.kind === 'case-study';
const isTechnical = ['report','control'].includes(record.kind);
const isArticle = record.kind === 'article';
---
<ShowcaseShell title={`${record.title.en} — ${site.brand}`} description={record.intro.en} brand={site.brand} variant={site.variant as any} home={`/showcase/${record.concept}/`} nav={nav} cta={{href:sourceHref,label:{en:'Back to section',it:'Torna alla sezione',fr:'Retour à la section',es:'Volver a la sección'}}}>
  <article class={`content-detail content-detail--${record.kind}`} data-content-page>
    <nav class="content-detail__crumbs" aria-label="Breadcrumb">
      <a href={`/showcase/${record.concept}/`}>{site.brand}</a><span>/</span>
      <a href={sourceHref}>{sourcePage ? <T {...sourcePage.label}/> : record.section.replaceAll('-',' ')}</a><span>/</span>
      <strong><T {...record.title}/></strong>
    </nav>

    <header class="content-detail__hero">
      <div>
        <span class="content-detail__kind">{record.kind.replaceAll('-',' ')} / {String(record.index + 1).padStart(2,'0')}</span>
        <T as="h1" {...record.title}/>
        <T as="p" {...record.intro}/>
        <T as="strong" {...record.meta}/>
      </div>
      <figure><img src={record.image || site.image} alt=""/><figcaption>{site.brand} / {record.section.toUpperCase()}</figcaption></figure>
    </header>

    {isArticle && <>
      <section class="content-story content-story--opening">
        <aside><span>01</span><T as="strong" en="The starting point" it="Il punto di partenza" fr="Le point de départ" es="El punto de partida"/></aside>
        <div><T as="h2" en="A subject worth looking at closely." it="Un tema che merita uno sguardo più attento." fr="Un sujet qui mérite un regard attentif." es="Un tema que merece una mirada más atenta."/><T as="p" en={`This story begins with ${record.title.en.toLowerCase()}: not as a slogan, but as a practical choice that influences people, materials, timing, and the final experience.`} it={`Questa storia parte da ${record.title.it.toLowerCase()}: non come slogan, ma come scelta concreta che influenza persone, materiali, tempi ed esperienza finale.`} fr={`Cette histoire part de ${record.title.fr.toLowerCase()} : non comme un slogan, mais comme un choix concret qui influence les personnes, les matières, le temps et l’expérience finale.`} es={`Esta historia parte de ${record.title.es.toLowerCase()}: no como eslogan, sino como una elección práctica que influye en las personas, los materiales, los tiempos y la experiencia final.`}/><T as="p" {...record.intro}/></div>
      </section>
      <section class="content-story content-story--feature">
        <figure><img src={record.image || site.image} alt="" loading="lazy"/></figure>
        <div><span>02 / FIELD NOTES</span><T as="h2" en="Decisions become a method." it="Le decisioni diventano un metodo." fr="Les décisions deviennent une méthode." es="Las decisiones se convierten en método."/><T as="p" en="The work is documented from the first observation to the final review. Each step is tested against quality, usefulness, and the effect it has on the wider system." it="Il lavoro viene documentato dalla prima osservazione alla revisione finale. Ogni passaggio viene valutato per qualità, utilità ed effetto sul sistema complessivo." fr="Le travail est documenté de la première observation à la révision finale. Chaque étape est évaluée selon sa qualité, son utilité et son effet sur l’ensemble du système." es="El trabajo se documenta desde la primera observación hasta la revisión final. Cada paso se evalúa por su calidad, utilidad y efecto sobre el sistema completo."/></div>
      </section>
      <section class="content-quote"><T as="blockquote" en="The most useful stories do more than describe an outcome: they make the choices behind it visible." it="Le storie più utili non descrivono soltanto un risultato: rendono visibili le scelte che lo hanno costruito." fr="Les récits les plus utiles ne décrivent pas seulement un résultat : ils rendent visibles les choix qui l’ont construit." es="Las historias más útiles no solo describen un resultado: hacen visibles las decisiones que lo construyeron."/><span>{record.meta.en}</span></section>
    </>}

    {isProfile && <>
      <section class="content-profile">
        <div class="content-profile__identity"><span>PROFILE / VERIFIED</span><T as="h2" {...record.title}/><T as="p" {...record.intro}/><dl><div><dt><T en="Specialism" it="Specialità" fr="Spécialité" es="Especialidad"/></dt><dd><T {...record.meta}/></dd></div><div><dt><T en="Availability" it="Disponibilità" fr="Disponibilité" es="Disponibilidad"/></dt><dd><T en="Open for selected sessions" it="Disponibile per sessioni selezionate" fr="Disponible pour certaines sessions" es="Disponible para sesiones seleccionadas"/></dd></div><div><dt><T en="Languages" it="Lingue" fr="Langues" es="Idiomas"/></dt><dd>IT / EN / FR / ES</dd></div></dl></div>
        <aside><span>01</span><T as="h3" en="Working approach" it="Metodo di lavoro" fr="Méthode de travail" es="Método de trabajo"/><T as="p" en="Every engagement starts with context, a clear objective, and a shared definition of progress. The profile is evaluated through practical work rather than generic labels." it="Ogni collaborazione parte dal contesto, da un obiettivo chiaro e da una definizione condivisa del progresso. Il profilo viene raccontato attraverso il lavoro concreto, non tramite etichette generiche." fr="Chaque collaboration commence par le contexte, un objectif clair et une définition commune du progrès. Le profil est présenté par le travail concret, non par des étiquettes génériques." es="Cada colaboración parte del contexto, un objetivo claro y una definición compartida del progreso. El perfil se explica mediante trabajo real, no etiquetas genéricas."/></aside>
      </section>
      <section class="content-profile__grid">{['01','02','03'].map((number,index)=><article><span>{number}</span><T as="h3" en={['Background','Current focus','Selected contribution'][index]} it={['Esperienza','Focus attuale','Contributo selezionato'][index]} fr={['Parcours','Priorité actuelle','Contribution sélectionnée'][index]} es={['Experiencia','Enfoque actual','Contribución seleccionada'][index]}/><T as="p" en="A structured overview with concrete responsibilities, current priorities, and the standards used to evaluate the work." it="Una panoramica strutturata con responsabilità concrete, priorità attuali e criteri usati per valutare il lavoro." fr="Une vue structurée des responsabilités, priorités actuelles et critères d’évaluation du travail." es="Una visión estructurada con responsabilidades, prioridades actuales y criterios para evaluar el trabajo."/></article>)}</section>
    </>}

    {isCase && <>
      <section class="content-case__summary"><div><span>01 / CONTEXT</span><T as="h2" en="The challenge" it="La sfida" fr="Le défi" es="El reto"/><T as="p" en={`The ${record.title.en} programme started with fragmented information, manual coordination, and no reliable view of the complete process.`} it={`Il progetto ${record.title.it} partiva da informazioni frammentate, coordinamento manuale e nessuna vista affidabile del processo completo.`} fr={`Le projet ${record.title.fr} partait d’informations fragmentées, d’une coordination manuelle et d’aucune vue fiable du processus complet.`} es={`El proyecto ${record.title.es} partía de información fragmentada, coordinación manual y ninguna visión fiable del proceso completo.`}/></div><dl><div><dt><T en="Scope" it="Ambito" fr="Périmètre" es="Alcance"/></dt><dd>12 <T en="weeks" it="settimane" fr="semaines" es="semanas"/></dd></div><div><dt><T en="Workstreams" it="Aree di lavoro" fr="Chantiers" es="Áreas de trabajo"/></dt><dd>04</dd></div><div><dt><T en="Outcome" it="Risultato" fr="Résultat" es="Resultado"/></dt><dd><T {...record.meta}/></dd></div></dl></section>
      <section class="content-case__timeline">{['Discovery','System design','Pilot and measurement'].map((label,index)=><article><span>0{index+1}</span><h3>{label}</h3><T as="p" en="Interviews, current-state mapping, rapid prototypes, documented decisions, and measurable acceptance criteria shaped this phase." it="Interviste, mappatura dello stato attuale, prototipi rapidi, decisioni documentate e criteri misurabili hanno guidato questa fase." fr="Entretiens, cartographie, prototypes rapides, décisions documentées et critères mesurables ont guidé cette phase." es="Entrevistas, mapeo, prototipos rápidos, decisiones documentadas y criterios medibles guiaron esta fase."/></article>)}</section>
      <section class="content-case__result"><span>RESULT / 01</span><T as="h2" en="A system the team can understand and operate." it="Un sistema che il team può comprendere e gestire." fr="Un système que l’équipe peut comprendre et exploiter." es="Un sistema que el equipo puede entender y operar."/><div><strong>−38%</strong><T en="manual coordination" it="coordinamento manuale" fr="coordination manuelle" es="coordinación manual"/><strong>+24%</strong><T en="process visibility" it="visibilità del processo" fr="visibilité du processus" es="visibilidad del proceso"/><strong>3×</strong><T en="faster reporting" it="report più rapido" fr="reporting plus rapide" es="informes más rápidos"/></div></section>
    </>}

    {isTechnical && <>
      <section class="content-control__status"><div><i></i><T as="strong" en="Verified in the demonstration environment" it="Verificato nell’ambiente dimostrativo" fr="Vérifié dans l’environnement de démonstration" es="Verificado en el entorno de demostración"/></div><time>LAST REVIEW / 24 AUG 2026</time></section>
      <section class="content-control__grid">{['Architecture','Evidence','Recovery'].map((label,index)=><article><span>0{index+1}</span><h2>{label}</h2><T as="p" en="The control has a named owner, explicit boundaries, observable signals, and a repeatable verification procedure." it="Il controllo ha un responsabile, confini espliciti, segnali osservabili e una procedura di verifica ripetibile." fr="Le contrôle possède un responsable, des limites explicites, des signaux observables et une procédure de vérification répétable." es="El control tiene responsable, límites explícitos, señales observables y un procedimiento de verificación repetible."/><dl><div><dt>STATUS</dt><dd>PASS</dd></div><div><dt>EVIDENCE</dt><dd>12 ITEMS</dd></div></dl></article>)}</section>
      <section class="content-control__log"><header><T en="Verification log" it="Registro verifiche" fr="Journal de vérification" es="Registro de verificación"/><span>LIVE / DEMO</span></header>{['Boundary check completed','Access policy reviewed','Recovery test recorded','Evidence package signed'].map((entry,index)=><div><time>09:{12+index*7}</time><span>{entry}</span><b>✓ PASS</b></div>)}</section>
    </>}

    {!isArticle && !isProfile && !isCase && !isTechnical && !operational && <>
      <section class="content-product__overview"><div><span>01 / OVERVIEW</span><T as="h2" en="The complete view, not just a card." it="La visione completa, non soltanto una scheda." fr="La vue complète, pas seulement une carte." es="La visión completa, no solo una tarjeta."/><T as="p" {...record.intro}/></div><figure><img src={record.image || site.image} alt="" loading="lazy"/></figure></section>
      <section class="content-product__specs">{['Character','What is included','Practical information','Best suited for'].map((label,index)=><article><span>0{index+1}</span><h3>{label}</h3><T as="p" en="Detailed, transparent information designed to help a visitor understand the option before making a decision." it="Informazioni dettagliate e trasparenti per aiutare il visitatore a comprendere l’opzione prima di scegliere." fr="Des informations détaillées et transparentes pour comprendre l’option avant de décider." es="Información detallada y transparente para comprender la opción antes de decidir."/></article>)}</section>
    </>}

    {operational && <section class="content-booking" data-content-booking>
      <div class="content-booking__info"><span>01 / <T en="Review" it="Riepilogo" fr="Récapitulatif" es="Resumen"/></span><T as="h2" {...record.title}/><T as="p" {...record.intro}/><ul><li><T en="Clear selection summary" it="Riepilogo chiaro della selezione" fr="Récapitulatif clair de la sélection" es="Resumen claro de la selección"/></li><li><T en="Flexible date or start preference" it="Preferenza flessibile per data o inizio" fr="Date ou début flexible" es="Fecha o inicio flexible"/></li><li><T en="Review before final confirmation" it="Revisione prima della conferma finale" fr="Vérification avant confirmation" es="Revisión antes de confirmar"/></li></ul></div>
      <form data-content-form novalidate>
        <header><span>02 / <T en="Complete details" it="Completa i dati" fr="Compléter les informations" es="Completa los datos"/></span><T as="h2" en={record.kind==='plan'?'Activate the selected plan.':'Complete the reservation.'} it={record.kind==='plan'?'Attiva il piano selezionato.':'Completa la prenotazione.'} fr={record.kind==='plan'?'Activez l’offre choisie.':'Finalisez la réservation.'} es={record.kind==='plan'?'Activa el plan elegido.':'Completa la reserva.'}/></header>
        <div><label><T en="Full name" it="Nome completo" fr="Nom complet" es="Nombre completo"/><input name="name" required autocomplete="name"/></label><label><T en="Email" it="Email" fr="E-mail" es="Correo electrónico"/><input name="email" type="email" required autocomplete="email"/></label><label><T en="Preferred date" it="Data preferita" fr="Date souhaitée" es="Fecha preferida"/><input name="date" type="date" required/></label><label><T en="Preferred time" it="Orario preferito" fr="Heure souhaitée" es="Hora preferida"/><select name="time"><option>10:00</option><option>14:30</option><option>18:00</option><option>20:30</option></select></label></div>
        <label class="content-booking__notes"><T en="Notes or access requirements" it="Note o necessità di accesso" fr="Notes ou besoins d’accès" es="Notas o necesidades de acceso"/><textarea rows="4"></textarea></label>
        <label class="content-booking__consent"><input type="checkbox" required/><T en="I understand this is a fictional portfolio demonstration." it="Ho capito che questa è una dimostrazione immaginaria del portfolio." fr="Je comprends qu’il s’agit d’une démonstration fictive." es="Entiendo que esta es una demostración ficticia."/></label>
        <button type="submit"><T en="Review and confirm" it="Rivedi e conferma" fr="Vérifier et confirmer" es="Revisar y confirmar"/> →</button>
        <output hidden><strong>✓</strong><T as="b" en="Demonstration request completed" it="Richiesta dimostrativa completata" fr="Demande de démonstration terminée" es="Solicitud de demostración completada"/><T en="No information was transmitted. You can continue exploring the website." it="Nessuna informazione è stata trasmessa. Puoi continuare a esplorare il sito." fr="Aucune information n’a été transmise. Vous pouvez continuer à explorer le site." es="No se transmitió información. Puedes seguir explorando el sitio."/></output>
      </form>
    </section>}

    <section class="content-related">
      <header><span>03 / <T en="Continue exploring" it="Continua a esplorare" fr="Continuer à explorer" es="Seguir explorando"/></span><T as="h2" en="More from this concept." it="Altro da questo concept." fr="Plus de ce concept." es="Más de este concepto."/></header>
      <div>{related.map((item) => <a href={`/showcase/${item.concept}/content/${item.slug}/`}><small>{item.kind.replaceAll('-',' ')}</small><T as="h3" {...item.title}/><T {...item.meta}/><b>↗</b></a>)}</div>
    </section>
  </article>
</ShowcaseShell>

<script>
  document.querySelector<HTMLFormElement>('[data-content-form]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    if (!form.checkValidity()) return;
    const output = form.querySelector<HTMLOutputElement>('output');
    if (output) output.hidden = false;
    form.querySelector<HTMLButtonElement>('button[type="submit"]')?.setAttribute('hidden','');
  });
</script>

<style is:global>
  .content-detail{--cd-line:color-mix(in srgb,currentColor 20%,transparent);--cd-panel:color-mix(in srgb,currentColor 5%,transparent);padding:0 clamp(20px,5vw,84px) 100px;max-width:1900px;margin:auto}.content-detail__crumbs{display:flex;gap:10px;align-items:center;padding:26px 0;border-bottom:1px solid var(--cd-line);font:700 10px/1.4 Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;overflow:auto}.content-detail__crumbs strong{white-space:nowrap}.content-detail__hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.78fr);min-height:650px;border-bottom:1px solid var(--cd-line)}.content-detail__hero>div{display:flex;flex-direction:column;justify-content:center;padding:70px clamp(0px,5vw,80px) 70px 0}.content-detail__kind{font:800 11px/1 Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase}.content-detail__hero h1{font:720 clamp(54px,7vw,112px)/.93 'Inter Variable',Arial,sans-serif;letter-spacing:-.06em;margin:30px 0;max-width:1050px}.content-detail__hero p{font:18px/1.7 'Inter Variable',Arial,sans-serif;max-width:760px;opacity:.72}.content-detail__hero strong{font:750 12px/1.4 Arial,sans-serif;letter-spacing:.1em;margin-top:20px}.content-detail__hero figure{margin:0;position:relative;min-height:520px;overflow:hidden}.content-detail__hero img{width:100%;height:100%;object-fit:cover}.content-detail__hero figcaption{position:absolute;right:18px;bottom:18px;background:#111;color:#fff;padding:10px;font:700 9px Arial,sans-serif;letter-spacing:.12em}.content-story{display:grid;grid-template-columns:.32fr 1fr;gap:clamp(40px,8vw,140px);padding:110px 0;border-bottom:1px solid var(--cd-line)}.content-story aside{display:flex;gap:22px;flex-direction:column}.content-story h2,.content-product__overview h2,.content-case__summary h2,.content-booking h2,.content-related h2{font:680 clamp(38px,5vw,76px)/1 'Inter Variable',Arial,sans-serif;letter-spacing:-.045em;margin:15px 0 35px}.content-story p,.content-product__overview p,.content-case__summary p,.content-profile p{font:18px/1.8 'Inter Variable',Arial,sans-serif;max-width:850px;opacity:.76}.content-story--feature{grid-template-columns:1fr .8fr;align-items:center}.content-story--feature figure{margin:0;min-height:520px}.content-story--feature img{width:100%;height:100%;object-fit:cover}.content-quote{padding:130px clamp(0px,9vw,150px);text-align:center}.content-quote blockquote{font:500 clamp(34px,5vw,70px)/1.12 Georgia,serif;margin:0}.content-quote span{display:block;margin-top:35px;font:700 11px Arial,sans-serif}.content-profile{display:grid;grid-template-columns:1fr .55fr;gap:8vw;padding:100px 0}.content-profile__identity h2{font:700 clamp(50px,7vw,100px)/.95 'Inter Variable',Arial,sans-serif;letter-spacing:-.055em;margin:24px 0}.content-profile dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--cd-line);border:1px solid var(--cd-line);margin-top:50px}.content-profile dl div{padding:22px;background:var(--cd-panel)}.content-profile dt{font:700 10px Arial,sans-serif;text-transform:uppercase}.content-profile dd{margin:12px 0 0;font:600 16px/1.5 'Inter Variable',Arial,sans-serif}.content-profile aside{border-left:1px solid var(--cd-line);padding-left:7vw}.content-profile__grid,.content-case__timeline,.content-product__specs,.content-control__grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--cd-line)}.content-profile__grid article,.content-case__timeline article,.content-control__grid article{padding:clamp(25px,4vw,60px);border-right:1px solid var(--cd-line)}.content-profile__grid article:last-child,.content-case__timeline article:last-child,.content-control__grid article:last-child{border:0}.content-profile__grid h3,.content-case__timeline h3,.content-control__grid h2{font:650 28px/1.1 'Inter Variable',Arial,sans-serif;margin:35px 0 18px}.content-profile__grid p,.content-case__timeline p,.content-control__grid p{font:16px/1.7 'Inter Variable',Arial,sans-serif;opacity:.72}.content-case__summary{display:grid;grid-template-columns:1fr .6fr;gap:8vw;padding:110px 0}.content-case__summary dl{display:grid;gap:1px;background:var(--cd-line);border:1px solid var(--cd-line)}.content-case__summary dl div{background:var(--cd-panel);padding:25px}.content-case__summary dt{font:700 10px Arial,sans-serif}.content-case__summary dd{font:700 24px 'Inter Variable',Arial,sans-serif;margin:12px 0 0}.content-case__result{margin-top:70px;padding:clamp(35px,7vw,100px);background:currentColor}.content-case__result>*{filter:invert(1)}.content-case__result h2{font:680 clamp(42px,6vw,86px)/.95 'Inter Variable',Arial,sans-serif;letter-spacing:-.05em;max-width:1100px}.content-case__result div{display:grid;grid-template-columns:repeat(3,auto 1fr);gap:20px;align-items:end;border-top:1px solid;padding-top:30px}.content-case__result strong{font:750 clamp(35px,5vw,68px) 'Inter Variable',Arial,sans-serif}.content-control__status{display:flex;justify-content:space-between;padding:35px 0;border-bottom:1px solid var(--cd-line)}.content-control__status div{display:flex;gap:12px;align-items:center}.content-control__status i{width:10px;height:10px;border-radius:50%;background:#46d88d;box-shadow:0 0 20px #46d88d}.content-control__grid{margin:75px 0}.content-control__grid dl{display:flex;gap:30px}.content-control__grid dt{font:700 9px Arial}.content-control__grid dd{margin:7px 0;font-weight:800}.content-control__log{border:1px solid var(--cd-line);font:13px/1.4 monospace}.content-control__log header,.content-control__log div{display:grid;grid-template-columns:160px 1fr auto;gap:25px;padding:18px 22px;border-bottom:1px solid var(--cd-line)}.content-control__log header{display:flex;justify-content:space-between}.content-control__log b{color:#46d88d}.content-product__overview{display:grid;grid-template-columns:.8fr 1fr;gap:8vw;align-items:center;padding:110px 0}.content-product__overview figure{margin:0;height:620px}.content-product__overview img{width:100%;height:100%;object-fit:cover}.content-product__specs{grid-t