---
import socials from '../../data/social.json';
import { sitePath } from '../../utils/paths';
const year = new Date().getFullYear();
const isDev = import.meta.env.DEV;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-mark" href={sitePath()}>RxN<span>Developing</span></a>
      <p data-i18n="footer.description">Custom software, automation, gaming tools, websites, and digital systems.</p>
    </div>
    <div class="footer-links" aria-label="Footer navigation">
      <a href={sitePath('projects/')} data-i18n="nav.portfolio">Portfolio</a>
      <a href={sitePath('about/')} data-i18n="nav.about">About</a>
      <a href={sitePath('contact/')} data-i18n="nav.contact">Contact</a>
      {isDev && <a href={sitePath('studio/')} data-i18n="nav.studio">Project Studio</a>}
    </div>
    <div class="footer-contact">
      <a href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(socials.email)}`} target="_blank" rel="noreferrer">{socials.email}</a>
      {socials.x.map((profile) => <a href={profile.url} target="_blank" rel="noreferrer">X / {profile.label}</a>)}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} RxN Developing</span>
    <span data-i18n="footer.built">Built to evolve.</span>
  </div>
</footer>
